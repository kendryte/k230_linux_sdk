################################################################################
#
# rtl8189fs_vendor
#
################################################################################

RTL8189FS_VENDOR_VERSION = v5.15.17-27.1-3-g434ab4d57.20241119
RTL8189FS_VENDOR_wifi := rtl8189FS_linux_$(RTL8189FS_VENDOR_VERSION)
RTL8189FS_VENDOR_rtwpriv := rtwpriv_release_v5.9.1.20241014

RTL8189FS_VENDOR_SOURCE = $(RTL8189FS_VENDOR_wifi).tar.gz
RTL8189FS_VENDOR_EXTRA_DOWNLOADS = $(RTL8189FS_VENDOR_rtwpriv).tar.gz
RTL8189FS_VENDOR_SITE = https://download.kendryte.com/k230/downloads/dl/rtl8189fs_vendor
RTL8189FS_VENDOR_LICENSE = GPL-2.0

RTL8189FS_VENDOR_INSTALL_STAGING = YES
RTL8189FS_VENDOR_INSTALL_TARGET = YES

RTL8189FS_VENDOR_MODULE_SUBDIRS = $(RTL8189FS_VENDOR_wifi)

RTL8189FS_VENDOR_USER_EXTRA_CFLAGS = \
	-UCONFIG_LITTLE_ENDIAN \
	-DCONFIG_$(call qstrip,$(BR2_ENDIAN))_ENDIAN

RTL8189FS_VENDOR_MODULE_MAKE_OPTS = \
	CONFIG_RTL8189FS=m \
	KVER=$(LINUX_VERSION_PROBED) \
	KSRC=$(LINUX_DIR) \
	USER_EXTRA_CFLAGS="$(RTL8189FS_VENDOR_USER_EXTRA_CFLAGS)"

ifeq ($(BR2_ENABLE_RUNTIME_DEBUG),)
RTL8189FS_VENDOR_MODULE_MAKE_OPTS += CONFIG_RTW_DEBUG=n
endif

RTL8189FS_VENDOR_MODULE_MAKE_OPTS += CONFIG_POWER_SAVING=n  CONFIG_RTW_ADAPTIVITY_EN=enable  CONFIG_RTW_EDCCA_MODE_SEL=ADAPT



define RTL8189FS_VENDOR_LINUX_CONFIG_FIXUPS
	$(call KCONFIG_ENABLE_OPT,CONFIG_WIRELESS)
	$(call KCONFIG_ENABLE_OPT,CONFIG_CFG80211)
	$(call KCONFIG_ENABLE_OPT,CONFIG_MAC80211)
	$(call KCONFIG_ENABLE_OPT,CONFIG_MMC)
endef

define RTL8189FS_VENDOR_EXTRACT_CMDS
	tar -xf $(RTL8189FS_VENDOR_DL_DIR)/$(RTL8189FS_VENDOR_SOURCE) -C $(@D)
	tar -xf $(RTL8189FS_VENDOR_DL_DIR)/$(RTL8189FS_VENDOR_rtwpriv).tar.gz -C $(@D)
endef

define RTL8189FS_VENDOR_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) CC="$(TARGET_CC)" AR="$(TARGET_AR)" -C $(@D)/$(RTL8189FS_VENDOR_rtwpriv)
endef

define RTL8189FS_VENDOR_INSTALL_TARGET_CMDS
	cp -f $(@D)/$(RTL8189FS_VENDOR_rtwpriv)/rtwpriv $(TARGET_DIR)/usr/bin/
endef

$(eval $(kernel-module))
$(eval $(generic-package))
