+
 void RTSPClient::handleAlternativeRequestByte1(u_int8_t requestByte) {
   if (requestByte == 0xFF) {
     // Hack: The new handler of the input TCP socket encountered an error reading it.  Indicate this:
+    // Any request still awaiting a response is failed by "handleResponseBytes()"
+    // below, and that is how the caller normally hears about a dead connection.
+    // After "PLAY" there is no such request, so report the close separately --
+    // but from a delayed task, because we are being called from the socket
+    // descriptor's own destructor and the subclass will want to close things.
+    Boolean noPendingRequest = fRequestsAwaitingResponse.isEmpty();
     handleResponseBytes(-1);
+    if (noPendingRequest) {
+      envir().taskScheduler().unscheduleDelayedTask(fTCPConnectionClosedTask);
+      fTCPConnectionClosedTask
+	= envir().taskScheduler().scheduleDelayedTask(0, tcpConnectionClosedHandler, this);
+    }
