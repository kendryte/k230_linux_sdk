+    { "repeatlast", "Repeat the last OSD frame", OFFSET(fs.opt_repeatlast), AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, FLAGS },
+    { NULL }
+};
+
+FRAMESYNC_DEFINE_CLASS(nonai2d_osd, Nonai2dOSDContext, fs);
+
+static int xioctl(AVFilterContext *ctx, int fd, unsigned long request, void *arg)
+{
+    int ret;
+
+    ret = ioctl(fd, request, arg);
+
+    if (ret < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
+        av_log(ctx, AV_LOG_ERROR, "ioctl 0x%lx failed: %s\n", request, av_err2str(AVERROR(errno)));
+    return ret;
+}
+
+static enum v4l2_memory get_v4l2_memory_type(AVFilterContext *ctx, const char* mem_type_str)
+{
+    if (strcmp(mem_type_str, "mmap") == 0)
+        return V4L2_MEMORY_MMAP;
+    else if (strcmp(mem_type_str, "dmabuf") == 0)
+        return V4L2_MEMORY_DMABUF;
+    else {
+        av_log(ctx, AV_LOG_ERROR, "Invalid memory type: %s\n", mem_type_str);
+        return -1;
+    }
+}
+
+static int ffpix_to_v4l2(enum AVPixelFormat fmt, uint32_t *fourcc)
+{
+    switch (fmt) {
+    case AV_PIX_FMT_NV12:
+        *fourcc = V4L2_PIX_FMT_NV12;
+        return 0;
+    case AV_PIX_FMT_NV21:
+        *fourcc = V4L2_PIX_FMT_NV21;
+        return 0;
+    case AV_PIX_FMT_YUV420P:
+        *fourcc = V4L2_PIX_FMT_YUV420;
+        return 0;
+    case AV_PIX_FMT_BGRA:
+        *fourcc = V4L2_PIX_FMT_BGRA32;
+        return 0;
+    case AV_PIX_FMT_ARGB:
+        *fourcc = V4L2_PIX_FMT_ARGB32;
+        return 0;
+    case AV_PIX_FMT_RGB0:
+        *fourcc = V4L2_PIX_FMT_XRGB32;
+        return 0;
+    case AV_PIX_FMT_RGB24:
+        *fourcc = V4L2_PIX_FMT_RGB24;
+        return 0;
+    case AV_PIX_FMT_BGR24:
+        *fourcc = V4L2_PIX_FMT_BGR24;
+        return 0;
+    case AV_PIX_FMT_RGB565LE:
+        *fourcc = V4L2_PIX_FMT_RGB565;
+        return 0;
+    default:
+        return AVERROR(EINVAL);
+    }
+}
+
+static int setup_mmap_buffer(AVFilterContext *ctx, int fd, enum v4l2_buf_type type,
+                             uint32_t plane_num,
+                             void *map_addr[VIDEO_MAX_PLANES],
+                             size_t map_len[VIDEO_MAX_PLANES])
+{
+    struct v4l2_requestbuffers req;
+    struct v4l2_buffer *buf;
+    struct v4l2_plane *planes;
+    Nonai2dOSDContext *s = ctx->priv;
+    int i;
+    enum v4l2_memory memory_type = get_v4l2_memory_type(ctx, s->in_mem_type);
+
+    req.count  = 1;
+    req.type   = type;
+    req.memory = memory_type;
+
+    if (xioctl(ctx, fd, VIDIOC_REQBUFS, &req) < 0)
+        return AVERROR(errno);
+
+    if (req.count < 1)
+        return AVERROR(ENOMEM);
+
+    if(type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE) {
+        buf = &s->main_buf;
+        planes = s->main_planes;
+    }
+    else {
+        buf = &s->osd_bufs[0];
+        planes = s->osd_planes[0];
+    }
+
+    memset(buf, 0, sizeof(*buf));
+    memset(planes, 0, sizeof(*planes));
+
+    buf->type   = type;
+    buf->memory = memory_type;
+    buf->index  = 0;
+    buf->length = plane_num;
+    buf->m.planes = planes;
+
+    if (xioctl(ctx, fd, VIDIOC_QUERYBUF, buf) < 0)
+        return AVERROR(errno);
+
+    /* In in_mem_type mode, skip mmap - buffers are already allocated */
+    if (memory_type == V4L2_MEMORY_MMAP) {
+        for (i = 0; i < plane_num; i++) {
+
+            map_len[i] = planes[i].length;
+
+            map_addr[i] = mmap(NULL,
+                               planes[i].length,
+                               PROT_READ | PROT_WRITE,
+                               MAP_SHARED,
+                               fd,
+                               planes[i].m.mem_offset);
+
+            if (map_addr[i] == MAP_FAILED) {
+                map_addr[i] = NULL;
+                map_len[i] = 0;
+                return AVERROR(errno);
+            }
+        }
+    }
+
+    return 0;
+}
+
+static void release_mmap_buffer(AVFilterContext *ctx, int fd,
+                                enum v4l2_buf_type type,
+                                uint32_t plane_num,
+                                void *map_addr[VIDEO_MAX_PLANES],
+                                size_t map_len[VIDEO_MAX_PLANES])
+{
+    struct v4l2_requestbuffers req;
+    Nonai2dOSDContext *s = ctx->priv;
+    int i;
+    enum v4l2_memory memory_type = get_v4l2_memory_type(ctx, s->in_mem_type);
+
+    for (i = 0; i < plane_num; i++) {
+        if (map_addr[i] && map_len[i])
+            munmap(map_addr[i], map_len[i]);
+
+        map_addr[i] = NULL;
+        map_len[i] = 0;
+    }
+
+    memset(&req, 0, sizeof(req));
+    req.type = type;
+    req.memory = memory_type;
+    req.count = 0;
+
+    if (fd >= 0)
+        xioctl(ctx, fd, VIDIOC_REQBUFS, &req);
+}
+static int nonai2d_fill_plane_fmt(struct v4l2_pix_format_mplane *pix_mp, uint32_t fourcc,
+                  uint32_t width, uint32_t height)
+{
+    memset(pix_mp, 0, sizeof(*pix_mp));
+    pix_mp->pixelformat = fourcc;
+    pix_mp->width = width;
+    pix_mp->height = height;
+    pix_mp->field = V4L2_FIELD_NONE;
+
+    switch (fourcc) {
+    case V4L2_PIX_FMT_NV12:
+    case V4L2_PIX_FMT_NV21:
+        pix_mp->num_planes = 2;
+        pix_mp->plane_fmt[0].bytesperline = width;
+        pix_mp->plane_fmt[0].sizeimage = width * height;
+        pix_mp->plane_fmt[1].bytesperline = width;
+        pix_mp->plane_fmt[1].sizeimage = (width * height) / 2;
+        return 0;
+
+    case V4L2_PIX_FMT_YUV420:
+    case V4L2_PIX_FMT_YVU420:
+        pix_mp->num_planes = 3;
+        pix_mp->plane_fmt[0].bytesperline = width;
+        pix_mp->plane_fmt[0].sizeimage = width * height;
+        pix_mp->plane_fmt[1].bytesperline = width / 2;
+        pix_mp->plane_fmt[1].sizeimage = (width * height) / 4;
+        pix_mp->plane_fmt[2].bytesperline = width / 2;
+        pix_mp->plane_fmt[2].sizeimage = (width * height) / 4;
+        return 0;
+
+    case V4L2_PIX_FMT_YUV444M:
+        pix_mp->num_planes = 1;
+        pix_mp->plane_fmt[0].bytesperline = width * 3;
+        pix_mp->plane_fmt[0].sizeimage = width * height * 3;
+        return 0;
+
+    case V4L2_PIX_FMT_ARGB32:
+    case V4L2_PIX_FMT_XRGB32:
+    case V4L2_PIX_FMT_ABGR32:
+    case V4L2_PIX_FMT_XBGR32:
+        pix_mp->num_planes = 1;
+        pix_mp->plane_fmt[0].bytesperline = width * 4;
+        pix_mp->plane_fmt[0].sizeimage = width * height * 4;
+        return 0;
+
+    case V4L2_PIX_FMT_RGB565:
+    case V4L2_PIX_FMT_ARGB444:
+    case V4L2_PIX_FMT_ARGB555:
+        pix_mp->num_planes = 1;
+        pix_mp->plane_fmt[0].bytesperline = width * 2;
+        pix_mp->plane_fmt[0].sizeimage = width * height * 2;
+        return 0;
+
+    case V4L2_PIX_FMT_RGB24:
+    case V4L2_PIX_FMT_BGR24:
+    case V4L2_PIX_FMT_YUV444:
+        pix_mp->num_planes = 1;
+        pix_mp->plane_fmt[0].bytesperline = width * 3;
+        pix_mp->plane_fmt[0].sizeimage = width * height * 3;
+        return 0;
+
+    default:
+        return -1;
+    }
+}
+
+static int set_format(AVFilterContext *ctx, int fd, enum v4l2_buf_type type,
+                      int w, int h, uint32_t fourcc, size_t *image_size,
+                      int *plane_num, uint32_t plane_size[VIDEO_MAX_PLANES])
+{
+    struct v4l2_format fmt;
+
+    memset(&fmt, 0, sizeof(fmt));
+    fmt.type = type;
+    if (nonai2d_fill_plane_fmt(&fmt.fmt.pix_mp, fourcc, w, h) < 0) {
+        av_log(ctx, AV_LOG_ERROR, "unsupported video format: 0x%x\n", fourcc);
+        return -1;
+    }
+
+    if (xioctl(ctx, fd, VIDIOC_S_FMT, &fmt) < 0) {
+        av_log(ctx, AV_LOG_ERROR, "set capture format failed: %d(%s)\n", errno, strerror(errno));
+        return -1;
+    }
+
+    av_log(ctx, AV_LOG_VERBOSE,
+           "S_FMT type=%u w=%u h=%u fourcc=0x%x nplanes=%u sizeimage0=%u bytesperline0=%u\n",
+           type,
+           fmt.fmt.pix_mp.width,
+           fmt.fmt.pix_mp.height,
+           fmt.fmt.pix_mp.pixelformat,
+           fmt.fmt.pix_mp.num_planes,
+           fmt.fmt.pix_mp.plane_fmt[0].sizeimage,
+           fmt.fmt.pix_mp.plane_fmt[0].bytesperline);
+
+    *image_size = fmt.fmt.pix_mp.plane_fmt[0].sizeimage;
+    if (plane_num)
+        *plane_num = fmt.fmt.pix_mp.num_planes;
+    if (plane_size) {
+        uint32_t i;
+        for (i = 0; i < fmt.fmt.pix_mp.num_planes && i < VIDEO_MAX_PLANES; i++)
+            plane_size[i] = fmt.fmt.pix_mp.plane_fmt[i].sizeimage;
+    }
+
+    return 0;
+}
+
+static int set_nonai2d_mode(AVFilterContext *ctx, Nonai2dOSDContext *s)
+{
+    struct v4l2_control mode = { 0 };
+
+    mode.id = V4L2_CID_USER_NONAI2D_MODE;
+    mode.value = NONAI2D_MODE_OSD;
+    if (xioctl(ctx, s->fd, VIDIOC_S_CTRL, &mode) < 0)
+        return AVERROR(errno);
+
+    return 0;
+}
+
+static int set_nonai2d_osd_attr(AVFilterContext *ctx, Nonai2dOSDContext *s)
+{
+    struct v4l2_ext_control ext = { 0 };
+    struct v4l2_ext_controls exts = { 0 };
+    nonai2d_osd_attr attr[NONAI2D_OSD_MAX_REGION];
+    uint32_t v4l2_pixfmt;
+    int ret, i;
+
+    for (i = 0; i < NONAI2D_OSD_MAX_REGION; i++) {
+
+        if (s->valid[i])
+            s->osd_valid |= (1U << i);
+        else
+            s->osd_valid &= ~(1U << i);
+
+        if (!s->valid[i]) {
+            memset(&attr[i], 0, sizeof(attr[i]));
+            continue;
+        }
+        attr[i].index = s->index[i];
+        attr[i].width = s->width[i];
+        attr[i].height = s->height[i];
+        attr[i].startx = s->x[i];
+        attr[i].starty = s->y[i];
+        attr[i].bg_alpha = s->bg_alpha[i];
+        attr[i].osd_alpha = s->osd_alpha[i];
+        attr[i].video_alpha = s->video_alpha[i];
+        attr[i].add_order = s->add_order[i];
+        attr[i].bg_color = s->bg_color[i];
+        attr[i].valid = s->valid[i];
+
+        ret = ffpix_to_v4l2(s->pixfmt[i], &v4l2_pixfmt);
+        if (ret < 0) {
+            av_log(ctx, AV_LOG_ERROR, "unsupported OSD pixel format for region %d: %s\n",
+                   i, av_get_pix_fmt_name(s->pixfmt[i]));
+            return ret;
+        }
+        attr[i].pixfmt = v4l2_pixfmt;
+
+        attr[i].data = (uint8_t *)s->data[i];
+        if (!attr[i].data) {
+            av_log(ctx, AV_LOG_ERROR, "osd data is null for enabled region %d\n", i);
+            return AVERROR(EINVAL);
+        }
+    }
+
+    ext.id = V4L2_CID_USER_NONAI2D_OSD_ATTR;
+    ext.ptr = &attr;
+    ext.size = sizeof(attr);
+    exts.which = V4L2_CTRL_WHICH_CUR_VAL;
+    exts.count = 1;
+    exts.controls = &ext;
+
+    if (xioctl(ctx, s->fd, VIDIOC_S_EXT_CTRLS, &exts) < 0)
+        return AVERROR(errno);
+
+    return 0;
+}
+
+static void nonai2d_close(AVFilterContext *ctx)
+{
+    Nonai2dOSDContext *s = ctx->priv;
+    enum v4l2_buf_type dst_type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+
+    if (s->fd >= 0 && s->streaming) {
+        xioctl(ctx, s->fd, VIDIOC_STREAMOFF, &dst_type);
+    }
+    s->streaming = 0;
+
+    if (s->fd >= 0) {
+        release_mmap_buffer(ctx, s->fd, dst_type,
+                    s->main_plane_num,
+                    s->main_map,
+                    s->main_len);
+        close(s->fd);
+    }
+
+    s->fd = -1;
+    s->osd_buf_count = 0;
+    s->configured = 0;
+    s->osd_attr_needs_update = 1;
+}
+
+static int nonai2d_configure_device(AVFilterContext *ctx, AVFrame *main)
+{
+    Nonai2dOSDContext *s = ctx->priv;
+    size_t dst_image_size = 0;
+    int ret;
+
+    if (!main) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        return AVERROR(EINVAL);
+    }
+
+    if (s->configured) {
+        return 0;
+    }
+
+    ret = ffpix_to_v4l2(main->format, &s->main_fourcc);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "unsupported main pixel format: %s\n",
+               av_get_pix_fmt_name(main->format));
+        return ret;
+    }
+
+    s->fd = open(s->device, O_RDWR | O_NONBLOCK, 0);
+    if (s->fd < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        return AVERROR(errno);
+    }
+
+    s->main_fmt = main->format;
+    s->main_w = main->width;
+    s->main_h = main->height;
+
+    ret = set_nonai2d_mode(ctx, s);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        goto fail;
+    }
+
+    ret = set_format(ctx, s->fd, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+                     s->main_w, s->main_h, s->main_fourcc, &dst_image_size,
+                     &s->main_plane_num, s->main_plane_size);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        goto fail;
+    }
+
+    ret = set_nonai2d_osd_attr(ctx, s);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        goto fail;
+    }
+
+    ret = setup_mmap_buffer(ctx, s->fd,
+                        V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+                        s->main_plane_num,
+                        s->main_map,
+                        s->main_len);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        goto fail;
+    }
+
+    s->configured = 1;
+    return 0;
+
+fail:
+    nonai2d_close(ctx);
+    return ret;
+}
+
+static int run_nonai2d_osd(AVFilterContext *ctx, AVFrame *main)
+{
+    Nonai2dOSDContext *s = ctx->priv;
+    uint8_t *dst_data[4] = { 0 };
+    int dst_linesize[4] = { 0 };
+    enum v4l2_buf_type dst_type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    int poll_ret;
+    int i;
+
+    for (i = 0; i < s->main_plane_num; i++)
+        dst_data[i] = s->main_map[i];
+
+    av_image_fill_linesizes(dst_linesize, s->main_fmt, s->main_w);
+
+    /* Setup buffer for QBUF */
+    s->main_buf.length = s->main_plane_num;
+    s->main_buf.m.planes = s->main_planes;
+
+    if (get_v4l2_memory_type(ctx, s->in_mem_type) == V4L2_MEMORY_DMABUF) {
+        /* In dmabuf mode, get fd from frame->opaque and set it to planes */
+        for (i = 0; i < s->main_plane_num; i++) {
+            s->main_planes[i].m.fd = ((int *)main->opaque)[i];
+            s->main_planes[i].data_offset = 0;
+            s->main_planes[i].bytesused = s->main_plane_size[i];
+            s->main_planes[i].length = s->main_plane_size[i];
+        }
+    } else {
+        /* In mmap mode, copy data to mmap buffer */
+        av_image_copy(dst_data, dst_linesize,
+                  (const uint8_t **)main->data, main->linesize,
+                  s->main_fmt, s->main_w, s->main_h);
+
+        for (i = 0; i < s->main_plane_num; i++) {
+            s->main_planes[i].bytesused = s->main_plane_size[i];
+        }
+    }
+
+    if(s->osd_valid) {
+
+        if (xioctl(ctx, s->fd, VIDIOC_QBUF, &s->main_buf) < 0) {
+            av_log(ctx, AV_LOG_ERROR, "qbuf capture failed: %d(%s)\n", errno, strerror(errno));
+            return AVERROR(errno);
+        }
+
+        if (!s->streaming) {
+            if (xioctl(ctx, s->fd, VIDIOC_STREAMON, &dst_type) < 0) {
+                av_log(ctx, AV_LOG_ERROR, "streamon capture failed: %d(%s)\n", errno, strerror(errno));
+                return AVERROR(errno);
+            }
+            s->streaming = 1;
+        }
+
+        {
+            struct pollfd pfd;
+            memset(&pfd, 0, sizeof(pfd));
+            pfd.fd = s->fd;
+            pfd.events = POLLIN;
+            poll_ret = poll(&pfd, 1, 2000);
+            if (poll_ret <= 0) {
+                av_log(ctx, AV_LOG_ERROR, "poll timeout or error\n");
+                return AVERROR(poll_ret == 0 ? ETIMEDOUT : errno);
+            }
+        }
+
+        if (xioctl(ctx, s->fd, VIDIOC_DQBUF, &s->main_buf) < 0) {
+            av_log(ctx, AV_LOG_ERROR, "dqbuf capture failed: %d(%s)\n", errno, strerror(errno));
+            return AVERROR(errno);
+        }
+    }
+
+    if (get_v4l2_memory_type(ctx, s->out_mem_type) == V4L2_MEMORY_MMAP) {
+        for (i = 0; i < AV_NUM_DATA_POINTERS; i++) {
+            if (i < s->main_plane_num) {
+                main->data[i] = dst_data[i];
+                main->linesize[i] = dst_linesize[i];
+            } else {
+                main->data[i] = NULL;
+                main->linesize[i] = 0;
+            }
+        }
+    } else {
+        if (get_v4l2_memory_type(ctx, s->out_mem_type) == V4L2_MEMORY_DMABUF &&
+            get_v4l2_memory_type(ctx, s->in_mem_type) == V4L2_MEMORY_MMAP) {
+
+            AVBufferRef *fd_ref;
+            struct v4l2_exportbuffer expbuf = {
+                .type  = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+                .index = s->main_buf.index,
+                .flags = FD_CLOEXEC | O_RDWR
+            };
+
+            fd_ref = av_buffer_alloc(sizeof(int) * s->main_plane_num);
+            if (!fd_ref) {
+                av_log(ctx, AV_LOG_ERROR, "Failed to allocate av_buffer\n");
+                return AVERROR(ENOMEM);
+            }
+
+            for (i = 0; i < s->main_plane_num; i++) {
+                expbuf.plane = i;
+                if (xioctl(ctx, s->fd, VIDIOC_EXPBUF, &expbuf) < 0) {
+                    av_buffer_unref(&fd_ref);
+                    av_log(ctx, AV_LOG_ERROR, "expbuf osd failed: %d(%s)\n", errno, strerror(errno));
+                    return AVERROR(errno);
+                }
+
+                ((int *)fd_ref->data)[i] = expbuf.fd;
+            }
+
+            if (main->opaque_ref)
+                av_buffer_unref(&main->opaque_ref);
+            main->opaque_ref = fd_ref;
+        }
+    }
+
+    return 0;
+}
+
+static int process_frame(FFFrameSync *fs)
+{
+    AVFilterContext *ctx = fs->parent;
+    Nonai2dOSDContext *s = ctx->priv;
+    AVFrame *main = NULL;
+    int ret;
+
+    ret = ff_framesync_get_frame(fs, 0, &main, 1);
+
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        return ret;
+    }
+
+    ret = nonai2d_configure_device(ctx, main);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        return ret;
+    }
+
+    ret = run_nonai2d_osd(ctx, main);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "%s>line %d\n", __func__, __LINE__);
+        return ret;
+    }
+
+    s->frame_cnt++;
+    return ff_filter_frame(ctx->outputs[0], main);
+}
+
+static int query_formats(AVFilterContext *ctx)
+{
+    static const enum AVPixelFormat main_formats[] = {
+        AV_PIX_FMT_NV12,
+        AV_PIX_FMT_NV21,
+        AV_PIX_FMT_YUV420P,
+        AV_PIX_FMT_ARGB,
+        AV_PIX_FMT_BGRA,
+        AV_PIX_FMT_RGB24,
+        AV_PIX_FMT_BGR24,
+        AV_PIX_FMT_RGB0,
+        AV_PIX_FMT_RGB565LE,
+        AV_PIX_FMT_NONE,
+    };
+    AVFilterFormats *formats;
+    int ret;
+
+    formats = ff_make_format_list(main_formats);
+    if ((ret = ff_formats_ref(formats, &ctx->inputs[0]->outcfg.formats)) < 0 ||
+        (ret = ff_formats_ref(formats, &ctx->outputs[0]->incfg.formats)) < 0)
+        return ret;
+
+    return 0;
+}
+
+static int update_region_param(AVFilterContext *ctx, Nonai2dOSDContext *s,
+                               int *region_idx, const char *param_name,
+                               const char *param_value)
+{
+    int idx = *region_idx;
+    char *endptr = NULL;
+    long v;
+
+    if (!param_name || !param_value) {
+        av_log(ctx, AV_LOG_ERROR, "config_region invalid param pair: name=%p value=%p\n",
+               param_name, param_value);
+        return AVERROR(EINVAL);
+    }
+
+    if (!strcmp(param_name, "index")) {
+        v = strtol(param_value, &endptr, 10);
+        if (endptr == param_value || *endptr != '\0' ||
+            v < 0 || v >= NONAI2D_OSD_MAX_REGION) {
+            av_log(ctx, AV_LOG_ERROR, "config_region invalid index value: %s\n", param_value);
+            return AVERROR(EINVAL);
+        }
+        *region_idx = (int)v;
+        return 0;
+    }
+
+    if (idx < 0 || idx >= NONAI2D_OSD_MAX_REGION) {
+        av_log(ctx, AV_LOG_ERROR, "config_region has invalid active index=%d\n", idx);
+        return AVERROR(EINVAL);
+    }
+
+    if (!strcmp(param_name, "data")) {
+        uintptr_t p = (uintptr_t)strtoull(param_value, &endptr, 0);
+        if (endptr == param_value || *endptr != '\0') {
+            av_log(ctx, AV_LOG_ERROR, "config_region invalid data pointer: %s\n", param_value);
+            return AVERROR(EINVAL);
+        }
+        s->data[idx] = (uint8_t *)p;
+        return 0;
+    }
+
+    v = strtol(param_value, &endptr, 10);
+    if (endptr == param_value || *endptr != '\0') {
+        av_log(ctx, AV_LOG_ERROR, "config_region invalid integer for %s: %s\n",
+               param_name, param_value);
+        return AVERROR(EINVAL);
+    }
+
+    if (!strcmp(param_name, "x")) s->x[idx] = (int)v;
+    else if (!strcmp(param_name, "y")) s->y[idx] = (int)v;
+    else if (!strcmp(param_name, "width")) s->width[idx] = (int)v;
+    else if (!strcmp(param_name, "height")) s->height[idx] = (int)v;
+    else if (!strcmp(param_name, "bg_alpha")) s->bg_alpha[idx] = (int)v;
+    else if (!strcmp(param_name, "osd_alpha")) s->osd_alpha[idx] = (int)v;
+    else if (!strcmp(param_name, "video_alpha")) s->video_alpha[idx] = (int)v;
+    else if (!strcmp(param_name, "add_order")) s->add_order[idx] = (int)v;
+    else if (!strcmp(param_name, "bg_color")) s->bg_color[idx] = (uint32_t)v;
+    else if (!strcmp(param_name, "pixfmt")) s->pixfmt[idx] = (enum AVPixelFormat)v;
+    else if (!strcmp(param_name, "valid")) s->valid[idx] = (int)v;
+    else {
+        av_log(ctx, AV_LOG_ERROR, "unsupported config_region param: %s\n", param_name);
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
+
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    Nonai2dOSDContext *s = ctx->priv;
+    int ret;
+
+    if (cmd && !strcmp(cmd, "config_region")) {
+        char *saveptr = NULL;
+        char *token;
+        int region_idx = -1;
+        char *args_copy;
+
+        if (!args) {
+            av_log(ctx, AV_LOG_ERROR, "config_region missing args\n");
+            return AVERROR(EINVAL);
+        }
+
+        args_copy = av_strdup(args);
+
+        if (!args_copy) {
+            av_log(ctx, AV_LOG_ERROR, "config_region alloc args_copy failed\n");
+            return AVERROR(ENOMEM);
+        }
+
+        token = strtok_r(args_copy, ":", &saveptr);
+        if (!token) {
+            av_log(ctx, AV_LOG_ERROR, "config_region args parse failed: %s\n", args);
+            av_free(args_copy);
+            return AVERROR(EINVAL);
+        }
+
+        ret = update_region_param(ctx, s, &region_idx, "index", token);
+        if (ret < 0) {
+            av_log(ctx, AV_LOG_ERROR, "config_region parse index failed: ret=%d\n", ret);
+            av_free(args_copy);
+            return ret;
+        }
+
+        while ((token = strtok_r(NULL, ":", &saveptr))) {
+            const char *param_name = token;
+            const char *param_value = strtok_r(NULL, ":", &saveptr);
+            if (!param_value) {
+                av_log(ctx, AV_LOG_ERROR, "config_region missing value for key=%s\n", param_name);
+                av_free(args_copy);
+                return AVERROR(EINVAL);
+            }
+
+            ret = update_region_param(ctx, s, &region_idx, param_name, param_value);
+            if (ret < 0) {
+                av_log(ctx, AV_LOG_ERROR,
+                       "config_region update failed: region=%d key=%s value=%s ret=%d\n",
+                       region_idx, param_name, param_value, ret);
+                av_free(args_copy);
+                return ret;
+            }
+        }
+
+        av_free(args_copy);
+        if (s->configured && s->fd >= 0) {
+            ret = set_nonai2d_osd_attr(ctx, s);
+            if (ret < 0) {
+                av_log(ctx, AV_LOG_ERROR, "config_region apply to driver failed: ret=%d\n", ret);
+                return ret;
+            }
+            s->osd_attr_needs_update = 0;
+        } else {
+            av_log(ctx, AV_LOG_VERBOSE,
+                   "config_region deferred: device not configured yet (fd=%d configured=%d)\n",
+                   s->fd, s->configured);
+            s->osd_attr_needs_update = 1;
+        }
+        return 0;
+    }
+
+    return 0;
+}
+
+static int config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    Nonai2dOSDContext *s = ctx->priv;
+    AVFilterLink *main_link = ctx->inputs[MAIN_INPUT];
+    FFFrameSyncIn *in;
+    int ret;
+
+    outlink->w = main_link->w;
+    outlink->h = main_link->h;
+    outlink->time_base = main_link->time_base;
+    outlink->sample_aspect_ratio = main_link->sample_aspect_ratio;
+    outlink->frame_rate = main_link->frame_rate;
+
+    ret = ff_framesync_init(&s->fs, ctx, 1);
+    if (ret < 0)
+        return ret;
+
+    in = s->fs.in;
+    in[MAIN_INPUT].time_base = main_link->time_base;
+    in[MAIN_INPUT].sync   = 1;
+    in[MAIN_INPUT].before = EXT_STOP;
+    in[MAIN_INPUT].after  = EXT_INFINITY;
+    s->fs.opaque = s;
+    s->fs.on_event = process_frame;
+    s->osd_attr_needs_update = 1;
+
+    return ff_framesync_configure(&s->fs);
+}
+
+static av_cold int init(AVFilterContext *ctx)
+{
+    Nonai2dOSDContext *s = ctx->priv;
+    s->fd = -1;
+    s->osd_buf_count = 0;
+    s->osd_attr_needs_update = 1;
+    s->frame_cnt = 0;
+    if(get_v4l2_memory_type(ctx, s->in_mem_type) != V4L2_MEMORY_DMABUF &&
+        get_v4l2_memory_type(ctx, s->in_mem_type) != V4L2_MEMORY_MMAP) {
+        av_log(ctx, AV_LOG_ERROR, "in_mem_type %s is unsupported\n", s->in_mem_type);
+        return AVERROR(EINVAL);
+    }
+
+    if(get_v4l2_memory_type(ctx, s->out_mem_type) != V4L2_MEMORY_DMABUF &&
+        get_v4l2_memory_type(ctx, s->out_mem_type) != V4L2_MEMORY_MMAP) {
+        av_log(ctx, AV_LOG_ERROR, "out_mem_type %s is unsupported\n", s->out_mem_type);
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
+
+static av_cold void uninit(AVFilterContext *ctx)
+{
+    Nonai2dOSDContext *s = ctx->priv;
+
+    ff_framesync_uninit(&s->fs);
+    if (s->fd >= 0)
+        nonai2d_close(ctx);
+}
+
+static int activate(AVFilterContext *ctx)
+{
+    Nonai2dOSDContext *s = ctx->priv;
+    return ff_framesync_activate(&s->fs);
+}
+
+static const AVFilterPad nonai2d_osd_inputs[] = {
+    {
+        .name = "default",
+        .type = AVMEDIA_TYPE_VIDEO,
+    },
+    { NULL }
+};
+
+static const AVFilterPad nonai2d_osd_outputs[] = {
+    {
+        .name = "default",
+        .type = AVMEDIA_TYPE_VIDEO,
+        .config_props = config_output,
+    },
+    { NULL }
+};
+
+AVFilter ff_vf_nonai2d_osd = {
+    .name          = "nonai2d_osd",
+    .description   = NULL_IF_CONFIG_SMALL("Use nonai2d v4l2 m2m hardware to overlay OSD."),
+    .preinit       = nonai2d_osd_framesync_preinit,
+    .init          = init,
+    .uninit        = uninit,
+    .priv_size     = sizeof(Nonai2dOSDContext),
+    .priv_class    = &nonai2d_osd_class,
+    .query_formats = query_formats,
+    .activate      = activate,
+    .inputs        = nonai2d_osd_inputs,
+    .outputs       = nonai2d_osd_outputs,
+    .process_command = process_command,
+    .flags         = AVFILTER_FLAG_SUPPORT_TIMELINE_INTERNAL,
+};
