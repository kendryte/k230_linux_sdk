# Generate by menuconfig


#
# build
#

#
# Configure the compilation environment
#
WSCFG_USING_GCC=y
# WSCFG_USING_LLVM_CLANG is not set
WSCFG_CROSS_COMPILE="arm-himix100-linux-"
WSCFG_KERNEL_DIR="$(if $(WLBUS_USB_KERNEL_DIR),$(WLBUS_USB_KERNEL_DIR),/home/AIoT/share/Hi3518_Host/Hi3518_SDK_0110_USB/osdrv/opensource/kernel/linux-4.9.y)"
WSCFG_EXTRA_CFLAGS=""
WSCFG_EXTRA_PARAMS=""
WSCFG_ARCH_ARM=y
# WSCFG_ARCH_CUSTOM is not set
WSCFG_ARCH_NAME="arm"
# BOARD_FPGA is not set
BOARD_ASIC=y
BOARD_ASIC_WIFI=y
# WSCFG_BUS_SDIO is not set
WSCFG_BUS_USB=y
# WSCFG_BUS_UART is not set
WSCFG_LINUX=y
# WSCFG_LITEOS is not set
# WSCFG_ANDROID is not set
_PRE_OS_VERSION_LINUX=0
_PRE_OS_VERSION_WIN32=1
_PRE_OS_VERSION_WINDOWS=2
_PRE_OS_VERSION_RAW=3
_PRE_OS_VERSION_HiRTOS=4
_PRE_OS_VERSION_WIN32_RAW=5
_PRE_OS_VERSION_LITEOS=6
_PRE_OS_VERSION_ANDROID=7
_PRE_OS_VERSION=0
# end of build

#
# MFG
#
# WSCFG_MFG_TEST is not set
# end of MFG

#
# WiFi
#

#
# Configure the WiFi ini file
#
WSCFG_INI_DBAC_STA_GC_RATIO=50
WSCFG_INI_DBAC_STA_GO_RATIO=30
# CONFIG_INI_PROTOCOL_11AX is not set
CONFIG_INI_HOST_GPIO=40
CONFIG_INI_HOST_GPIO_POWER_ON_LEVEL=1
CONFIG_INI_DEVICE_AWAKE_GPIO_IDX=10
CONFIG_INI_DEVICE_AWAKE_GPIO_LEVEL=1
CONFIG_INI_WAKE_UP_GPIO_IDX=70
CONFIG_INI_WAKE_UP_GPIO_LEVEL=1
CONFIG_INI_PLAT_REBOOT_TYPE_GPIO=0
CONFIG_INI_BT_COEX_MODE=1
CONFIG_INI_BSLE_USE_FLASH=0
# end of Configure the WiFi ini file

#
# WiFi feature configuration
#
WIFI_LITE_EXTREME=y
WSCFG_WLAN_INIT_VAP_COUNT=3
# WIFI_DEBUG is not set
# WLAN_WFA_TEST is not set
# WIFI_CSA is not set
# WIFI_WPS is not set
# _PRE_WLAN_FEATURE_WPA3 is not set
WSCFG_WIFI_ENHANCE=y
# WIFI_BSRP_NFRP is not set
# WIFI_SLP is not set
# WIFI_APF is not set
# WIFI_BASE_ROAM is not set
# WIFI_AUTO_ADJUST_FREQ is not set
# WIFI_SINGLE_PROXYSTA is not set
# WIFI_CSI is not set
# WIFI_M2U is not set
# WIFI_BLACKLIST is not set
# WIFI_WAPI is not set
# WIFI_SDP is not set
# WIFI_LATENCY_STAT is not set
# WIFI_PROMISC is not set
WIFI_TX_AMSDU=y
# WIFI_UAPSD is not set
# WIFI_ANT_SEL is not set
# WIFI_PSD is not set
# WIFI_TWT is not set
# WIFI_DNB is not set
# WIFI_SR_STA is not set
WIFI_ALG_CCA=y
WIFI_ALG_TEMP_PROTECT=y
WIFI_ALG_TXBF=y
WIFI_ALG_EDCA=y
# WIFI_ALG_ANTI_INTF is not set
# _PRE_WLAN_FEATURE_TX_CLASSIFY_LAN_TO_WLAN is not set
# WIFI_WOW is not set
# WIFI_ALWAYS_TX is not set
# _PRE_WLAN_DFT_STAT is not set
# _PRE_WLAN_FEATURE_SNIFFER is not set
# WIFI_BASE_DFR is not set
# WIFI_DAQ is not set
# _PRE_WLAN_SUPPORT_CCPRIV_CMD is not set
# WIFI_BTCOEX is not set
WIFI_ONLINE_CALI=y
# _PRE_WLAN_WIRELESS_EXT is not set
# WIFI_TCP_ACK_FILTER is not set
# CONTROLLER_CUSTOMIZATION is not set
# end of WiFi

#
# Platform
#
# _PRE_PLAT_SHA256SUM_CHECK is not set
WSCFG_ONEIMAGE=y
# WSCFG_PLAT_VARIABLE_FEATRUE is not set
_PRE_PLAT_HCC_USB=y
# CONFIG_HCC_USB_ZLP_FIXME is not set
BT_EM_BUFFER_CALI_SUPPORT=y
# _PRE_PLAT_SLP_UART_FORWARD is not set
# CONFIG_DFX_SUPPORT_SYSFS is not set

#
# Configure the loading path of files such as firmware
#
CONFIG_FIRMWARE_BIN_PATH="/etc/ws73/ws73.bin"
CONFIG_FIRMWARE_WIFICALI_PATH="/etc/ws73/wifi_cali.bin"
CONFIG_FIRMWARE_BSLECALI_PATH="/etc/ws73/btc_cali.bin"
CONFIG_FIRMWARE_WOW_PATH="/etc/ws73/wow.bin"
CONFIG_INI_FILE_PATH="/etc/ws73_cfg.ini"
# end of Configure the loading path of files such as firmware

# CONFIG_STR_RESUME_ASYNC is not set
# CONFIG_STR_SUSPEND_WAIT_USB_DISCONNECT is not set
# CONFIG_ANDROID_FEATURE is not set
# CONFIG_SUPPORT_RESET_DEVICE_IN_INSMOD is not set
# CONFIG_SUPPORT_STATIC_FIRMWARE_MEM is not set
# CONFIG_GPIO_USING_HI_DRV is not set
# CONFIG_SUPPORT_HCC_CONN_CHECK is not set
# CONFIG_MFG_GPIO_CTRL is not set
CONFIG_INI_STR_LPM_MODE=0
# CONFIG_NO_SECUREC is not set
PLAT_LITE_EXTREME=y
CONFIG_NO_SUPPORT_INI=y
CONFIG_NO_SUPPORT_OSAL=y
# end of Platform

#
# BLE
#

#
# GLE
#
