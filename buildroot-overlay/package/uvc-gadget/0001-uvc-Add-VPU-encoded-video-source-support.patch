+extern  int vpu_source_if_have_data(struct video_source *s);
+void uvc_stream_uvc_process_vpu(void *d)
+{
+	struct uvc_stream *stream = d;
+	struct v4l2_device *sink = uvc_v4l2_device(stream->uvc);
+	struct video_buffer buf;
+	int ret;
+
+	//printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+	if(vpu_source_if_have_data(stream->src) <=0 ) //no data
+		return;
+
+	ret = v4l2_dequeue_buffer(sink, &buf);
+	if (ret < 0)
+		return;
+
+	//printf("[uvc_stream] dequeue buffer %u, bytesused=%u\n", buf.index, buf.bytesused);
+	//printf("[uvc_stream] calling queue_buffer...\n");
+	video_source_queue_buffer(stream->src, &buf);
+	//printf("[uvc_stream] queue_buffer done\n");
+	//printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+
+}
+/* For VIDEO_SOURCE_VPU_ENCODED (vpu-source)
+ * Initial queue buffers then wait for first packet before dequeuing */
+static int uvc_stream_start_vpu_encoded(struct uvc_stream *stream)
+{
+	struct v4l2_device *sink = uvc_v4l2_device(stream->uvc);
+	int ret;
+	unsigned int i;
+
+	/* Allocate the buffers on the source. */
+	ret = video_source_alloc_buffers(stream->src, 2);
+	if (ret < 0) {
+		printf("Failed to allocate source buffers: %s (%d)\n",
+		       strerror(-ret), -ret);
+		return ret;
+	}
+
+	/* Allocate buffers on the sink. */
+	ret = v4l2_alloc_buffers(sink, V4L2_MEMORY_MMAP, 2);
+	if (ret < 0) {
+		printf("Failed to allocate sink buffers: %s (%d)\n",
+		       strerror(-ret), -ret);
+		goto error_free_source;
+	}
+
+	/* mmap buffers. */
+	ret = v4l2_mmap_buffers(sink);
+	if (ret < 0) {
+		printf("Failed to query sink buffers: %s (%d)\n",
+				strerror(-ret), -ret);
+		goto error_free_sink;
+	}
+
+	/* Import the sink's buffers to the source */
+	ret = video_source_import_buffers(stream->src, &sink->buffers);
+	if (ret) {
+		printf("Failed to import sink buffers: %s (%d)\n",
+		       strerror(ret), ret);
+		goto error_free_sink;
+	}
+
+	/* Queue all sink buffers to the source.
+	 * vpu-source will fill them with encoded data when available. */
+	for (i = 0; i < sink->buffers.nbufs; ++i) {
+		struct video_buffer buf = {
+			.index = i,
+			.size = sink->buffers.buffers[i].size,
+			.mem = sink->buffers.buffers[i].mem,
+			.bytesused = 0,
+			.timestamp = {0, 0},
+		};
+
+		ret = v4l2_queue_buffer(sink, &buf);
+		if (ret < 0) {
+			printf("Failed to queue buffer %u to sink: %s (%d)\n",
+				i, strerror(-ret), -ret);
+			goto error_free_sink;
+		}
+		//printf("Queued buffer %u to sink, bytesused=%u\n", i, buf.bytesused);
+	}
+
+	/* Start the source and sink. */
+	video_source_stream_on(stream->src);
+	v4l2_stream_on(sink);
+
+	events_watch_fd(stream->events, sink->fd, EVENT_WRITE,
+			uvc_stream_uvc_process_vpu, stream);
+
+	return 0;
+
 error_free_sink:
 	v4l2_free_buffers(sink);
 error_free_source:
@@ -249,6 +363,10 @@ static int uvc_stream_start(struct uvc_stream *stream)
 		video_source_set_buffer_handler(stream->src, uvc_stream_source_process,
 						stream);
 		return uvc_stream_start_encoded(stream);
+	case VIDEO_SOURCE_VPU_ENCODED:
+		video_source_set_buffer_handler(stream->src, uvc_stream_source_process,
+						stream);
+		return uvc_stream_start_vpu_encoded(stream);
 	default:
 		fprintf(stderr, "invalid video source type\n");
 		break;
