+/* Get current time in milliseconds */
+static uint64_t get_time_ms(void)
+{
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    return (uint64_t)tv.tv_sec * 1000 + tv.tv_usec / 1000;
+}
+
+struct vpu_source {
+	struct video_source src;
+
+	/* Camera input */
+	AVFormatContext *fmt_ctx;
+	AVInputFormat *input_fmt;
+
+	/* Encoder */
+	AVCodecContext *codec_ctx;
+	AVFrame *frame;
+	AVPacket *pkt;
+
+	/* Stop flag */
+	int stop_flag;
+
+	/* Thread ID */
+	pthread_t vpu_tid;
+
+	/* Encoded packet queue (circular buffer) */
+	AVPacket **packet_queue;
+	atomic_int packet_queue_size;  /* Use atomic for lock-free reads */
+	int packet_queue_capacity;
+	atomic_int packet_queue_head;  /* Index to dequeue from */
+	atomic_int packet_queue_tail;  /* Index to enqueue to */
+	pthread_mutex_t packet_mutex;
+	pthread_cond_t packet_cond;
+
+	/* Buffer pool for encoded output */
+	struct video_buffer_set *output_buffers;
+
+	/* Encoder type */
+
+	char *camera_device;
+
+	/* Frame rate */
+	int frame_rate;
+
+	/* Sink device info (for direct buffer queueing) */
+	int sink_fd;
+	/* Width and height set via set_format */
+	int set_width;
+	int set_height;
+	/* Initialize flag */
+	int initialized;
+};
+
+#define to_vpu_source(s) container_of(s, struct vpu_source, src)
+
+static int init_camera(struct vpu_source *src, const char *camera_device, int width, int height)
+{
+	/* Register all device formats (needed for v4l2 input) */
+	avdevice_register_all();
+
+	src->input_fmt = av_find_input_format("v4l2");
+	if (!src->input_fmt) {
+		fprintf(stderr, "Cannot find v4l2 input format\n");
+		return -1;
+	}
+
+	AVDictionary *options = NULL;
+	char video_size[32];
+	snprintf(video_size, sizeof(video_size), "%dx%d", width, height);
+
+	/* Configure camera capture parameters for low latency */
+	char framerate_str[16];
+	snprintf(framerate_str, sizeof(framerate_str), "%d", src->frame_rate);
+	av_dict_set(&options, "framerate", framerate_str, 0);
+	av_dict_set(&options, "pixel_format", "nv12", 0);
+	av_dict_set(&options, "probesize", "32", 0);
+	av_dict_set(&options, "video_size", video_size, 0);
+	/* Minimal buffer for low latency - just 1 frame worth */
+	av_dict_set_int(&options, "buffer_size", 4096, 0);
+	av_dict_set_int(&options, "input_queue_size", 1, 0);
+	av_dict_set(&options, "analyzeduration", "0", 0);
+	av_dict_set(&options, "fflags", "nobuffer+igndts", 0);
+	av_dict_set(&options, "flags", "low_delay", 0);
+
+	if (avformat_open_input(&src->fmt_ctx, camera_device, src->input_fmt, &options) != 0) {
+		fprintf(stderr, "Cannot open camera device: %s\n", camera_device);
+		av_dict_free(&options);
+		return -1;
+	}
+	av_dict_free(&options);
+
+	if (avformat_find_stream_info(src->fmt_ctx, NULL) < 0) {
+		fprintf(stderr, "Cannot find stream info\n");
+		avformat_close_input(&src->fmt_ctx);
+		return -1;
+	}
+
+	/* Log camera stream parameters for debugging */
+	AVCodecParameters *cp = src->fmt_ctx->streams[0]->codecpar;
+	printf("Camera stream: width=%d, height=%d, pix_fmt=%d, bitrate=%ld\n",
+		cp->width, cp->height, cp->format, cp->bit_rate);
+	printf("Camera codecpar: codec_id=%d, profile=%d, level=%d\n",
+		cp->codec_id, cp->profile, cp->level);
+
+	return 0;
+}
+
+/* Queue encoded packet */
+static void queue_encoded_packet(struct vpu_source *src, AVPacket *pkt, int pkt_count)
+{
+	AVPacket *encoded_pkt = NULL;
+
+	if (src->stop_flag)
+		return;
+
+	encoded_pkt = av_packet_alloc();
+	if (!encoded_pkt) {
+		fprintf(stderr, "Failed to allocate encoded packet\n");
+		return;
+	}
+
+	av_packet_move_ref(encoded_pkt, pkt);
+
+	// fprintf(stderr, "[vpu-thread] about to lock mutex, queue_size=%d, capacity=%d\n",
+	// 	src->packet_queue_size, src->packet_queue_capacity);
+	pthread_mutex_lock(&src->packet_mutex);
+	//fprintf(stderr, "[vpu-thread] got mutex, queue_size=%d\n", src->packet_queue_size);
+
+	/* Wait until space is available in the queue */
+	while (src->packet_queue_size >= src->packet_queue_capacity && !src->stop_flag) {
+		fprintf(stderr, "[vpu-thread] queue full, waiting on cond (size=%d >= cap=%d)...\n",
+		 	src->packet_queue_size, src->packet_queue_capacity);
+		pthread_cond_wait(&src->packet_cond, &src->packet_mutex);
+		//fprintf(stderr, "[vpu-thread] cond wait done\n");
+	}
+
+	src->packet_queue[src->packet_queue_tail] = encoded_pkt;
+	src->packet_queue_tail = (src->packet_queue_tail + 1) % src->packet_queue_capacity;
+	src->packet_queue_size++;
+
+	/* Notify waiting queue_buffer threads */
+	//fprintf(stderr, "[vpu-thread] about to signal cond, queue_size=%d\n", src->packet_queue_size);
+	pthread_cond_signal(&src->packet_cond);
+
+	pthread_mutex_unlock(&src->packet_mutex);
+
+
+	if (pkt_count <= 5 || pkt_count % 90000 == 0) {
+		printf("vpu_thread: pkt %d queued, size=%d, queue_size=%d max=%d \n",
+			pkt_count, encoded_pkt->size, src->packet_queue_size, src->packet_queue_capacity);
+	}
+
+}
