+static int init_encoder(struct vpu_source *src, int width, int height)
+{
+
+	const AVCodec *codec = avcodec_find_encoder_by_name("mjpeg_v4l2m2m");
+
+	if (!codec) {
+		fprintf(stderr, "Cannot find mjpeg encoder\n");
+		return -1;
+	}
+
+	src->codec_ctx = avcodec_alloc_context3(codec);
+	if (!src->codec_ctx) {
+		fprintf(stderr, "Cannot allocate codec context\n");
+		return -1;
+	}
+
+	/* Basic encoder parameters */
+	src->codec_ctx->codec_id = codec->id;
+	src->codec_ctx->codec_type = AVMEDIA_TYPE_VIDEO;
+	src->codec_ctx->width = width;
+	src->codec_ctx->height = height;
+	src->codec_ctx->pix_fmt = AV_PIX_FMT_NV12;
+	src->codec_ctx->time_base = (AVRational){1, 30};
+	//src->codec_ctx->framerate = (AVRational){30, 1};
+	src->codec_ctx->bit_rate = 0;  // Auto bitrate for MJPEG
+	src->codec_ctx->gop_size = 1;  // I-frame only for minimum latency
+	src->codec_ctx->max_b_frames = 0;
+
+	/* CBR mode */
+
+	src->codec_ctx->qmin = 20;
+	src->codec_ctx->qmax = 40;
+	src->codec_ctx->qcompress = 0.9;
+	/* CBR mode settings for consistent quality */
+	src->codec_ctx->rc_min_rate = 0;
+	src->codec_ctx->rc_max_rate = 0;
+	src->codec_ctx->rc_buffer_size = 0;
+	src->codec_ctx->rc_initial_buffer_occupancy = 0;
+	/* Low delay settings */
+	src->codec_ctx->refs = 0;
+	src->codec_ctx->me_range = 8;
+	src->codec_ctx->max_qdiff = 6;
+
+	src->codec_ctx->flags |= AV_CODEC_FLAG_LOW_DELAY;
+	src->codec_ctx->flags &= ~AV_CODEC_FLAG_LOOP_FILTER;
+	src->codec_ctx->mb_decision = 0;
+	src->codec_ctx->trellis = 0;
+
+	/* V4L2 m2m specific options */
+	AVDictionary *codec_options = NULL;
+	av_dict_set_int(&codec_options, "num_output_buffers", 1, 0);
+	av_dict_set_int(&codec_options, "num_capture_buffers", 4, 0);
+	av_dict_set(&codec_options, "tune", "zerolatency", 0);
+
+	if (avcodec_open2(src->codec_ctx, codec, &codec_options) < 0) {
+		fprintf(stderr, "Cannot open codec\n");
+		av_dict_free(&codec_options);
+		avcodec_free_context(&src->codec_ctx);
+		return -1;
+	}
+	av_dict_free(&codec_options);
+
+	src->frame = av_frame_alloc();
+	src->frame->format = src->codec_ctx->pix_fmt;
+	src->frame->width = src->codec_ctx->width;
+	src->frame->height = src->codec_ctx->height;
+
+	/* Allocate frame buffer with 32-byte alignment */
+	if (av_frame_get_buffer(src->frame, 32) < 0) {
+		fprintf(stderr, "Cannot allocate frame buffer\n");
+		av_frame_free(&src->frame);
+		avcodec_free_context(&src->codec_ctx);
+		return -1;
+	}
+
+	src->pkt = av_packet_alloc();
+	if (!src->pkt) {
+		fprintf(stderr, "Cannot allocate packet\n");
+		av_frame_free(&src->frame);
+		avcodec_free_context(&src->codec_ctx);
+		return -1;
+	}
+
+
+	return 0;
+}
+
+static void *vpu_thread(void *arg)
+{
+	struct vpu_source *src = (struct vpu_source *)arg;
+	int ret;
+
+	int pkt_count = 0;
+	//uint64_t last_frame_time = 0;
+
+	printf("vpu_thread start, TID: %d\n", (int)syscall(SYS_gettid));
+
+	/* Frame interval in microseconds (30fps = ~33333us) */
+	//uint64_t frame_interval_us = (src->frame_rate > 0) ? (1000000 / src->frame_rate) : 33333;
+
+	AVPacket *raw_pkt = av_packet_alloc();
+	if (!raw_pkt) {
+		fprintf(stderr, "Failed to allocate raw packet\n");
+		return NULL;
+	}
+
+	while (!src->stop_flag) {
+		// if( (frame_count %100 == 0)|| frame_count <5 )
+		// 	printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+
+		/* Read raw frame from camera */
+		ret = av_read_frame(src->fmt_ctx, raw_pkt);
+		if (ret < 0) {
+			fprintf(stderr, "Error reading frame: %d\n", ret);
+			break;
+		}
+
+		if (raw_pkt->stream_index != 0) {
+			av_packet_free(&raw_pkt);
+			raw_pkt = av_packet_alloc();
+			if (!raw_pkt) {
+				break;
+			}
+			continue;
+		}
+
+		frame_count++;
+		// if(frame_count%3==0){
+		// 	av_packet_free(&raw_pkt);
+		// 	raw_pkt = av_packet_alloc();
+		// 	if (!raw_pkt) {
+		// 		break;
+		// 	}
+		// 	continue;
+		// }
+
+
+		//printf("capture fram=%d\n", frame_count);
+
+		/* Reference camera RTSP demo - directly point frame to raw_pkt data (zero-copy) */
+		int cam_width = src->fmt_ctx->streams[0]->codecpar->width;
+		int cam_height = src->fmt_ctx->streams[0]->codecpar->height;
+
+		/* Direct pointer assignment - no memcpy */
+		src->frame->data[0] = raw_pkt->data;
+		src->frame->linesize[0] = cam_width;
+		src->frame->data[1] = raw_pkt->data + cam_width * cam_height;
+		src->frame->linesize[1] = cam_width;
+		src->frame->pts = raw_pkt->pts;
+
+		// if( (frame_count %101 == 0)|| frame_count <5 )
+		// 	printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+
+
+		/* Send frame to encoder */
+		ret = avcodec_send_frame(src->codec_ctx, src->frame);
+		if (ret < 0) {
+			fprintf(stderr, "Error sending frame to encoder: %d\n", ret);
+			av_packet_free(&raw_pkt);
+			break;
+		}
+		// if( (frame_count %101 == 0)|| frame_count <5 )
+		// 	printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+		/* Receive encoded packets - loop until EAGAIN */
+		for (;;) {
+			ret = avcodec_receive_packet(src->codec_ctx, src->pkt);
+			if (ret == AVERROR(EAGAIN)) { //EAGAIN = "Try again" - 编码器暂时没有可用的输出包,表示编码器内部缓冲区为空，需要先送入新的帧才能生成输出包
+				//usleep(1000); //1ms;
+				break;
+			} else if (ret == AVERROR_EOF) {
+				break;
+			} else if (ret < 0) {
+				fprintf(stderr, "Error receiving packet: %d\n", ret);
+				break;
+			}
+			pkt_count++;
+
+			// Skip every 4th frame to reduce UVC driver buffering delay
+			// if(pkt_count%28==0){
+			// 	av_packet_free(&src->pkt);
+			// 	src->pkt = av_packet_alloc();
+			// 	continue;
+			// }
+			// if(pkt_count < 10){
+			// 	av_packet_free(&src->pkt);
+			// 	src->pkt = av_packet_alloc();
+			// 	continue;
+			// }
+
+
+			// if( (frame_count %101 == 0)|| frame_count <5 )
+			// 	printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+			/* Queue encoded packet */
+			queue_encoded_packet(src, src->pkt, pkt_count);
+			// if( (frame_count %101 == 0)|| frame_count <5 )
+			// 	printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+		}
+
+		av_packet_free(&raw_pkt);
+		raw_pkt = av_packet_alloc();
+		if (!raw_pkt) {
+			break;
+		}
+		//usleep(1000);
+	}
+
+	printf("vpu_thread exit, frames: %d, pkts: %d\n", frame_count, pkt_count);
+
+	av_packet_free(&raw_pkt);
+
+	return NULL;
+}
+
+static void vpu_source_destroy(struct video_source *s)
+{
+	struct vpu_source *src = to_vpu_source(s);
+
+	src->stop_flag = 1;
+
+	/* Wake up any waiting threads before joining */
+	pthread_mutex_lock(&src->packet_mutex);
+	pthread_cond_broadcast(&src->packet_cond);
+	pthread_mutex_unlock(&src->packet_mutex);
+
+	if (src->vpu_tid) {
+		pthread_join(src->vpu_tid, NULL);
+	}
+
+	/* Cleanup packets in queue */
+	pthread_mutex_lock(&src->packet_mutex);
+	/* Free all packets in the queue (circular buffer) */
+	if (src->packet_queue_head <= src->packet_queue_tail) {
+		/* No wrap - contiguous data */
+		for (int i = src->packet_queue_head; i < src->packet_queue_tail; i++) {
+			if (src->packet_queue[i]) {
+				av_packet_free(&src->packet_queue[i]);
+			}
+		}
+	} else {
+		/* Wrapped - data in two segments */
+		for (int i = src->packet_queue_head; i < src->packet_queue_capacity; i++) {
+			if (src->packet_queue[i]) {
+				av_packet_free(&src->packet_queue[i]);
+			}
+		}
+		for (int i = 0; i < src->packet_queue_tail; i++) {
+			if (src->packet_queue[i]) {
+				av_packet_free(&src->packet_queue[i]);
+			}
+		}
+	}
+	/* Wake up any waiting queue_buffer threads */
+	pthread_cond_broadcast(&src->packet_cond);
+	pthread_mutex_unlock(&src->packet_mutex);
+
+	/* Cleanup FFmpeg resources */
+	av_packet_free(&src->pkt);
+	av_frame_free(&src->frame);
+	avcodec_free_context(&src->codec_ctx);
+	avformat_close_input(&src->fmt_ctx);
+
+	/* Cleanup video buffers */
+	if (src->output_buffers) {
+		for (unsigned int i = 0; i < src->output_buffers->nbufs; i++) {
+			if (src->output_buffers->buffers[i].mem) {
+				free(src->output_buffers->buffers[i].mem);
+				src->output_buffers->buffers[i].mem = NULL;
+			}
+		}
+		video_buffer_set_delete(src->output_buffers);
+	}
+
+	pthread_mutex_destroy(&src->packet_mutex);
+	pthread_cond_destroy(&src->packet_cond);
+
+	free(src->camera_device);
+	free(src);
+}
+
+static int vpu_source_set_format(struct video_source *s, struct v4l2_pix_format *fmt)
+{
+	struct vpu_source *src = to_vpu_source(s);
+	int ret;
+
+	/* Store width, height and frame rate from format/set_frame_rate */
+	src->set_width = fmt->width;
+	src->set_height = fmt->height;
+	fmt->pixelformat = V4L2_PIX_FMT_MJPEG;
+	fmt->field = V4L2_FIELD_ANY;
+
+	/* Reinitialize if width or height changed */
+	if (!src->initialized ||
+	    src->set_width != src->codec_ctx->width ||
+	    src->set_height != src->codec_ctx->height) {
+		/* Cleanup existing resources if already initialized */
+		if (src->initialized) {
+			avcodec_free_context(&src->codec_ctx);
+			av_frame_free(&src->frame);
+			av_packet_free(&src->pkt);
+			avformat_close_input(&src->fmt_ctx);
+		}
+		/* Initialize camera with new format (uses current frame_rate) */
+		ret = init_camera(src, src->camera_device, src->set_width, src->set_height);
+		if (ret < 0) {
+			return -1;
+		}
+		/* Initialize encoder with new format */
+		ret = init_encoder(src, src->set_width, src->set_height);
+		if (ret < 0) {
+			avformat_close_input(&src->fmt_ctx);
+			return -1;
+		}
+		src->initialized = 1;
+	}
+	fmt->sizeimage = (src->set_width * src->set_height * 2); /* MJPEG: ~2 bytes per pixel */
+
+	return 0;
+}
+
+static int vpu_source_set_frame_rate(struct video_source *s, unsigned int fps)
+{
+	struct vpu_source *src = to_vpu_source(s);
+	int ret;
+	src->frame_rate = fps;
+	/* Reinitialize camera with new frame rate immediately */
+	if (src->initialized && src->fmt_ctx) {
+		avformat_close_input(&src->fmt_ctx);
+		ret = init_camera(src, src->camera_device, src->set_width, src->set_height);
+		if (ret < 0) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int vpu_source_alloc_buffers(struct video_source *s, unsigned int nbufs)
+{
+	struct vpu_source *src = to_vpu_source(s);
+	if(nbufs < 2 )
+		nbufs = 2;
+
+	unsigned int queue_size = nbufs;
+
+	/* Allocate output buffer set */
+	src->output_buffers = video_buffer_set_new(nbufs);
+	if (!src->output_buffers) {
+		return -ENOMEM;
+	}
+
+
+	src->packet_queue_capacity = queue_size;
+	//printf("f=%s l=%d xxxcap=%d\n", __func__, __LINE__, src->packet_queue_capacity);
+	src->packet_queue = (AVPacket **)calloc(queue_size, sizeof(AVPacket *));
+	if (!src->packet_queue) {
+		video_buffer_set_delete(src->output_buffers);
+		return -ENOMEM;
+	}
+	src->packet_queue_size = 0;
+	src->packet_queue_head = 0;
+	src->packet_queue_tail = 0;
+
+	/* Buffer memory will be provided by sink via import_buffers */
+	for (unsigned int i = 0; i < nbufs; i++) {
+		src->output_buffers->buffers[i].size = 1024 * 1024;
+		src->output_buffers->buffers[i].mem = NULL;
+		src->output_buffers->buffers[i].dmabuf = -1;
+	}
+
+	return 0;
+}
+
+static int vpu_source_export_buffers(struct video_source *s,
+					      struct video_buffer_set **bufs)
+{
+	struct vpu_source *src = to_vpu_source(s);
+
+	*bufs = src->output_buffers;
+	return 0;
+}
+
+static int vpu_source_import_buffers(struct video_source *s,
+					      struct video_buffer_set *buffers)
+{
+	struct vpu_source *src = to_vpu_source(s);
+
+	/* Use sink's buffer memory for encoded output */
+	for (unsigned int i = 0; i < buffers->nbufs; i++) {
+		src->output_buffers->buffers[i].mem = buffers->buffers[i].mem;
+		src->output_buffers->buffers[i].size = buffers->buffers[i].size;
+		src->output_buffers->buffers[i].dmabuf = buffers->buffers[i].dmabuf;
+	}
+
+	return 0;
+}
+
+static int vpu_source_free_buffers(struct video_source *s)
+{
+	struct vpu_source *src = to_vpu_source(s);
+
+	/* Buffer memory is owned by sink, don't free it */
+	if (src->output_buffers) {
+		video_buffer_set_delete(src->output_buffers);
+		src->output_buffers = NULL;
+	}
+
+	if (src->packet_queue) {
+		/* Free all packets in the queue (circular buffer) */
+		if (src->packet_queue_head <= src->packet_queue_tail) {
+			/* No wrap - contiguous data */
+			for (int i = src->packet_queue_head; i < src->packet_queue_tail; i++) {
+				if (src->packet_queue[i]) {
+					av_packet_free(&src->packet_queue[i]);
+				}
+			}
+		} else {
+			/* Wrapped - data in two segments */
+			for (int i = src->packet_queue_head; i < src->packet_queue_capacity; i++) {
+				if (src->packet_queue[i]) {
+					av_packet_free(&src->packet_queue[i]);
+				}
+			}
+			for (int i = 0; i < src->packet_queue_tail; i++) {
+				if (src->packet_queue[i]) {
+					av_packet_free(&src->packet_queue[i]);
+				}
+			}
+		}
+		free(src->packet_queue);
+		src->packet_queue = NULL;
+	}
+
+	return 0;
+}
+
+static int vpu_source_stream_on(struct video_source *s)
+{
+	struct vpu_source *src = to_vpu_source(s);
+	int ret;
+
+	src->stop_flag = 0;
+
+	ret = pthread_create(&src->vpu_tid, NULL, vpu_thread, src);
+	if (ret) {
+		fprintf(stderr, "Failed to create vpu thread\n");
+		return -1;
+	}
+
+	/* Start encoding immediately without waiting for first packet */
+	/* queue_buffer will handle empty queue by checking vpu_source_if_have_data */
+
+	return 0;
+}
+
+static int vpu_source_stream_off(struct video_source *s)
+{
+	struct vpu_source *src = to_vpu_source(s);
+
+	src->stop_flag = 1;
+
+	/* Wake up any waiting queue_buffer threads */
+	pthread_mutex_lock(&src->packet_mutex);
+	pthread_cond_broadcast(&src->packet_cond);
+	pthread_mutex_unlock(&src->packet_mutex);
+
+	pthread_join(src->vpu_tid, NULL);
+
+	return 0;
+}
+int vpu_source_if_have_data(struct video_source *s)
+{
+	int ret = 0;
+	struct vpu_source *src = to_vpu_source(s);
+
+	pthread_mutex_lock(&src->packet_mutex);
+	ret = src->packet_queue_size;
+	pthread_mutex_unlock(&src->packet_mutex);
+	return ret;
+}
+
+static int vpu_source_queue_buffer(struct video_source *s, struct video_buffer *buf)
+{
+	struct vpu_source *src = to_vpu_source(s);
+	int ret = 0;
+	AVPacket *pkt = NULL;
+
+	//fprintf(stderr, "[main-thread] about to lock mutex, queue_size=%d\n", src->packet_queue_size);
+	pthread_mutex_lock(&src->packet_mutex);
+	if(src->packet_queue_size > 0){
+		pkt = src->packet_queue[src->packet_queue_head];
+		src->packet_queue_head = (src->packet_queue_head + 1) % src->packet_queue_capacity;
+		src->packet_queue_size--;
+		pthread_cond_signal(&src->packet_cond);
+	}
+	pthread_mutex_unlock(&src->packet_mutex);
+
+
+	if (pkt && pkt->data) {
+		if ((size_t)pkt->size <= buf->size) {
+			memcpy(buf->mem, pkt->data, pkt->size);
+			buf->bytesused = pkt->size;
+			buf->timestamp.tv_sec = pkt->pts / 1000000;
+			buf->timestamp.tv_usec = pkt->pts % 1000000;
+
+
+			// printf("[vpu-source] queue_buffer: size=%d, bytesused=%u, queue_left=%d\n",
+		} else {
+			fprintf(stderr, "vpu-source: buffer too small (pkt=%d, buf=%u)\n",
+				pkt->size, (unsigned int)buf->size);
+			buf->bytesused = 0;
+			ret = -ENOMEM;
+		}
+		av_packet_free(&pkt);
+	} else {
+		buf->bytesused = 0;
+	}
+
+	/* Always call handler to requeue buffer */
+	if (src->src.handler) {
+		//printf("[vpu-source] calling handler...\n");
+		src->src.handler(src->src.handler_data, s, buf);
+	}
+	// if( (frame_count %101 == 0)|| frame_count <5 )
+	// 		printf("[DEBUG] %s: %d - Frame %d start processing at %lu ms\n", __func__, __LINE__, frame_count,get_time_ms());
+
+	return ret;
+}
+
+static const struct video_source_ops vpu_source_ops = {
+	.destroy = vpu_source_destroy,
+	.set_format = vpu_source_set_format,
+	.set_frame_rate = vpu_source_set_frame_rate,
+	.alloc_buffers = vpu_source_alloc_buffers,
+	.export_buffers = vpu_source_export_buffers,
+	.import_buffers = vpu_source_import_buffers,
+	.free_buffers = vpu_source_free_buffers,
+	.stream_on = vpu_source_stream_on,
+	.stream_off = vpu_source_stream_off,
+	.queue_buffer = vpu_source_queue_buffer,
+	.fill_buffer = NULL,
+};
+
+struct video_source *vpu_source_create(const char *camera_device)
+{
+	struct vpu_source *src;
+
+	src = (struct vpu_source *)calloc(1, sizeof(*src));
+	if (!src) {
+		return NULL;
+	}
+
+	src->src.ops = &vpu_source_ops;
+	src->src.type = VIDEO_SOURCE_VPU_ENCODED;
+
+	/* Save configuration for later initialization in set_format */
+	src->camera_device = strdup(camera_device);
+	if (!src->camera_device) {
+		free(src);
+		return NULL;
+	}
+
+	/* Default frame rate 30 */
+	src->frame_rate = 30;
+
+	pthread_mutex_init(&src->packet_mutex, NULL);
+	pthread_cond_init(&src->packet_cond, NULL);
+
+	return &src->src;
+}
+
+void vpu_source_init(struct video_source *s, struct events *events)
+{
+	struct vpu_source *src = to_vpu_source(s);
+
+	src->src.events = events;
+}
