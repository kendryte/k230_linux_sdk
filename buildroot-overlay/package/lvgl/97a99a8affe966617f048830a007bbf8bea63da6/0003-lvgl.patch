diff --git a/src/main_k230.c b/src/main_k230.c
new file mode 100644
index 0000000..9b20e1d
--- /dev/null
+++ b/src/main_k230.c
@@ -0,0 +1,267 @@
+/*******************************************************************
+ *
+ * main.c - LVGL simulator for GNU/Linux
+ *
+ * Based on the original file from the repository
+ *
+ * @note eventually this file won't contain a main function and will
+ * become a library supporting all major operating systems
+ *
+ * To see how each driver is initialized check the
+ * 'src/lib/display_backends' directory
+ *
+ * - Clean up
+ * - Support for multiple backends at once
+ *   2025 EDGEMTech Ltd.
+ *
+ * Author: EDGEMTech Ltd, Erik Tagirov (erik.tagirov@edgemtech.ch)
+ *
+ ******************************************************************/
+#define _GNU_SOURCE
+#include <unistd.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "lvgl/lvgl.h"
+#include "lvgl/demos/lv_demos.h"
+
+#include "display.h"
+#include "v4l2-drm.h"
+
+#include "src/lib/driver_backends.h"
+#include "src/lib/simulator_util.h"
+#include "src/lib/simulator_settings.h"
+#include "src/lib/backends.h"
+
+/* Internal functions */
+static void configure_simulator(int argc, char ** argv);
+static void print_lvgl_version(void);
+static void print_usage(void);
+
+/* contains the name of the selected backend if user
+ * has specified one on the command line */
+static char * selected_backend;
+
+/* Global simulator settings, defined in lv_linux_backend.c */
+extern simulator_settings_t settings;
+
+
+/**
+ * @brief Print LVGL version
+ */
+static void print_lvgl_version(void)
+{
+    fprintf(stdout, "%d.%d.%d-%s\n",
+            LVGL_VERSION_MAJOR,
+            LVGL_VERSION_MINOR,
+            LVGL_VERSION_PATCH,
+            LVGL_VERSION_INFO);
+}
+
+/**
+ * @brief Print usage information
+ */
+static void print_usage(void)
+{
+    fprintf(stdout,
+            "\nlvglsim [-V] [-B] [-f] [-m] [-b backend_name] [-W window_width] [-H window_height] [-R rotation]\n\n");
+    fprintf(stdout, "-V print LVGL version\n");
+    fprintf(stdout, "-B list supported backends\n");
+    fprintf(stdout, "-f fullscreen\n");
+    fprintf(stdout, "-m maximize\n");
+}
+
+/**
+ * @brief Configure simulator
+ * @description process arguments received by the program to select
+ * appropriate options
+ * @param argc the count of arguments in argv
+ * @param argv The arguments
+ */
+static void configure_simulator(int argc, char ** argv)
+{
+    int opt = 0;
+
+    selected_backend = NULL;
+    driver_backends_register();
+
+    const char * env_w = getenv("LV_SIM_WINDOW_WIDTH");
+    const char * env_h = getenv("LV_SIM_WINDOW_HEIGHT");
+    /* Default values */
+    settings.window_width = atoi(env_w ? env_w : "800");
+    settings.window_height = atoi(env_h ? env_h : "480");
+
+    /* Parse the command-line options. */
+    while((opt = getopt(argc, argv, "b:fmW:H:R:BVh")) != -1) {
+        switch(opt) {
+            case 'h':
+                print_usage();
+                exit(EXIT_SUCCESS);
+                break;
+            case 'V':
+                print_lvgl_version();
+                exit(EXIT_SUCCESS);
+                break;
+            case 'B':
+                driver_backends_print_supported();
+                exit(EXIT_SUCCESS);
+                break;
+            case 'b':
+                if(driver_backends_is_supported(optarg) == 0) {
+                    die("error no such backend: %s\n", optarg);
+                }
+                selected_backend = strdup(optarg);
+                break;
+            case 'f':
+                settings.fullscreen = true;
+                break;
+            case 'm':
+                settings.maximize = true;
+                break;
+            case 'W':
+                settings.window_width = atoi(optarg);
+                break;
+            case 'H':
+                settings.window_height = atoi(optarg);
+                break;
+            case 'R':
+                switch(atoi(optarg)) {
+                    case 0:
+                        settings.rotation = LV_DISPLAY_ROTATION_0;
+                        break;
+                    case 90:
+                        settings.rotation = LV_DISPLAY_ROTATION_90;
+                        break;
+                    case 180:
+                        settings.rotation = LV_DISPLAY_ROTATION_180;
+                        break;
+                    case 270:
+                        settings.rotation = LV_DISPLAY_ROTATION_270;
+                        break;
+                    default:
+                        LV_LOG_WARN("Invalid rotation angle. Valid angles are {0, 90, 180, 270}");
+                        break;
+                }
+                break;
+            case ':':
+                print_usage();
+                die("Option -%c requires an argument.\n", optopt);
+                break;
+            case '?':
+                print_usage();
+                die("Unknown option -%c.\n", optopt);
+        }
+    }
+}
+
+
+/* v4l2-drm shared OSD buffer (consumed in v4l2_drm_run_v4l2_2_drm) */
+extern struct display_buffer *g_p_osd_disp_buffer;
+extern bool v4l2_drm_run_v4l2_2_drm_need_run;
+
+/* Global simulator settings, defined in the backend */
+extern simulator_settings_t settings;
+
+/* Shared display handle */
+struct display * g_display = NULL;
+
+/* Camera context */
+static struct v4l2_drm_context g_v4l2_ctx;
+
+/**
+ * v4l2-drm thread — runs the camera capture + display loop.
+ * It picks up the OSD buffer from g_p_osd_disp_buffer and
+ * commits both video and OSD planes on each vsync.
+ */
+static void * v4l2_thread(void * arg)
+{
+    (void)arg;
+    v4l2_drm_run_v4l2_2_drm(&g_v4l2_ctx, 1, NULL);
+    return NULL;
+}
+
+/**
+ * @brief entry point
+ */
+int main(int argc, char ** argv)
+{
+    int ret;
+
+    /* ---- 1. Initialize the shared DRM display ---- */
+    g_display = display_init(0);
+    if(g_display == NULL) {
+        fprintf(stderr, "display_init failed\n");
+        return -1;
+    }
+    printf("[main] display_init OK: %ux%u\n", g_display->width, g_display->height);
+
+    /* ---- 2. Initialize v4l2-drm (camera → NV12 video plane) ---- */
+    v4l2_drm_default_context(&g_v4l2_ctx);
+    g_v4l2_ctx.device = 1;                     /* /dev/video1 */
+    g_v4l2_ctx.width = 480;
+    g_v4l2_ctx.height = 800;
+    g_v4l2_ctx.video_format = V4L2_PIX_FMT_NV12;
+    g_v4l2_ctx.display_format = DRM_FORMAT_NV12;
+    g_v4l2_ctx.display = true;
+    g_v4l2_ctx.drm_rotation = rotation_0;
+
+    ret = v4l2_drm_setup(&g_v4l2_ctx, 1, &g_display);
+    if(ret < 0) {
+        fprintf(stderr, "v4l2_drm_setup failed\n");
+        return -1;
+    }
+    printf("[main] v4l2_drm_setup OK\n");
+
+    /* ---- 3. Initialize LVGL via standard backend framework ---- */
+    lv_init();
+
+
+    /* Register all backends */
+    driver_backends_register();
+
+    /* Initialize display backend (DRM_V4L2_K230 is the default/first) */
+    ret = driver_backends_init_backend("DRM_V4L2_K230");
+    if(ret == -1) {
+        fprintf(stderr, "LVGL display init failed\n");
+        return -1;
+    }
+    printf("[main] LVGL display initxxxx  OK\n");
+
+    /* Initialize evdev input backend */
+#if LV_USE_EVDEV
+    ret = driver_backends_init_backend("EVDEV");
+    if(ret == -1) {
+        fprintf(stderr, "Failed to initialize evdev\n");
+    }
+#endif
+
+    /* ---- 4. Create simple LVGL UI for testing ---- */
+    lv_obj_set_style_bg_opa(lv_screen_active(), LV_OPA_TRANSP, 0);
+
+    /* Just a simple label in the center — rest of screen is transparent */
+    lv_obj_t * label = lv_label_create(lv_screen_active());
+    lv_label_set_text(label, "K230 LVGL xx OK");
+    lv_obj_set_style_bg_opa(label, LV_OPA_50, 0);
+    lv_obj_set_style_bg_color(label, lv_color_black(), 0);
+    lv_obj_set_style_text_color(label, lv_color_white(), 0);
+    lv_obj_align(label, LV_ALIGN_CENTER, 0, 0);
+
+    /* ---- 5. Start the v4l2-drm thread ---- */
+    v4l2_drm_run_v4l2_2_drm_need_run = true;
+    pthread_t tid;
+    ret = pthread_create(&tid, NULL, v4l2_thread, NULL);
+    if(ret != 0) {
+        fprintf(stderr, "pthread_create failed: %s\n", strerror(ret));
+        return -1;
+    }
+    pthread_setname_np(tid, "v4l2-drm");
+    printf("[main] v4l2-drm thread started\n");
+
+    /* ---- 6. Run the backend's main loop ---- */
+    printf("[main] entering LVGL main loop\n");
+    driver_backends_run_loop();
+
+    return 0;
+}
