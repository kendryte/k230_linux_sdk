diff --git a/src/lib/display_backends/drm_k230_v4l2.c b/src/lib/display_backends/drm_k230_v4l2.c
new file mode 100644
index 0000000..77f1097
--- /dev/null
+++ b/src/lib/display_backends/drm_k230_v4l2.c
@@ -0,0 +1,240 @@
+/**
+ * @file drm_k230_v4l2.c
+ *
+ * K230 custom DRM backend - uses v4l2-drm's display library
+ * so that LVGL (OSD layer) and camera (video layer) share
+ * the same DRM fd and can be committed together.
+ *
+ * The shared struct display is created externally (in main.c)
+ * and passed in via init_drm_k230_with_display().
+ */
+
+/*********************
+ *      INCLUDES
+ *********************/
+#include <unistd.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <string.h>
+
+#include "lvgl/lvgl.h"
+#if LV_USE_LINUX_DRM
+
+#include <drm/drm_fourcc.h>
+#include <xf86drm.h>
+#include <errno.h>
+
+#include "display.h"
+#include "v4l2-drm.h"
+
+#include "../backends.h"
+#include <time.h>
+
+/*********************
+ *      DEFINES
+ *********************/
+
+/**********************
+ *      TYPEDEFS
+ **********************/
+
+/**********************
+ *  STATIC PROTOTYPES
+ **********************/
+static void run_loop_drm(void);
+static lv_display_t * init_drm_k230(void);
+static void drm_k230_flush(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map);
+static void drm_k230_flush_wait(lv_display_t * disp);
+
+/**********************
+ *  STATIC VARIABLES
+ **********************/
+static char * backend_name = "DRM_V4L2_K230";
+
+
+extern struct display * g_display = NULL;
+static struct display_plane * g_osd_plane = NULL;
+static struct display_buffer * g_osd_bufs[2];
+static int g_osd_buf_idx = 0;
+
+/**********************
+ *      MACROS
+ **********************/
+
+/**********************
+ *   GLOBAL FUNCTIONS
+ **********************/
+
+/**
+ * Register the backend
+ */
+int backend_init_drm_k230_v4l2(backend_t * backend)
+{
+    LV_ASSERT_NULL(backend);
+
+    backend->handle->display = malloc(sizeof(display_backend_t));
+    LV_ASSERT_NULL(backend->handle->display);
+
+    backend->handle->display->init_display = init_drm_k230;
+    backend->handle->display->run_loop = run_loop_drm;
+    backend->name = backend_name;
+    backend->type = BACKEND_DISPLAY;
+
+    return 0;
+}
+
+
+static uint32_t tick_get_cb(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    uint64_t time_ms = t.tv_sec * 1000 + (t.tv_nsec / 1000000);
+    return time_ms;
+}
+
+/**
+ * Initialize LVGL display using the shared v4l2-drm display.
+ *
+
+ * This is the standard backend init_display callback (no arguments).
+ */
+static lv_display_t * init_drm_k230(void)
+{
+    if(g_display == NULL) {
+        LV_LOG_ERROR("g_display is NULL — call  first");
+        return NULL;
+    }
+
+    lv_tick_set_cb(tick_get_cb);
+
+    /* Get an RGB565 plane for the OSD layer */
+#if LV_COLOR_DEPTH == 32
+    uint32_t fourcc = DRM_FORMAT_ARGB8888;
+#elif LV_COLOR_DEPTH == 16
+    uint32_t fourcc = DRM_FORMAT_RGB565;
+#else
+    uint32_t fourcc = DRM_FORMAT_RGB565;
+#endif
+
+    g_osd_plane = display_get_plane(g_display, fourcc);
+    if(g_osd_plane == NULL) {
+        LV_LOG_ERROR("Failed to get OSD plane for fourcc 0x%x", fourcc);
+        return NULL;
+    }
+
+    /* Allocate double-buffered display buffers */
+    g_osd_bufs[0] = display_allocate_buffer(g_osd_plane, g_display->width, g_display->height);
+    g_osd_bufs[1] = display_allocate_buffer(g_osd_plane, g_display->width, g_display->height);
+    if(g_osd_bufs[0] == NULL || g_osd_bufs[1] == NULL) {
+        LV_LOG_ERROR("Failed to allocate OSD display buffers");
+        return NULL;
+    }
+
+    LV_LOG_INFO("OSD plane %u, buffers %u/%u, size %u, stride %u",
+                g_osd_plane->plane_id,
+                g_osd_bufs[0]->id, g_osd_bufs[1]->id,
+                g_osd_bufs[0]->size, g_osd_bufs[0]->stride);
+
+    /* Create LVGL display - size matches the DRM mode */
+    lv_display_t * disp = lv_display_create(g_display->width, g_display->height);
+    if(disp == NULL) {
+        LV_LOG_ERROR("lv_display_create failed");
+        return NULL;
+    }
+
+    /* Use ARGB8888 so LVGL outputs real alpha — needed for transparent OSD overlay.
+     * Must be set BEFORE lv_display_set_buffers so LVGL validates buffer size correctly. */
+    lv_display_set_color_format(disp, LV_COLOR_FORMAT_ARGB8888);
+
+    /* Set resolution first (required for DIRECT mode before setting buffers) */
+    lv_display_set_resolution(disp, g_display->width, g_display->height);
+
+    /* Wire the display_buffer mmap regions directly as LVGL render buffers.
+     * LVGL renders in-place into the DRM dumb buffers — zero copy.
+     * Must use set_buffers_with_stride so LVGL knows the DRM stride. */
+    lv_display_set_buffers_with_stride(disp,
+                                       g_osd_bufs[0]->map,
+                                       g_osd_bufs[1]->map,
+                                       g_osd_bufs[0]->size,
+                                       g_osd_bufs[0]->stride,
+                                       LV_DISPLAY_RENDER_MODE_DIRECT);
+    lv_display_set_flush_cb(disp, drm_k230_flush);
+    lv_display_set_flush_wait_cb(disp, drm_k230_flush_wait);
+
+    g_osd_buf_idx = 0;
+
+    LV_LOG_INFO("K230 OSD display initialized: %ux%u fourcc=0x%x",
+                g_display->width, g_display->height, fourcc);
+
+    return disp;
+}
+
+/**********************
+ *   STATIC FUNCTIONS
+ **********************/
+
+/**
+ * LVGL flush callback.
+ *
+ * When LVGL finishes rendering a frame into one of the mmap'd
+ * display_buffers, we hand that buffer to the v4l2-drm thread
+ * via the g_p_osd_disp_buffer global.  The v4l2-drm thread
+ * will commit it together with the camera frame on the next vsync.
+ */
+static void drm_k230_flush(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map)
+{
+    LV_UNUSED(area);
+
+    if(!lv_display_flush_is_last(disp)) return;
+
+    /* Determine which buffer LVGL just rendered into */
+    struct display_buffer * buf;
+    if(px_map == g_osd_bufs[0]->map) {
+        buf = g_osd_bufs[0];
+    } else {
+        buf = g_osd_bufs[1];
+    }
+
+    /* Hand the buffer to the v4l2-drm thread — it will commit it on vsync */
+    g_p_osd_disp_buffer = buf;
+
+    lv_display_flush_ready(disp);
+}
+
+/**
+ * LVGL flush_wait callback.
+ *
+ * Called after flush_ready — LVGL waits here before starting the next frame.
+ * We block on the DRM vsync event so the CPU is idle until the next frame.
+ * This is the same approach as the official lv_linux_drm backend's drm_flush_wait.
+ */
+static void drm_k230_flush_wait(lv_display_t * disp)
+{
+    LV_UNUSED(disp);
+    if(g_display == NULL) return;
+
+    /* Wait for the next vblank — CPU sleeps until vsync, no busy-wait */
+    drmVBlank vblank;
+    memset(&vblank, 0, sizeof(vblank));
+    vblank.request.type = DRM_VBLANK_RELATIVE;
+    vblank.request.sequence = 1;
+    while(drmWaitVBlank(g_display->fd, &vblank) != 0) {
+        if(errno != EINTR) break;
+    }
+}
+
+/**
+ * The run loop — just drives LVGL's timer handler.
+ * The actual DRM commit happens in the v4l2-drm thread.
+ */
+static void run_loop_drm(void)
+{
+    uint32_t idle_time;
+
+    while(true) {
+        idle_time = lv_timer_handler();
+        usleep(idle_time * 1000);
+    }
+}
+
+#endif /* LV_USE_LINUX_DRM */
