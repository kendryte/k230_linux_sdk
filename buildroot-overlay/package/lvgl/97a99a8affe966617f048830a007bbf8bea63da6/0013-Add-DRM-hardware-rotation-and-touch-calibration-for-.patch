+void k230_set_drm_rotation(lv_display_rotation_t rot)
+{
+    LV_ASSERT(rot <= LV_DISPLAY_ROTATION_270);
+
+    const int rotation_map[] = {
+        [LV_DISPLAY_ROTATION_0]   = DRM_MODE_ROTATE_0,
+        [LV_DISPLAY_ROTATION_90]  = DRM_MODE_ROTATE_90,
+        [LV_DISPLAY_ROTATION_180] = DRM_MODE_ROTATE_180,
+        [LV_DISPLAY_ROTATION_270] = DRM_MODE_ROTATE_270,
+    };
+    g_drm_dev_rotation = rotation_map[rot];
+}
+static void lv_linux_drm_swap_weitht_height_by_rotaion(drm_dev_t * drm_dev)
+{
+    if(g_drm_dev_rotation == DRM_MODE_ROTATE_90 || g_drm_dev_rotation == DRM_MODE_ROTATE_270) {
+        uint32_t t = drm_dev->width;
+        drm_dev->width = drm_dev->height;
+        drm_dev->height = t;
+    }
+}
