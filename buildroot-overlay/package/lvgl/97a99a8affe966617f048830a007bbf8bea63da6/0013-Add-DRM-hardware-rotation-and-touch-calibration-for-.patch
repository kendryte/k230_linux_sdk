+static void cb_touch_coords(lv_event_t * e)
+{
+    lv_obj_t * lbl = (lv_obj_t *)lv_event_get_user_data(e);
+    lv_indev_t * indev = lv_indev_get_act();
+    if(!indev) return;
+    lv_point_t p;
+    lv_indev_get_point(indev, &p);
+    static char buf[32];
+    lv_snprintf(buf, sizeof(buf), "Touch: %d,%d", (int)p.x, (int)p.y);
+    lv_label_set_text(lbl, buf);
+}
+
+static void cb_tap_count(lv_event_t * e)
+{
+    static int count = 0;
+    count++;
+    lv_obj_t * lbl = (lv_obj_t *)lv_event_get_user_data(e);
+    static char buf[16];
+    lv_snprintf(buf, sizeof(buf), "Tap: %d", count);
+    lv_label_set_text(lbl, buf);
+}
+
+static void cb_color_toggle(lv_event_t * e)
+{
+    static bool state = false;
+    state = !state;
+    lv_obj_t * btn = (lv_obj_t *)lv_event_get_user_data(e);
+    lv_obj_set_style_bg_color(btn,
+        state ? lv_palette_main(LV_PALETTE_GREEN)
+              : lv_palette_main(LV_PALETTE_BLUE), 0);
+}
+
+static void cb_exit(lv_event_t * e)
+{
+    (void)e;
+    exit(0);
+}
+
+static void cb_drag(lv_event_t * e)
+{
+    lv_obj_t * obj = lv_event_get_target(e);
+    lv_indev_t * indev = lv_indev_get_act();
+    if(!indev) return;
+
+    lv_point_t vect;
+    lv_indev_get_vect(indev, &vect);
+    lv_obj_set_pos(obj, lv_obj_get_x(obj) + vect.x, lv_obj_get_y(obj) + vect.y);
+
+    /* update label inside */
+    lv_obj_t * lbl = lv_obj_get_child(obj, 0);
+    if(lbl) {
+        static char buf[32];
+        lv_snprintf(buf, sizeof(buf), "(%d,%d)", lv_obj_get_x(obj), lv_obj_get_y(obj));
+        lv_label_set_text(lbl, buf);
+    }
+}
