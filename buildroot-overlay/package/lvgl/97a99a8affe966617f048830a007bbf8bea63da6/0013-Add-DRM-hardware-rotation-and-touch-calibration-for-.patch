+static int k230_touch_point_init_by_rotation(simulator_settings_t *set)
+{
+    if(set->rotation == LV_DISPLAY_ROTATION_0) {
+        return 0;
+    }
+
+    lv_indev_t * indev = NULL;
+    int attempts = 20; /* wait up to ~200ms for device discovery */
+    while(attempts-- > 0) {
+        indev = NULL;
+        while((indev = lv_indev_get_next(indev)) != NULL) {
+            if(lv_indev_get_type(indev) == LV_INDEV_TYPE_POINTER)
+                break;
+        }
+        if(indev) break;
+        usleep(10000);
+    }
+
+    if(indev) {
+        lv_display_t * disp = lv_display_get_default();
+        int phys_w = lv_display_get_horizontal_resolution(disp);
+        int phys_h = lv_display_get_vertical_resolution(disp);
+
+        switch(set->rotation) {
+            case LV_DISPLAY_ROTATION_90:
+                /* swap-first: swapped_x=raw_y∈[0,phys_w-1], swapped_y=raw_x∈[0,phys_h-1] */
+                lv_evdev_set_swap_axes(indev, true);
+                lv_evdev_set_calibration(indev, 0, phys_h - 1, phys_w - 1, 0);
+                break;
+            case LV_DISPLAY_ROTATION_180:
+                /* no swap, both axes inverted */
+                lv_evdev_set_calibration(indev, phys_w - 1, phys_h - 1, 0, 0);
+                break;
+            case LV_DISPLAY_ROTATION_270:
+                lv_evdev_set_swap_axes(indev, true);
+                lv_evdev_set_calibration(indev, phys_w - 1, 0, 0, phys_h - 1);
+                break;
+            default:
+                break;
+        }
+        LV_LOG_INFO("Touch rotation set for %d deg", set->rotation * 90);
+    } else {
+        LV_LOG_WARN("Touch indev not found, rotation not set");
+    }
+
+    return 0;
+}
 
