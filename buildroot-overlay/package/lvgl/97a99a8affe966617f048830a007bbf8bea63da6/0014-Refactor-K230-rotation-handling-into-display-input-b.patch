 }
 
 
+/*
+ * Map raw touch coordinates to the rotated screen orientation
+ *
+ * @description the touch panel reports coordinates in its native
+ * orientation; when the display is rotated the axes must be swapped
+ * and re-scaled to match the rotated screen
+ * @param indev the touch input device
+ * @param disp the display the touch device is attached to
+ */
+static void k230_apply_touch_rotation(lv_indev_t * indev, lv_display_t * disp)
+{
+    lv_display_rotation_t rotation = settings.rotation;
+
+    if(rotation == LV_DISPLAY_ROTATION_0) {
+        return;
+    }
+
+    int32_t phys_w = lv_display_get_horizontal_resolution(disp);
+    int32_t phys_h = lv_display_get_vertical_resolution(disp);
+
+    switch(rotation) {
+        case LV_DISPLAY_ROTATION_90:
+            /* swap-first: swapped_x=raw_y∈[0,phys_w-1], swapped_y=raw_x∈[0,phys_h-1] */
+            lv_evdev_set_swap_axes(indev, true);
+            lv_evdev_set_calibration(indev, 0, phys_h - 1, phys_w - 1, 0);
+            break;
+        case LV_DISPLAY_ROTATION_180:
+            /* no swap, both axes inverted */
+            lv_evdev_set_calibration(indev, phys_w - 1, phys_h - 1, 0, 0);
+            break;
+        case LV_DISPLAY_ROTATION_270:
+            lv_evdev_set_swap_axes(indev, true);
+            lv_evdev_set_calibration(indev, phys_w - 1, 0, 0, phys_h - 1);
+            break;
+        default:
+            break;
+    }
+    LV_LOG_INFO("Touch rotation set for %d deg", rotation * 90);
+}
+
