     if(type == LV_EVDEV_TYPE_REL) {
         set_mouse_cursor_icon(indev, disp);
     }
+    else if(type == LV_EVDEV_TYPE_ABS) {
+        k230_apply_touch_rotation(indev, disp);
+    }
 }
 
