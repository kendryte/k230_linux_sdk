+
+CameraConfiguration::Status VvcamCameraConfiguration::validate()
+{
+	Status status = Valid;
+
+	if (config_.empty() || !sensor_)
+		return Invalid;
+
+	/*
+	 * outputSize is the sensor mode. bitDepth carries fps because
+	 * SensorConfiguration has no frame-rate field. It is not bit depth.
+	 * With no target, the daemon keeps mode 0 of this sensor.
+	 */
+	const SensorMode *active = &sensor_->modes[0];
+	if (sensorConfig) {
+		const Size &size = sensorConfig->outputSize;
+		const SensorMode *found = nullptr;
+		if (sensorConfig->isValid()) {
+			for (unsigned int i = 0; i < sensor_->count; i++) {
+				const SensorMode &mode = sensor_->modes[i];
+				if (mode.width == size.width &&
+				    mode.height == size.height &&
+				    mode.fps == sensorConfig->bitDepth) {
+					found = &mode;
+					break;
+				}
+			}
+		}
+		if (!found) {
+			LOG(VVCAM, Error)
+				<< sensor_->name << " has no sensor mode "
+				<< size << "@" << sensorConfig->bitDepth;
+			return Invalid;
+		}
+		active = found;
+	}
+
+	if (config_.size() > 1) {
+		config_.resize(1);
+		status = Adjusted;
+	}
+
+	StreamConfiguration &cfg = config_[0];
+	const std::vector<PixelFormat> &formats = supportedFormats();
+	if (std::find(formats.begin(), formats.end(), cfg.pixelFormat) == formats.end()) {
+		LOG(VVCAM, Debug)
+			<< "Adjust pixel format from " << cfg.pixelFormat
+			<< " to NV12";
+		cfg.pixelFormat = formats::NV12;
+		status = Adjusted;
+	}
+
+	const Size requested = cfg.size;
+	unsigned int width = alignUp(requested.width, 16);
+	unsigned int height = alignUp(requested.height, 8);
+
+	if (width > active->width)
+		width = active->width;
+	if (height > active->height)
+		height = active->height;
+	if (width < kMinWidth)
+		width = kMinWidth;
+	if (height < kMinHeight)
+		height = kMinHeight;
+
+	/*
+	 * Sensor flip is only HFLIP/VFLIP. 90-degree orientations need a
+	 * transpose, which this sensor path does not do.
+	 */
+	const Transform transform = orientation / Orientation::Rotate0;
+	if (!!(transform & Transform::Transpose)) {
+		orientation = Orientation::Rotate0;
+		status = Adjusted;
+		LOG(VVCAM, Info) << "Adjust orientation to Rotate0";
+	}
+
+	cfg.size = { width, height };
+	if (cfg.size != requested) {
+		LOG(VVCAM, Info)
+			<< "Adjust size from " << requested
+			<< " to " << cfg.size
+			<< " (align 16x8, clamp 32x16.."
+			<< active->width << "x" << active->height << ")";
+		status = Adjusted;
+	}
+
+	cfg.bufferCount = 4;
+
+	return status;
+}
+
+std::unique_ptr<CameraConfiguration>
+PipelineHandlerVvcam::generateConfiguration(Camera *camera,
+					    Span<const StreamRole> roles)
+{
+	VvcamCameraData *data = cameraData(camera);
+	std::unique_ptr<VvcamCameraConfiguration> config =
+		std::make_unique<VvcamCameraConfiguration>(data->sensor_);
+
+	if (roles.empty())
+		return config;
+
+	bool supported = false;
+	for (const StreamRole role : roles) {
+		if (role == StreamRole::Viewfinder || role == StreamRole::Raw)
+			supported = true;
+	}
+	if (!supported)
+		return config;
+
+	const SensorMode &deflt = data->sensor_->modes[0];
+	StreamConfiguration cfg(streamFormats(data->sensor_));
+	cfg.pixelFormat = formats::NV12;
+	cfg.size = { deflt.width, deflt.height };
+	cfg.bufferCount = 4;
+	config->addConfiguration(cfg);
+	config->validate();
+
+	LOG(VVCAM, Debug)
+		<< "Generated " << cfg.pixelFormat << " "
+		<< deflt.width << "x" << deflt.height
+		<< " for camera " << camera->id()
+		<< " node " << data->video_.deviceNode();
+
+	return config;
+}
+
+int PipelineHandlerVvcam::configure(Camera *camera, CameraConfiguration *config)
+{
+	VvcamCameraData *data = cameraData(camera);
+	StreamConfiguration &cfg = config->at(0);
+
+	V4L2DeviceFormat format;
+	format.fourcc = data->video_.toV4L2PixelFormat(cfg.pixelFormat);
+	format.size = cfg.size;
+
+	int ret;
+	if (config->sensorConfig) {
+		const SensorConfiguration &sensor = *config->sensorConfig;
+		/* sensor.bitDepth is fps. See validate(). */
+		ret = data->video_.setSensorTarget(1, sensor.outputSize.width,
+						   sensor.outputSize.height,
+						   sensor.bitDepth);
+		if (ret) {
+			LOG(VVCAM, Error)
+				<< "Failed to set sensor target: " << strerror(-ret);
+			return ret;
+		}
+		LOG(VVCAM, Info)
+			<< "Sensor mode " << sensor.outputSize
+			<< "@" << sensor.bitDepth;
+	} else {
+		ret = data->video_.setSensorTarget(0, 0, 0, 0);
+		if (ret) {
+			LOG(VVCAM, Error)
+				<< "Failed to clear sensor target: " << strerror(-ret);
+			return ret;
+		}
+	}
+
+	ret = data->video_.setFormat(&format);
+	if (ret)
+		return ret;
+
+	if (format.size != cfg.size ||
+	    format.fourcc != data->video_.toV4L2PixelFormat(cfg.pixelFormat)) {
+		LOG(VVCAM, Error)
+			<< "S_FMT returned " << format.size.width << "x"
+			<< format.size.height << " " << format.fourcc;
+		return -EINVAL;
+	}
+
+	cfg.stride = format.planes[0].bpl;
+	cfg.frameSize = format.planes[0].size;
+	cfg.setStream(&data->stream_);
+
+	/*
+	 * S_FMT has created the ISP pipeline, so QUERY_EXT_CTRL now reports
+	 * the sensor exposure range instead of the placeholder 1..1000000.
+	 */
+	data->video_.updateControlInfo();
+	const v4l2_query_ext_ctrl *exposure = data->video_.controlInfo(V4L2_CID_EXPOSURE);
+	if (!exposure) {
+		LOG(VVCAM, Error) << "Exposure control is not available";
+		return -EINVAL;
+	}
+
+	const int32_t exposureMin = static_cast<int32_t>(exposure->minimum);
+	const int32_t exposureMax = static_cast<int32_t>(exposure->maximum);
+	int32_t exposureDefault = static_cast<int32_t>(exposure->default_value);
+	if (exposure->minimum != exposureMin || exposure->maximum != exposureMax ||
+	    exposureMin > exposureMax) {
+		LOG(VVCAM, Error)
+			<< "Exposure range " << exposure->minimum
+			<< ".." << exposure->maximum << " does not fit ControlInfo";
+		return -ERANGE;
+	}
+	if (exposureDefault < exposureMin)
+		exposureDefault = exposureMin;
+	if (exposureDefault > exposureMax)
+		exposureDefault = exposureMax;
+
+	const v4l2_query_ext_ctrl *analogueGain = data->video_.controlInfo(V4L2_CID_ANALOGUE_GAIN);
+	if (!analogueGain) {
+		LOG(VVCAM, Error) << "Analogue gain control is not available";
+		return -EINVAL;
+	}
+	if (analogueGain->minimum > analogueGain->maximum || analogueGain->minimum < 0) {
+		LOG(VVCAM, Error)
+			<< "Analogue gain range " << analogueGain->minimum
+			<< ".." << analogueGain->maximum << " is not usable";
+		return -ERANGE;
+	}
+
+	/* Driver code is 1/1000 x. libcamera AnalogueGain is a multiplier. */
+	float gainMin = static_cast<float>(analogueGain->minimum) / 1000.0f;
+	float gainMax = static_cast<float>(analogueGain->maximum) / 1000.0f;
+	float gainDefault = static_cast<float>(analogueGain->default_value) / 1000.0f;
+	if (gainDefault < gainMin)
+		gainDefault = gainMin;
+	if (gainDefault > gainMax)
+		gainDefault = gainMax;
+
+	ControlInfoMap::Map ctrls;
+	for (const auto &[id, info] : data->controlInfo_)
+		ctrls.emplace(id, info);
+	ctrls[&controls::ExposureTime] =
+		ControlInfo(exposureMin, exposureMax, exposureDefault);
+	ctrls[&controls::AnalogueGain] =
+		ControlInfo(gainMin, gainMax, gainDefault);
+	data->controlInfo_ = ControlInfoMap(std::move(ctrls), controls::controls);
+
+	ret = data->ipa_->configure(data->video_.dupFd());
+	if (ret) {
+		LOG(VVCAM, Error) << "IPA configure failed: " << ret;
+		return ret;
+	}
+
+	const Transform transform = config->orientation / Orientation::Rotate0;
+	const bool hflip = (transform & Transform::HFlip) == Transform::HFlip;
+	const bool vflip = (transform & Transform::VFlip) == Transform::VFlip;
+	ret = data->ipa_->setFlip(hflip, vflip);
+	if (ret) {
+		LOG(VVCAM, Error) << "Failed to set flip: " << ret;
+		return ret;
+	}
+
+	return 0;
+}
+
+int PipelineHandlerVvcam::exportFrameBuffers(Camera *camera, Stream *stream,
+					     std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	VvcamCameraData *data = cameraData(camera);
+	unsigned int count = stream->configuration().bufferCount;
+
+	/*
+	 * One extra buffer stays queued for the life of the stream. The ISP
+	 * returns a buffer only after another is queued in its place, so the
+	 * last application buffer would otherwise never complete. MMAP, because
+	 * vvcam reports buffers to isp_media_server from REQBUFS/QBUF.
+	 */
+	std::vector<std::unique_ptr<FrameBuffer>> allocated;
+	int ret = data->video_.allocateBuffers(count + 1, &allocated);
+	if (ret < 0)
+		return ret;
+	if (allocated.size() != count + 1) {
+		data->video_.releaseBuffers();
+		return -ENOBUFS;
+	}
+
+	data->exported_.clear();
+	data->queuedSet_.clear();
+	data->fillers_.clear();
+	data->spare_ = std::move(allocated.back());
+	allocated.pop_back();
+	for (const std::unique_ptr<FrameBuffer> &buffer : allocated)
+		data->exported_.push_back(buffer.get());
+	buffers->swap(allocated);
+	data->spareQueued_ = false;
+	return count;
+}
+
+int PipelineHandlerVvcam::start(Camera *camera, const ControlList *)
+{
+	VvcamCameraData *data = cameraData(camera);
+	data->queued_ = 0;
+	data->frameSequence_ = 0;
+	data->spareQueued_ = false;
+	data->started_ = false;
+	data->stopping_ = false;
+	data->exposureSet_ = false;
+	data->awbSet_ = false;
+	data->brightSet_ = false;
+	data->contrastSet_ = false;
+	data->saturationSet_ = false;
+	data->exposureWritten_ = false;
+	data->exposureWrittenUs_ = 0;
+	data->gainWritten_ = false;
+	data->gainWrittenX_ = 0;
+	data->startPending_ = false;
+	data->startTimer_.stop();
+	data->queuedSet_.clear();
+	data->fillers_.clear();
+	return 0;
+}
+
+void PipelineHandlerVvcam::stopDevice(Camera *camera)
+{
+	VvcamCameraData *data = cameraData(camera);
+	data->stopping_ = true;
+	data->startPending_ = false;
+	data->startTimer_.stop();
+	data->video_.streamOff();
+	data->video_.releaseBuffers();
+	data->spare_.reset();
+	data->exported_.clear();
+	data->queuedSet_.clear();
+	data->fillers_.clear();
+	data->queued_ = 0;
+	data->frameSequence_ = 0;
+	data->spareQueued_ = false;
+	data->started_ = false;
+	data->stopping_ = false;
+	data->exposureWritten_ = false;
+	data->exposureWrittenUs_ = 0;
+	data->gainWritten_ = false;
+	data->gainWrittenX_ = 0;
+}
+
+int PipelineHandlerVvcam::queueRequestDevice(Camera *camera, Request *request)
+{
+	VvcamCameraData *data = cameraData(camera);
+	FrameBuffer *buffer = request->findBuffer(&data->stream_);
+	if (!buffer) {
+		LOG(VVCAM, Error) << "Request has no buffer for the vvcam stream";
+		return -ENOENT;
+	}
+
+	int ret = data->video_.queueBuffer(buffer);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * AE mode, exposure and gain are applied once, before STREAMON.
+	 * EXPOSURE_AUTO is written first. A later request that still carries
+	 * AeEnable is ignored so -EBUSY does not fail the frame.
+	 */
+	if (!data->started_ && !data->exposureSet_) {
+		auto ae = request->controls().get(controls::AeEnable);
+		auto exposure = request->controls().get(controls::ExposureTime);
+		auto gain = request->controls().get(controls::AnalogueGain);
+		if (ae || exposure || gain) {
+			ret = data->ipa_->setControls(ae.has_value(),
+						      ae.value_or(false),
+						      exposure.has_value(),
+						      exposure.value_or(0),
+						      gain.has_value(),
+						      gain.value_or(0.0f));
+			if (ret)
+				LOG(VVCAM, Error) << "Failed to set exposure controls: " << ret;
+			else {
+				data->exposureSet_ = true;
+				if (exposure) {
+					const ControlInfo &info =
+						data->controlInfo_.at(&controls::ExposureTime);
+					int32_t value = exposure.value();
+					const int32_t lo = info.min().get<int32_t>();
+					const int32_t hi = info.max().get<int32_t>();
+					if (value < lo)
+						value = lo;
+					if (value > hi)
+						value = hi;
+					data->exposureWritten_ = true;
+					data->exposureWrittenUs_ = value;
+				}
+				if (gain) {
+					const ControlInfo &info =
+						data->controlInfo_.at(&controls::AnalogueGain);
+					float value = gain.value();
+					const float lo = info.min().get<float>();
+					const float hi = info.max().get<float>();
+					if (value < lo)
+						value = lo;
+					if (value > hi)
+						value = hi;
+					data->gainWritten_ = true;
+					data->gainWrittenX_ = value;
+				}
+			}
+		}
+	}
+
+	if (!data->started_ && !data->awbSet_) {
+		const auto awb = request->controls().get(controls::AwbEnable);
+		if (awb) {
+			ret = data->video_.setAwbEnable(awb.value());
+			if (ret) {
+				LOG(VVCAM, Error)
+					<< "Failed to set AWB enable "
+					<< (awb.value() ? 1 : 0)
+					<< ": " << strerror(-ret);
+			} else {
+				data->awbSet_ = true;
+			}
+		}
+	}
+
+	if (!data->started_ && !data->brightSet_) {
+		const auto bright = request->controls().get(controls::Brightness);
+		if (bright) {
+			int value = static_cast<int>(std::lround(
+				static_cast<double>(bright.value()) * 128.0));
+			if (value < -128)
+				value = -128;
+			if (value > 127)
+				value = 127;
+
+			ret = data->video_.setCprocManual(VVCAM_CID_CPROC_MANU_BRIGHT, value);
+			if (ret)
+				LOG(VVCAM, Error)
+					<< "Failed to set brightness " << value
+					<< ": " << strerror(-ret);
+			else
+				data->brightSet_ = true;
+		}
+	}
+
+	if (!data->started_ && !data->contrastSet_) {
+		const auto contrast = request->controls().get(controls::Contrast);
+		if (contrast) {
+			int value = static_cast<int>(std::lround(
+				static_cast<double>(contrast.value()) * 128.0));
+			if (value < 0)
+				value = 0;
+			if (value > 255)
+				value = 255;
+
+			ret = data->video_.setCprocManual(VVCAM_CID_CPROC_MANU_CONTRAST, value);
+			if (ret)
+				LOG(VVCAM, Error)
+					<< "Failed to set contrast " << value
+					<< ": " << strerror(-ret);
+			else
+				data->contrastSet_ = true;
+		}
+	}
+
+	if (!data->started_ && !data->saturationSet_) {
+		const auto saturation = request->controls().get(controls::Saturation);
+		if (saturation) {
+			int value = static_cast<int>(std::lround(
+				static_cast<double>(saturation.value()) * 128.0));
+			if (value < 0)
+				value = 0;
+			if (value > 255)
+				value = 255;
+
+			ret = data->video_.setCprocManual(VVCAM_CID_CPROC_MANU_SATURATION, value);
+			if (ret)
+				LOG(VVCAM, Error)
+					<< "Failed to set saturation " << value
+					<< ": " << strerror(-ret);
+			else
+				data->saturationSet_ = true;
+		}
+	}
+
+	data->queuedSet_.insert(buffer);
+	data->fillers_.erase(buffer);
+	data->queued_++;
+	if (data->started_)
+		return 0;
+
+	/*
+	 * --capture=1 submits one request; --capture=5 submits the whole pool
+	 * in a burst. Restart a short timer on each request so STREAMON runs
+	 * after the burst, with any buffer the application did not submit
+	 * queued as a filler. The ISP faults if STREAMON sees an empty slot.
+	 */
+	data->startPending_ = true;
+	data->startTimer_.start(std::chrono::milliseconds(50));
+	return 0;
+}
+
+void VvcamCameraData::onStartTimeout()
+{
+	if (!startPending_)
+		return;
+	startPending_ = false;
+	tryStartStreaming();
+}
+
+void VvcamCameraData::failStart(const char *why, int ret)
+{
+	LOG(VVCAM, Error) << why << ": " << strerror(-ret);
+
+	/*
+	 * streamOff() emits bufferReady for every queued buffer. Hold those
+	 * requests here, then cancel them after the device queue is clear, so
+	 * the application is not left waiting for a frame that will not come.
+	 */
+	drained_.clear();
+	draining_ = true;
+	video_.streamOff();
+	draining_ = false;
+
+	std::set<Request *> requests(drained_.begin(), drained_.end());
+	if (requests.empty()) {
+		for (FrameBuffer *buffer : queuedSet_) {
+			if (Request *request = buffer->request())
+				requests.insert(request);
+		}
+	}
+	drained_.clear();
+	queuedSet_.clear();
+	fillers_.clear();
+	spareQueued_ = false;
+	queued_ = 0;
+	startPending_ = false;
+	started_ = false;
+
+	for (Request *request : requests)
+		pipe()->cancelRequest(request);
+}
+
+void VvcamCameraData::tryStartStreaming()
+{
+	if (started_ || stopping_)
+		return;
+
+	if (!spareQueued_) {
+		int ret = video_.queueBuffer(spare_.get());
+		if (ret < 0) {
+			failStart("Failed to queue spare buffer", ret);
+			return;
+		}
+		spareQueued_ = true;
+	}
+
+	for (FrameBuffer *exported : exported_) {
+		if (queuedSet_.count(exported))
+			continue;
+
+		int ret = video_.queueBuffer(exported);
+		if (ret < 0) {
+			failStart("Failed to queue filler buffer", ret);
+			return;
+		}
+		fillers_.insert(exported);
+	}
+
+	int ret = video_.streamOn();
+	if (ret < 0) {
+		failStart("Failed to start streaming", ret);
+		return;
+	}
+
+	started_ = true;
+	LOG(VVCAM, Info) << "STREAMON " << video_.deviceNode() << " ok";
+}
+
+bool PipelineHandlerVvcam::acquireDevice(Camera *camera)
+{
+	VvcamCameraData *data = cameraData(camera);
+	MutexLocker locker(data->openLock_);
+
+	return data->video_.open() == 0;
+}
+
+void PipelineHandlerVvcam::releaseDevice(Camera *camera)
+{
+	VvcamCameraData *data = cameraData(camera);
+	MutexLocker locker(data->openLock_);
+	data->video_.close();
+}
+
+bool PipelineHandlerVvcam::queryCapture(const std::string &node)
+{
+	UniqueFD fd(::open(node.c_str(), O_RDWR | O_CLOEXEC));
+	if (!fd.isValid()) {
+		LOG(VVCAM, Error)
+			<< "Failed to open " << node << ": "
+			<< strerror(errno);
+		return false;
+	}
+
+	v4l2_capability cap = {};
+	if (::ioctl(fd.get(), VIDIOC_QUERYCAP, &cap) < 0) {
+		LOG(VVCAM, Error)
+			<< "QUERYCAP failed on " << node << ": "
+			<< strerror(errno);
+		return false;
+	}
+
+	const uint32_t caps = (cap.capabilities & V4L2_CAP_DEVICE_CAPS) ?
+			      cap.device_caps : cap.capabilities;
+	const bool capture = caps & V4L2_CAP_VIDEO_CAPTURE;
+	const bool streaming = caps & V4L2_CAP_STREAMING;
+
+	LOG(VVCAM, Debug)
+		<< node << " QUERYCAP caps=0x" << std::hex << caps << std::dec
+		<< " capture=" << capture << " streaming=" << streaming;
+
+	return capture && streaming;
+}
+
+bool PipelineHandlerVvcam::match(DeviceEnumerator *enumerator)
+{
+	DeviceMatch dm("vvcam-video");
+	dm.add("vvcam-video.0.0");
+
+	std::shared_ptr<MediaDevice> media = acquireMediaDevice(enumerator, dm);
+	if (!media)
+		return false;
+
+	if (media->model() != "verisilicon_media") {
+		LOG(VVCAM, Debug)
+			<< "Skip " << media->deviceNode()
+			<< " model " << media->model();
+		return false;
+	}
+
+	std::vector<MediaEntity *> videos;
+	for (MediaEntity *candidate : media->entities()) {
+		const std::string &name = candidate->name();
+		if (name.starts_with("vvcam-video.") &&
+		    !candidate->deviceNode().empty())
+			videos.push_back(candidate);
+	}
+	std::sort(videos.begin(), videos.end(),
+		  [](const MediaEntity *a, const MediaEntity *b) {
+			  return a->name() < b->name();
+		  });
+
+	unsigned int registered = 0;
+	for (MediaEntity *entity : videos) {
+		if (registerCapture(entity))
+			registered++;
+	}
+
+	if (!registered) {
+		LOG(VVCAM, Error) << "No vvcam capture node on " << media->deviceNode();
+		return false;
+	}
+
+	LOG(VVCAM, Info)
+		<< "Registered " << registered << " camera"
+		<< (registered == 1 ? "" : "s")
+		<< " from " << media->deviceNode();
+	return true;
+}
+
+bool PipelineHandlerVvcam::registerCapture(MediaEntity *entity)
+{
+	const std::string &node = entity->deviceNode();
+	if (!queryCapture(node))
+		return false;
+
+	const int port = ispPort(entity);
+	if (port < 0) {
+		LOG(VVCAM, Error) << "No ISP link for " << entity->name();
+		return false;
+	}
+
+	const std::string sensorName = sensorNameOnPort(port);
+	const SensorSupport *sensor = findSensor(sensorName);
+	if (!sensor) {
+		LOG(VVCAM, Error)
+			<< entity->name() << " port " << port
+			<< " sensor '" << sensorName
+			<< "' is not in kSensors. Add its modes next to the other sensors in vvcam.cpp";
+		return false;
+	}
+
+	std::unique_ptr<VvcamCameraData> data =
+		std::make_unique<VvcamCameraData>(this, node);
+	data->sensor_ = sensor;
+	data->properties_.set(properties::Model, std::string(sensor->name));
+	data->properties_.set(properties::PixelArraySize, largestMode(sensor));
+
+	data->ipa_ = createIPA<ipa::vvcam::IPAProxyVvcam>(0, 0);
+	if (!data->ipa_) {
+		LOG(VVCAM, Error) << "No IPA found for " << entity->name();
+		return false;
+	}
+
+	const int ret = data->ipa_->init(IPASettings{ "", "vvcam" });
+	if (ret) {
+		LOG(VVCAM, Error) << "IPA init failed for " << entity->name()
+				  << ": " << ret;
+		return false;
+	}
+
+	ControlInfoMap::Map ctrls;
+	ctrls.emplace(&controls::AeEnable, ControlInfo(false, true, true));
+	ctrls.emplace(&controls::AwbEnable, ControlInfo(false, true, true));
+	ctrls.emplace(&controls::Brightness, ControlInfo(-1.0f, 1.0f, 0.0f));
+	ctrls.emplace(&controls::Contrast,
+		      ControlInfo(0.0f, 255.0f / 128.0f, 1.0f));
+	ctrls.emplace(&controls::Saturation,
+		      ControlInfo(0.0f, 255.0f / 128.0f, 1.0f));
+	ctrls.emplace(&controls::ExposureTime,
+		      ControlInfo{ { int32_t{ 1 } },
+				   { int32_t{ 1000000 } },
+				   { int32_t{ 10000 } } });
+	ctrls.emplace(&controls::AnalogueGain,
+		      ControlInfo{ { 1.0f }, { 256.0f }, { 1.0f } });
+	data->controlInfo_ = ControlInfoMap(std::move(ctrls), controls::controls);
+
+	const std::string &id = entity->name();
+	std::set<Stream *> streams{ &data->stream_ };
+	std::shared_ptr<Camera> camera =
+		Camera::create(std::move(data), id, streams);
+	registerCamera(std::move(camera));
+
+	LOG(VVCAM, Info) << "Registered " << id << " on " << node
+			 << " sensor " << sensor->name;
+	return true;
+}
+
+void VvcamCameraData::imageBufferReady(FrameBuffer *buffer)
+{
+	if (draining_) {
+		if (buffer != spare_.get() && !fillers_.count(buffer)) {
+			if (Request *request = buffer->request())
+				drained_.push_back(request);
+		}
+		return;
+	}
+
+	if (buffer == spare_.get() || fillers_.count(buffer)) {
+		if (stopping_)
+			return;
+		int ret = video_.queueBuffer(buffer);
+		if (ret < 0 && ret != -ESHUTDOWN)
+			LOG(VVCAM, Error) << "Failed to requeue spare buffer";
+		return;
+	}
+
+	Request *request = buffer->request();
+	if (!request)
+		return;
+
+	/*
+	 * The video node leaves v4l2_buffer.sequence and timestamp at 0.
+	 * Stamp monotonic time here and keep our own frame count so each
+	 * captured file is distinct.
+	 */
+	FrameMetadata &meta = buffer->_d()->metadata();
+	if (!meta.timestamp) {
+		struct timespec ts;
+		if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) {
+			meta.timestamp = static_cast<uint64_t>(ts.tv_sec) * 1000000000ULL +
+					 static_cast<uint64_t>(ts.tv_nsec);
+		}
+	}
+	if (meta.sequence == 0 && frameSequence_ > 0)
+		meta.sequence = frameSequence_;
+	frameSequence_ = meta.sequence + 1;
+
+	request->_d()->metadata().set(controls::SensorTimestamp, meta.timestamp);
+
+	int32_t exposureUs = 0;
+	int32_t gainMilli = 0;
+	bool haveExposure = exposureWritten_;
+	bool haveGain = gainWritten_;
+	if (haveExposure)
+		exposureUs = exposureWrittenUs_;
+	if (!haveExposure || !haveGain) {
+		int32_t readUs = 0;
+		int32_t readMilli = 0;
+		int readRet = video_.readExposureGain(&readUs, &readMilli);
+		if (readRet) {
+			LOG(VVCAM, Error)
+				<< "Failed to read exposure metadata: " << strerror(-readRet);
+		} else {
+			if (!haveExposure) {
+				exposureUs = readUs;
+				haveExposure = true;
+			}
+			if (!haveGain) {
+				gainMilli = readMilli;
+				haveGain = true;
+			}
+		}
+	}
+	if (haveGain && gainWritten_)
+		request->_d()->metadata().set(controls::AnalogueGain, gainWrittenX_);
+	else if (haveGain)
+		request->_d()->metadata().set(controls::AnalogueGain,
+					       static_cast<float>(gainMilli) / 1000.0f);
+	if (haveExposure)
+		request->_d()->metadata().set(controls::ExposureTime, exposureUs);
+
+	pipe()->completeBuffer(request, buffer);
+	pipe()->completeRequest(request);
+}
+
+REGISTER_PIPELINE_HANDLER(PipelineHandlerVvcam, "vvcam")
+
+} /* namespace libcamera */
