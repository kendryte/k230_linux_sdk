+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+/*
+ * \todo Document the interface and remove the related EXCLUDE_PATTERNS entry.
+ */
+
+module ipa.vvcam;
+
+import "include/libcamera/ipa/core.mojom";
+
+interface IPAVvcamInterface {
+	init(libcamera.IPASettings settings) => (int32 ret);
+
+	configure(libcamera.SharedFD videoFd) => (int32 ret);
+
+	start() => (int32 ret);
+	stop();
+
+	setControls(bool hasAe, bool aeEnable,
+		   bool hasExposure, int32 exposureTime,
+		   bool hasGain, float analogueGain) => (int32 ret);
+
+	setFlip(bool hflip, bool vflip) => (int32 ret);
+
+	[async] process(uint32 frame);
+};
+
+interface IPAVvcamEventInterface {
+	ready();
+};
