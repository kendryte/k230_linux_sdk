diff -Naur libcamera-v0.7.2/src/ipa/vvcam/vvcam.cpp libcamera-v0.7.2-vvcam/src/ipa/vvcam/vvcam.cpp
--- libcamera-v0.7.2/src/ipa/vvcam/vvcam.cpp	1970-01-01 08:00:00.000000000 +0800
+++ libcamera-v0.7.2-vvcam/src/ipa/vvcam/vvcam.cpp	2026-10-29 16:54:32.366031186 +0800
@@ -0,0 +1,239 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * VVCAM IPA. 3A stays in isp_media_server. This module only maps controls.
+ */
+
+#include <libcamera/ipa/vvcam_ipa_interface.h>
+
+#include <cerrno>
+#include <cmath>
+#include <cstring>
+#include <sys/ioctl.h>
+#include <vector>
+
+#include <linux/videodev2.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/ipa/ipa_interface.h>
+#include <libcamera/ipa/ipa_module_info.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPAVVCAM)
+
+class IPAVvcam : public ipa::vvcam::IPAVvcamInterface
+{
+public:
+	int32_t init(const IPASettings &settings) override;
+	int32_t configure(const SharedFD &videoFd) override;
+	int32_t start() override;
+	void stop() override;
+	int32_t setControls(bool hasAe, bool aeEnable,
+			    bool hasExposure, int32_t exposureTime,
+			    bool hasGain, float analogueGain) override;
+	int32_t setFlip(bool hflip, bool vflip) override;
+	void process(uint32_t frame) override;
+
+private:
+	int queryRange(uint32_t id, v4l2_query_ext_ctrl *query) const;
+	static int64_t clampTo(int64_t value, const v4l2_query_ext_ctrl &query);
+
+	SharedFD videoFd_;
+};
+
+int32_t IPAVvcam::init([[maybe_unused]] const IPASettings &settings)
+{
+	return 0;
+}
+
+int32_t IPAVvcam::configure(const SharedFD &videoFd)
+{
+	videoFd_ = videoFd;
+	return videoFd_.isValid() ? 0 : -EBADF;
+}
+
+int32_t IPAVvcam::queryRange(uint32_t id, v4l2_query_ext_ctrl *query) const
+{
+	*query = {};
+	query->id = id;
+	if (ioctl(videoFd_.get(), VIDIOC_QUERY_EXT_CTRL, query) < 0)
+		return -errno;
+	return 0;
+}
+
+int64_t IPAVvcam::clampTo(int64_t value, const v4l2_query_ext_ctrl &query)
+{
+	if (value < query.minimum)
+		return query.minimum;
+	if (value > query.maximum)
+		return query.maximum;
+	return value;
+}
+
+int32_t IPAVvcam::setControls(bool hasAe, bool aeEnable,
+			      bool hasExposure, int32_t exposureTime,
+			      bool hasGain, float analogueGain)
+{
+	if (!videoFd_.isValid())
+		return -EBADF;
+	if (!hasAe && !hasExposure && !hasGain)
+		return 0;
+
+	/*
+	 * AE mode must be written before exposure and gain, and only while
+	 * the port is not streaming. Manual is 1, auto is 0.
+	 */
+	if (hasAe) {
+		const int32_t mode = aeEnable ? V4L2_EXPOSURE_AUTO
+					      : V4L2_EXPOSURE_MANUAL;
+
+		v4l2_ext_control ctrl{};
+		ctrl.id = V4L2_CID_EXPOSURE_AUTO;
+		ctrl.value = mode;
+
+		v4l2_ext_controls ext{};
+		ext.which = V4L2_CTRL_WHICH_CUR_VAL;
+		ext.count = 1;
+		ext.controls = &ctrl;
+
+		if (ioctl(videoFd_.get(), VIDIOC_S_EXT_CTRLS, &ext) < 0) {
+			int err = -errno;
+			LOG(IPAVVCAM, Error)
+				<< "Failed to set exposure mode " << mode
+				<< ": " << strerror(-err);
+			return err;
+		}
+	}
+
+	std::vector<v4l2_ext_control> ctrls;
+	int64_t exposureWritten = 0;
+	int64_t exposureMin = 0;
+	int64_t exposureMax = 0;
+	double gainWritten = 0;
+	double gainMin = 0;
+	double gainMax = 0;
+
+	if (hasExposure) {
+		v4l2_query_ext_ctrl query;
+		int ret = queryRange(V4L2_CID_EXPOSURE, &query);
+		if (ret) {
+			LOG(IPAVVCAM, Error) << "QUERY_EXT_CTRL exposure failed: " << ret;
+			return ret;
+		}
+
+		exposureWritten = clampTo(exposureTime, query);
+		exposureMin = query.minimum;
+		exposureMax = query.maximum;
+
+		v4l2_ext_control ctrl{};
+		ctrl.id = V4L2_CID_EXPOSURE;
+		ctrl.value = static_cast<int32_t>(exposureWritten);
+		ctrls.push_back(ctrl);
+	}
+
+	if (hasGain) {
+		v4l2_query_ext_ctrl query;
+		int ret = queryRange(V4L2_CID_ANALOGUE_GAIN, &query);
+		if (ret) {
+			LOG(IPAVVCAM, Error) << "QUERY_EXT_CTRL analogue gain failed: " << ret;
+			return ret;
+		}
+
+		int64_t code = std::lround(static_cast<double>(analogueGain) * 1000.0);
+		int64_t written = clampTo(code, query);
+		gainWritten = written / 1000.0;
+		gainMin = query.minimum / 1000.0;
+		gainMax = query.maximum / 1000.0;
+
+		v4l2_ext_control ctrl{};
+		ctrl.id = V4L2_CID_ANALOGUE_GAIN;
+		ctrl.value = static_cast<int32_t>(written);
+		ctrls.push_back(ctrl);
+	}
+
+	if (ctrls.empty())
+		return 0;
+
+	v4l2_ext_controls ext{};
+	ext.which = V4L2_CTRL_WHICH_CUR_VAL;
+	ext.count = ctrls.size();
+	ext.controls = ctrls.data();
+
+	if (ioctl(videoFd_.get(), VIDIOC_S_EXT_CTRLS, &ext) < 0) {
+		int err = -errno;
+		LOG(IPAVVCAM, Error)
+			<< "Failed to set exposure or gain: " << strerror(-err);
+		return err;
+	}
+
+	if (hasExposure)
+		LOG(IPAVVCAM, Info)
+			<< "Exposure " << exposureWritten << " us"
+			<< " (range " << exposureMin << ".." << exposureMax << ")";
+	if (hasGain)
+		LOG(IPAVVCAM, Info)
+			<< "Analogue gain " << gainWritten
+			<< " x (range " << gainMin << ".." << gainMax << ")";
+
+	return 0;
+}
+
+int32_t IPAVvcam::setFlip(bool hflip, bool vflip)
+{
+	if (!videoFd_.isValid())
+		return -EBADF;
+
+	const struct {
+		uint32_t id;
+		const char *name;
+		int32_t value;
+	} ctrls[] = {
+		{ V4L2_CID_HFLIP, "HFLIP", hflip ? 1 : 0 },
+		{ V4L2_CID_VFLIP, "VFLIP", vflip ? 1 : 0 },
+	};
+
+	for (const auto &ctrl : ctrls) {
+		v4l2_control control{};
+		control.id = ctrl.id;
+		control.value = ctrl.value;
+		if (ioctl(videoFd_.get(), VIDIOC_S_CTRL, &control) < 0) {
+			int err = -errno;
+			LOG(IPAVVCAM, Error)
+				<< "Failed to set " << ctrl.name << " " << ctrl.value
+				<< ": " << strerror(-err);
+			return err;
+		}
+	}
+
+	return 0;
+}
+
+int32_t IPAVvcam::start()
+{
+	return 0;
+}
+
+void IPAVvcam::stop()
+{
+}
+
+void IPAVvcam::process([[maybe_unused]] uint32_t frame)
+{
+}
+
+extern "C" {
+const struct IPAModuleInfo ipaModuleInfo = {
+	IPA_MODULE_API_VERSION,
+	0,
+	"vvcam",
+	"vvcam",
+};
+
+IPAInterface *ipaCreate()
+{
+	return new IPAVvcam();
+}
+}
+
+} /* namespace libcamera */
diff -Naur libcamera-v0.7.2/src/libcamera/pipeline/vvcam/meson.build libcamera-v0.7.2-vvcam/src/libcamera/pipeline/vvcam/meson.build
