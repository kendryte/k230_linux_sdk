diff -Naur libcamera-v0.7.2/src/libcamera/pipeline/vvcam/vvcam.cpp libcamera-v0.7.2-vvcam/src/libcamera/pipeline/vvcam/vvcam.cpp
--- libcamera-v0.7.2/src/libcamera/pipeline/vvcam/vvcam.cpp	1970-01-01 08:00:00.000000000 +0800
+++ libcamera-v0.7.2-vvcam/src/libcamera/pipeline/vvcam/vvcam.cpp	2026-11-05 17:20:00.000000000 +0800
@@ -0,0 +1,1232 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Pipeline handler for VeriSilicon vvcam on K230.
+ *
+ * match() registers every vvcam-video capture node on the media device.
+ * The /dev/video number is assigned by the kernel and is not the port index.
+ * Format and buffer ioctls, which ask isp_media_server to create an ISP
+ * pipeline, happen after acquire().
+ */
+
+#include <algorithm>
+#include <cctype>
+#include <cerrno>
+#include <cmath>
+#include <cstdio>
+#include <fcntl.h>
+#include <fstream>
+#include <iomanip>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <linux/videodev2.h>
+
+#include "vvcam_cid.h"
+
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/mutex.h>
+#include <libcamera/base/shared_fd.h>
+#include <libcamera/base/timer.h>
+#include <libcamera/base/unique_fd.h>
+
+#include <libcamera/ipa/vvcam_ipa_interface.h>
+#include <libcamera/ipa/vvcam_ipa_proxy.h>
+
+#include <libcamera/camera.h>
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+#include <libcamera/formats.h>
+#include <libcamera/framebuffer.h>
+#include <libcamera/orientation.h>
+#include <libcamera/property_ids.h>
+#include <libcamera/request.h>
+#include <libcamera/stream.h>
+#include <libcamera/transform.h>
+
+#include "libcamera/internal/camera.h"
+#include "libcamera/internal/device_enumerator.h"
+#include "libcamera/internal/framebuffer.h"
+#include "libcamera/internal/media_device.h"
+#include "libcamera/internal/pipeline_handler.h"
+#include "libcamera/internal/request.h"
+#include "libcamera/internal/v4l2_videodevice.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(VVCAM)
+
+class VvcamVideoDevice : public V4L2VideoDevice
+{
+public:
+	using V4L2VideoDevice::V4L2VideoDevice;
+
+	SharedFD dupFd() const
+	{
+		return SharedFD(dup(fd()));
+	}
+
+	/*
+	 * Stored on the video node and attached to the next CREATE.
+	 * enable=0 clears a target left by an earlier open.
+	 * SensorConfiguration has no frame-rate field. bitDepth carries fps
+	 * here and is not the sensor bit depth. A real bit depth does not
+	 * match a mode and validate() rejects it.
+	 */
+	int setSensorTarget(uint32_t enable, uint32_t width, uint32_t height,
+			    uint32_t fps)
+	{
+		v4l2_ext_control ctrl[4] = {};
+		v4l2_ext_controls ctrls = {};
+
+		ctrl[0].id = VVCAM_CID_SENSOR_ENABLE;
+		ctrl[0].value = static_cast<int32_t>(enable);
+		ctrl[1].id = VVCAM_CID_SENSOR_WIDTH;
+		ctrl[1].value = static_cast<int32_t>(width);
+		ctrl[2].id = VVCAM_CID_SENSOR_HEIGHT;
+		ctrl[2].value = static_cast<int32_t>(height);
+		ctrl[3].id = VVCAM_CID_SENSOR_FPS;
+		ctrl[3].value = static_cast<int32_t>(fps);
+
+		ctrls.ctrl_class = V4L2_CTRL_CLASS_USER;
+		ctrls.count = 4;
+		ctrls.controls = ctrl;
+
+		if (::ioctl(fd(), VIDIOC_S_EXT_CTRLS, &ctrls) < 0)
+			return -errno;
+		return 0;
+	}
+
+	/*
+	 * isp_awb_enable lives on the ISP subdev. VIDIOC_S_CTRL on this video
+	 * node is forwarded there with the pad linked to this node.
+	 * VVCAM_CID_AWB_ENABLE, not the scene/sensor user-class block.
+	 */
+	int setAwbEnable(bool enable)
+	{
+		v4l2_control ctrl = {};
+		ctrl.id = VVCAM_CID_AWB_ENABLE;
+		ctrl.value = enable ? 1 : 0;
+		if (::ioctl(fd(), VIDIOC_S_CTRL, &ctrl) < 0)
+			return -errno;
+		return 0;
+	}
+
+	/* Integer control on the ISP subdev pad linked to this video node. */
+	int setIspCtrl(uint32_t id, int32_t value)
+	{
+		v4l2_control ctrl = {};
+		ctrl.id = id;
+		ctrl.value = value;
+		if (::ioctl(fd(), VIDIOC_S_CTRL, &ctrl) < 0)
+			return -errno;
+		return 0;
+	}
+
+	/* Manual cproc: enable, mode 0, then the brightness/contrast/saturation id. */
+	int setCprocManual(uint32_t id, int32_t value)
+	{
+		int ret = setIspCtrl(VVCAM_CID_CPROC_ENABLE, 1);
+		if (!ret)
+			ret = setIspCtrl(VVCAM_CID_CPROC_MODE, 0);
+		if (!ret)
+			ret = setIspCtrl(id, value);
+		return ret;
+	}
+
+	/* Exposure is microseconds. Gain is the driver code, 1000 = 1.0x. */
+	int readExposureGain(int32_t *exposureUs, int32_t *gainMilli)
+	{
+		v4l2_ext_control ctrl[2] = {};
+		v4l2_ext_controls ctrls = {};
+
+		ctrl[0].id = V4L2_CID_EXPOSURE;
+		ctrl[1].id = V4L2_CID_ANALOGUE_GAIN;
+		ctrls.which = V4L2_CTRL_WHICH_CUR_VAL;
+		ctrls.count = 2;
+		ctrls.controls = ctrl;
+
+		if (::ioctl(fd(), VIDIOC_G_EXT_CTRLS, &ctrls) < 0)
+			return -errno;
+		*exposureUs = ctrl[0].value;
+		*gainMilli = ctrl[1].value;
+		return 0;
+	}
+};
+
+/*
+ * Supported sensor modes. Add a sensor here when package/vvcam/src/<name>.c
+ * gains one. width/height/fps must match that file's modes[] and
+ * ae_info.cur_fps. If the driver lists the same WxH@fps twice for different
+ * mclks, keep one row: -S cannot select between them, and the daemon uses
+ * the first match.
+ *
+ * The name is the string in /proc/vsi/isp_subdev* ("sensor   : <name>"),
+ * which is also vvcam_sensor.name. This table is read at match(), before
+ * any format ioctl, so it does not create an ISP pipeline.
+ */
+struct SensorMode {
+	unsigned int width;
+	unsigned int height;
+	unsigned int fps;
+};
+
+struct SensorSupport {
+	const char *name;
+	const SensorMode *modes;
+	unsigned int count;
+};
+
+static constexpr SensorMode kGc2093Modes[] = {
+	{ 1920, 1080, 30 },
+	{ 1920, 1080, 60 },
+	{ 1280, 960, 90 },
+	{ 1280, 720, 90 },
+	{ 1920, 1080, 15 },
+};
+
+static constexpr SensorMode kGc2053Modes[] = {
+	{ 1920, 1080, 30 },
+	{ 1280, 960, 50 },
+	{ 1280, 720, 60 },
+};
+
+static constexpr SensorMode kOv5647Modes[] = {
+	{ 1920, 1080, 30 },
+	{ 2592, 1944, 10 },
+	{ 1280, 960, 45 },
+	{ 1280, 720, 60 },
+	{ 640, 480, 90 },
+};
+
+static constexpr SensorMode kOv13850Modes[] = {
+	{ 3840, 2160, 7 },
+};
+
+static constexpr SensorMode kImx335Modes[] = {
+	{ 1920, 1080, 30 },
+	{ 2592, 1944, 30 },
+};
+
+static constexpr SensorMode kBf3238Modes[] = {
+	{ 1920, 1080, 30 },
+	{ 1280, 960, 30 },
+};
+
+static constexpr SensorSupport kSensors[] = {
+	{ "gc2093", kGc2093Modes, std::size(kGc2093Modes) },
+	{ "gc2053", kGc2053Modes, std::size(kGc2053Modes) },
+	{ "ov5647", kOv5647Modes, std::size(kOv5647Modes) },
+	{ "ov13850", kOv13850Modes, std::size(kOv13850Modes) },
+	{ "imx335", kImx335Modes, std::size(kImx335Modes) },
+	{ "bf3238", kBf3238Modes, std::size(kBf3238Modes) },
+};
+
+static constexpr unsigned int kMinWidth = 32;
+static constexpr unsigned int kMinHeight = 16;
+/* ISP source pads per port. Same value as VVCAM_ISP_PORT_PAD_NR. */
+static constexpr unsigned int kPadsPerPort = 5;
+
+static unsigned int alignUp(unsigned int value, unsigned int align)
+{
+	return (value + align - 1) / align * align;
+}
+
+static const SensorSupport *findSensor(const std::string &name)
+{
+	for (const SensorSupport &sensor : kSensors) {
+		if (name == sensor.name)
+			return &sensor;
+	}
+	return nullptr;
+}
+
+static Size largestMode(const SensorSupport *sensor)
+{
+	Size size{ sensor->modes[0].width, sensor->modes[0].height };
+
+	for (unsigned int i = 1; i < sensor->count; i++) {
+		size.width = std::max(size.width, sensor->modes[i].width);
+		size.height = std::max(size.height, sensor->modes[i].height);
+	}
+	return size;
+}
+
+static const std::vector<PixelFormat> &supportedFormats()
+{
+	static const std::vector<PixelFormat> formats = {
+		formats::NV12,
+		formats::NV16,
+		formats::YUYV,
+		formats::BGR888,
+	};
+
+	return formats;
+}
+
+static StreamFormats streamFormats(const SensorSupport *sensor)
+{
+	std::map<PixelFormat, std::vector<SizeRange>> map;
+	const Size maxSize = largestMode(sensor);
+	const SizeRange range({ kMinWidth, kMinHeight }, maxSize);
+
+	for (const PixelFormat &format : supportedFormats())
+		map[format] = { range };
+
+	return StreamFormats(map);
+}
+
+/* Video node -> ISP port, from the media link. Does not touch format ioctls. */
+static int ispPort(MediaEntity *video)
+{
+	for (MediaPad *pad : video->pads()) {
+		for (MediaLink *link : pad->links()) {
+			MediaPad *remote = link->source()->entity() == video
+						   ? link->sink()
+						   : link->source();
+			if (remote->entity()->name().find("vvcam-isp") == std::string::npos)
+				continue;
+			return remote->index() / kPadsPerPort;
+		}
+	}
+	return -1;
+}
+
+/* Sensor name published by the kernel before any ISP pipeline exists. */
+static std::string sensorNameOnPort(unsigned int port)
+{
+	for (unsigned int id = 0; id < 4; id++) {
+		std::ifstream in("/proc/vsi/isp_subdev" + std::to_string(id));
+		if (!in)
+			continue;
+
+		std::string line;
+		int current = -1;
+		while (std::getline(in, line)) {
+			unsigned int parsed = 0;
+			if (std::sscanf(line.c_str(), "isp%*u port%u", &parsed) == 1) {
+				current = static_cast<int>(parsed);
+				continue;
+			}
+			if (current != static_cast<int>(port) ||
+			    line.compare(0, 6, "sensor") != 0)
+				continue;
+
+			const auto colon = line.find(':');
+			if (colon == std::string::npos)
+				return {};
+
+			std::string name = line.substr(colon + 1);
+			while (!name.empty() &&
+			       std::isspace(static_cast<unsigned char>(name.front())))
+				name.erase(name.begin());
+			while (!name.empty() &&
+			       std::isspace(static_cast<unsigned char>(name.back())))
+				name.pop_back();
+			return name;
+		}
+	}
+	return {};
+}
