diff --git a/include/linux/soc/canaan/k230-dma-addr.h b/include/linux/soc/canaan/k230-dma-addr.h
new file mode 100755
index 000000000..576221ee7
--- /dev/null
+++ b/include/linux/soc/canaan/k230-dma-addr.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (C) 2026, Canaan Bright Sight Co., Ltd
+ *
+ * K230 DMA address validation helpers.
+ * K230 DMA engines are 32-bit and can only address specific physical
+ * memory ranges. These helpers ensure DMA addresses fall within the
+ * valid regions before being programmed into hardware registers.
+ */
+
+#ifndef __LINUX_SOC_CANAAN_K230_DMA_ADDR_H__
+#define __LINUX_SOC_CANAAN_K230_DMA_ADDR_H__
+
+#include <linux/types.h>
+#include <linux/bitops.h>
+
+/*
+ * K230 physical memory layout:
+ *   0x00000000 - 0x7FFFFFFF : DDR (up to 2GB)
+ *   0x80000000 - 0x807FFFFF : KPU shared memory (AI work buffers)
+ *   0x80400000+             : AI device registers (GNNE, AI2D, GDMA, PDMA)
+ *   0x90000000+             : Peripheral registers (ISP, VPU, USB, SDHCI, OTP)
+ *
+ * DMA engines must only access DDR or KPU shared memory.
+ * Accessing device register space via DMA is a security risk.
+ */
+#define K230_DDR_PHYS_START	0x00000000UL
+#define K230_DDR_PHYS_END	0x80000000UL
+#define K230_KPU_PHYS_END	0x80800000UL
+
+/**
+ * k230_dma_addr_in_ddr - Check if DMA address falls within DDR only
+ * @addr: DMA physical address
+ * @size: Transfer size in bytes
+ *
+ * Use this for PDMA, SDHCI, USB and other peripheral DMA engines
+ * that should only access DDR memory.
+ *
+ * Return: true if [addr, addr+size) is within DDR and fits 32-bit
+ */
+static inline bool k230_dma_addr_in_ddr(dma_addr_t addr, size_t size)
+{
+	if ((size == 0) && (addr == 0))
+		return true;
+	/* Overflow check */
+	if (addr + size < addr)
+		return false;
+	/* K230 DMA engines are 32-bit */
+	if (upper_32_bits(addr) || upper_32_bits(addr + size - 1))
+		return false;
+	return addr >= K230_DDR_PHYS_START && addr + size <= K230_DDR_PHYS_END;
+}
+
+/**
+ * k230_dma_addr_in_ddr_kpu - Check if DMA address falls within DDR + KPU
+ * @addr: DMA physical address
+ * @size: Transfer size in bytes
+ *
+ * Use this for AI2D, GDMA and other AI DMA engines that may need
+ * to access both DDR and KPU shared memory regions.
+ *
+ * Return: true if [addr, addr+size) is within DDR+KPU and fits 32-bit
+ */
+static inline bool k230_dma_addr_in_ddr_kpu(dma_addr_t addr, size_t size)
+{
+	if ((size == 0) && (addr == 0))
+		return true;
+	/* Overflow check */
+	if (addr + size < addr)
+		return false;
+	/* K230 DMA engines are 32-bit */
+	if (upper_32_bits(addr) || upper_32_bits(addr + size - 1))
+		return false;
+	return addr >= K230_DDR_PHYS_START && addr + size <= K230_KPU_PHYS_END;
+}
+
+#endif /* __LINUX_SOC_CANAAN_K230_DMA_ADDR_H__ */
