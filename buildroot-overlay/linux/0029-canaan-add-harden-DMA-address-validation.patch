diff --git a/drivers/dma/k230_peridma.c b/drivers/dma/k230_peridma.c
old mode 100644
new mode 100755
index 227d5ba7c..8fc981bd4
--- a/drivers/dma/k230_peridma.c
+++ b/drivers/dma/k230_peridma.c
@@ -23,6 +23,7 @@
 #include <linux/spinlock.h>
 #include <linux/delay.h>
 #include <linux/dma-mapping.h>
+#include <linux/soc/canaan/k230-dma-addr.h>
 
 #include "virt-dma.h"
 
@@ -484,6 +485,20 @@ generate_hwdesc(struct k230_peridma_vchan *vchan, dma_addr_t src,
 	hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_priority = vchan->priority;
 	hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_dev_tout = vchan->dev_tout;
 
+	/* Validate DMA addresses are within DDR range */
+	if (!k230_dma_addr_in_ddr(src, len)) {
+		dev_err(vchan2dev(vchan),
+			"pdma: src DMA addr 0x%pad len 0x%zx out of DDR range [0x%lx-0x%lx]\n",
+			&src, len, K230_DDR_PHYS_START, K230_DDR_PHYS_END);
+		goto err_exit;
+	}
+	if (!k230_dma_addr_in_ddr(dest, len)) {
+		dev_err(vchan2dev(vchan),
+			"pdma: dst DMA addr 0x%pad len 0x%zx out of DDR range [0x%lx-0x%lx]\n",
+			&dest, len, K230_DDR_PHYS_START, K230_DDR_PHYS_END);
+		goto err_exit;
+	}
+
 	hwdesc->usr_pdma_chn_cfg.src_addr = src;
 	hwdesc->usr_pdma_chn_cfg.dst_addr = dest;
 	hwdesc->usr_pdma_chn_cfg.device = vchan->dev_sel;
@@ -790,6 +805,16 @@ static u32 *pdma_llt_cal(struct device *dev, struct k230_peridma_hwdesc *hwdesc,
 	u32 list_num;
 	struct pdma_llt_t *llt_list;
 
+	/* Guard against 32-bit address truncation in LLT entries */
+	if (upper_32_bits(hwdesc->usr_pdma_chn_cfg.src_addr) ||
+	    upper_32_bits(hwdesc->usr_pdma_chn_cfg.dst_addr)) {
+		dev_err(dev,
+			"pdma: address truncation! src=0x%llx dst=0x%llx\n",
+			(u64)hwdesc->usr_pdma_chn_cfg.src_addr,
+			(u64)hwdesc->usr_pdma_chn_cfg.dst_addr);
+		return NULL;
+	}
+
 	list_num =
 		(hwdesc->usr_pdma_chn_cfg.line_size - 1) / PDMA_MAX_LINE_SIZE +
 		1;
@@ -826,22 +851,24 @@ static void configure_pchan(struct k230_peridma_pchan *pchan,
 			    struct k230_peridma_hwdesc *hwdesc)
 {
 	struct k230_peridma_dev *pdev = pchan->pdev;
+	u32 ch_cfg;
+	u32 *llt_addr;
 
 	if (unlikely(!peridma_pchan_is_idle(pchan))) {
 		dev_err(vchan2dev(pchan->vchan), "pchan %d is non-idle!\n",
 			pchan->id);
-
 		return;
 	}
 
 	hwdesc->usr_pdma_chn_cfg.ch = (enum pdma_ch_e)pchan->id;
-
-	u32 ch_cfg = *(u32 *)&hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg;
-
+	ch_cfg = *(u32 *)&hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg;
 	iowrite32(ch_cfg, pchan->ch_regs + CH_CFG);
 	iowrite32(hwdesc->usr_pdma_chn_cfg.device,
 		  pdev->base + 0x120 + pchan->id * 4);
-	iowrite32((u32)(uintptr_t)pdma_llt_cal(pdev->dev, hwdesc, pchan->id),
+	llt_addr = pdma_llt_cal(pdev->dev, hwdesc, pchan->id);
+	if (WARN_ON(!llt_addr))
+		return;
+	iowrite32((u32)(uintptr_t)llt_addr,
 		  pchan->ch_regs + CH_LLT_SADDR);
 }
 
