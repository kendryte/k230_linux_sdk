-  sound {
-      compatible = "canaan,k230-audio-inno";
-      canaan,model = "K230_I2S_INNO";
-      canaan,k230-i2s-controller = <&i2s>;
-      canaan,k230-audio-codec = <&inno_codec>;
-  };
\ No newline at end of file
