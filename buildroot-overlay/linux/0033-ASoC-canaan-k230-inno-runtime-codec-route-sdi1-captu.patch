+        compatible = "canaan,k230-audio-inno";
+        canaan,model = "K230_I2S_INNO";
+        canaan,k230-i2s-controller = <&i2s>;
+        canaan,k230-audio-codec = <&inno_codec>;
+    };
+  - |
+    sound {
+        compatible = "canaan,k230-audio-inno";
+        canaan,model = "K230_I2S_INNO";
+        canaan,k230-i2s-controller = <&i2s>;
+        canaan,k230-audio-codec = <&inno_codec>;
+
+        /* Boot with the external digital I2S microphone on IO34. */
+        canaan,i2s-route = "external-i2s";
+    };
+  - |
+    sound {
+        compatible = "canaan,k230-audio-inno";
+        canaan,model = "K230_I2S_INNO";
+        canaan,k230-i2s-controller = <&i2s>;
+        canaan,k230-audio-codec = <&inno_codec>;
+
+        /*
+         * Board analog microphone through the internal codec on sdi0 plus
+         * an external digital I2S microphone on IO36 -> sdi1, captured
+         * together as four channels.
+         */
+        canaan,i2s-route = "internal-codec";
+        canaan,rx1-source = "external-i2s";
+    };
diff --git a/sound/soc/canaan/canaan_k230_inno.c b/sound/soc/canaan/canaan_k230_inno.c
index 3dee09feb..fee675691 100644
--- a/sound/soc/canaan/canaan_k230_inno.c
+++ b/sound/soc/canaan/canaan_k230_inno.c
@@ -34,6 +34,41 @@ struct k230_inno_info {
 	struct clk *pclk;
 	struct mutex clk_lock;
 	int clk_users;
+	/*
+	 * route_internal selects what the I2S bus is wired to. The hardware
+	 * MUX behind it (PDM_CONTROL_REG_0 bit5, audio_codec_bypass) switches
+	 * capture *and* playback at the same time:
+	 *   true  - sdi0 <- internal codec ADC <- board analog mic and
+	 *           sdo0 -> internal codec DAC -> HPOUT
+	 *   false - sdi0 <- IO34 (external digital I2S mic) and
+	 *           sdo0 -> IO35 (needs an external I2S DAC for playback)
+	 * Because both directions follow the same bit, the route may only be
+	 * changed while no substream is open. stream_users tracks that, and
+	 * clk_lock serialises both against the mixer control.
+	 */
+	bool route_internal;
+	int stream_users;
+	/*
+	 * rx1_enabled adds the second receive channel pair (sdi1, fed from
+	 * IO36) to the capture stream. Nothing muxes sdi1 - IO36 is its only
+	 * possible source - so this is a plain on/off and is orthogonal to
+	 * route_internal. With both in use a capture frame carries four
+	 * channels, interleaved sdi0-left, sdi0-right, sdi1-left, sdi1-right.
+	 */
+	bool rx1_enabled;
+	unsigned int max_capture_ch;
+
+	/*
+	 * The card, the DAI link and its components live here rather than in
+	 * file-static storage: probe() builds the codec list from the device
+	 * tree, and ASoC writes back into dai_link->dai_fmt, so sharing them
+	 * between instances would not be safe.
+	 */
+	struct snd_soc_dai_link_component cpus[1];
+	struct snd_soc_dai_link_component codecs[2];
+	struct snd_soc_dai_link_component platforms[1];
+	struct snd_soc_dai_link dailink;
+	struct snd_soc_card card;
 };
 
 static int k230_inno_hw_params(struct snd_pcm_substream *substream,
@@ -44,46 +79,201 @@ static int k230_inno_hw_params(struct snd_pcm_substream *substream,
 
 static void k230_inno_shutdown(struct snd_pcm_substream *substream)
 {
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct k230_inno_info *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	mutex_lock(&priv->clk_lock);
+	if (priv->stream_users)
+		priv->stream_users--;
+	mutex_unlock(&priv->clk_lock);
 }
 
 static int k230_inno_startup(struct snd_pcm_substream *substream)
 {
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct k230_inno_info *priv = snd_soc_card_get_drvdata(rtd->card);
+	unsigned int max_ch;
+	int ret;
+
+	/*
+	 * The CPU DAI advertises whatever I2S_COMP_PARAM_1 reports, which can
+	 * be more than the audio_in block actually feeds it: sdi0 and sdi1 are
+	 * the only sources, so capture tops out at four channels, and at two
+	 * unless sdi1 was enabled. Playback is stereo either way - the internal
+	 * codec and IO35 both carry one stereo pair.
+	 *
+	 * Constrain before taking the reference: if startup() fails ASoC does
+	 * not call shutdown(), so an early return here must not have counted.
+	 */
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		max_ch = priv->max_capture_ch;
+	else
+		max_ch = 2;
+
+	ret = snd_pcm_hw_constraint_minmax(substream->runtime,
+					   SNDRV_PCM_HW_PARAM_CHANNELS,
+					   1, max_ch);
+	if (ret < 0)
+		return ret;
+
+	mutex_lock(&priv->clk_lock);
+	priv->stream_users++;
+	mutex_unlock(&priv->clk_lock);
+
+	return 0;
+}
+
+static const char * const k230_codec_route_text[] = {
+	"Internal Codec", "External I2S",
+};
+
+static SOC_ENUM_SINGLE_EXT_DECL(k230_codec_route_enum, k230_codec_route_text);
+
+static int k230_codec_route_get(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct k230_inno_info *priv = snd_soc_card_get_drvdata(card);
+
+	ucontrol->value.enumerated.item[0] = priv->route_internal ? 0 : 1;
+
 	return 0;
 }
 
+static int k230_codec_route_put(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct k230_inno_info *priv = snd_soc_card_get_drvdata(card);
+	bool internal;
+	int ret;
+
+	if (ucontrol->value.enumerated.item[0] >=
+	    ARRAY_SIZE(k230_codec_route_text))
+		return -EINVAL;
+
+	internal = ucontrol->value.enumerated.item[0] == 0;
+
+	mutex_lock(&priv->clk_lock);
+
+	if (internal == priv->route_internal) {
+		ret = 0;
+		goto out;
+	}
+
+	/*
+	 * Re-routing under a running stream would corrupt capture and
+	 * playback both. Make the caller close the stream first.
+	 */
+	if (priv->stream_users) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	audio_i2s_enable_audio_codec(internal);
+	priv->route_internal = internal;
+	ret = 1;
+out:
+	mutex_unlock(&priv->clk_lock);
+
+	return ret;
+}
+
+static const struct snd_kcontrol_new canaan_k230_inno_controls[] = {
+	SOC_ENUM_EXT("Codec Route", k230_codec_route_enum,
+		     k230_codec_route_get, k230_codec_route_put),
+};
+
 static const struct snd_soc_ops canaan_k230_inno_ops = {
 	.startup = k230_inno_startup,
 	.shutdown = k230_inno_shutdown,
 	.hw_params = k230_inno_hw_params,
 };
 
-SND_SOC_DAILINK_DEFS(k230_inno, DAILINK_COMP_ARRAY(COMP_EMPTY()),
-		     DAILINK_COMP_ARRAY(COMP_CODEC(NULL,
-						   "k230-inno-codec-dai")),
-		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
-
-static struct snd_soc_dai_link canaan_k230_dailink = {
+static const struct snd_soc_dai_link canaan_k230_dailink_template = {
 	.name = "k230-inno-codec",
 	.stream_name = "Audio",
 	.ops = &canaan_k230_inno_ops,
 	.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
 		   SND_SOC_DAIFMT_CBS_CFS,
-	SND_SOC_DAILINK_REG(k230_inno),
 };
 
-static struct snd_soc_card snd_soc_card_k230 = {
+static const struct snd_soc_card canaan_k230_card_template = {
 	.name = "CANAAN-K230-I2S",
 	.owner = THIS_MODULE,
-	.dai_link = &canaan_k230_dailink,
 	.num_links = 1,
 };
 
+/*
+ * Both properties are optional and both default to what this driver has always
+ * done, so no existing board device tree needs to change.
+ *
+ * "canaan,i2s-route" picks the boot-time default for the sdi0/sdo0 MUX. It is
+ * only a default: userspace can still flip the "Codec Route" control at
+ * runtime, and alsactl(1) can make its choice persistent.
+ *
+ * "canaan,rx1-source" enables sdi1. Unlike the route it cannot be a runtime
+ * control, because it decides how many CODEC DAIs the link has and that is
+ * fixed when the card is registered. It only raises the channel ceiling
+ * though - whether a capture runs two or four channels is still up to the
+ * application.
+ */
+static int canaan_k230_inno_parse_route(struct platform_device *pdev,
+					struct k230_inno_info *priv)
+{
+	const char *route;
+	int ret;
+
+	priv->route_internal = true;
+	priv->rx1_enabled = false;
+
+	ret = of_property_read_string(pdev->dev.of_node, "canaan,i2s-route",
+				      &route);
+	if (ret && ret != -EINVAL)
+		return ret;
+
+	if (!ret) {
+		if (!strcmp(route, "internal-codec")) {
+			priv->route_internal = true;
+		} else if (!strcmp(route, "external-i2s")) {
+			priv->route_internal = false;
+		} else {
+			dev_err(&pdev->dev,
+				"invalid 'canaan,i2s-route' value '%s'\n",
+				route);
+			return -EINVAL;
+		}
+	}
+
+	ret = of_property_read_string(pdev->dev.of_node, "canaan,rx1-source",
+				      &route);
+	if (ret && ret != -EINVAL)
+		return ret;
+
+	if (!ret) {
+		if (!strcmp(route, "none")) {
+			priv->rx1_enabled = false;
+		} else if (!strcmp(route, "external-i2s")) {
+			priv->rx1_enabled = true;
+		} else {
+			dev_err(&pdev->dev,
+				"invalid 'canaan,rx1-source' value '%s'\n",
+				route);
+			return -EINVAL;
+		}
+	}
+
+	priv->max_capture_ch = priv->rx1_enabled ? 4 : 2;
+
+	return 0;
+}
+
 static int canaan_k230_inno_probe(struct platform_device *pdev)
 {
-	struct snd_soc_card *card = &snd_soc_card_k230;
 	struct device_node *codec_np, *cpu_np;
-	struct snd_soc_dai_link *dailink = &canaan_k230_dailink;
 	struct device_node *np = pdev->dev.of_node;
+	struct snd_soc_dai_link *dailink;
+	struct snd_soc_card *card;
 	struct k230_inno_info *priv;
 	int ret;
 
@@ -98,17 +288,56 @@ static int canaan_k230_inno_probe(struct platform_device *pdev)
 
 	mutex_init(&priv->clk_lock);
 
+	ret = canaan_k230_inno_parse_route(pdev, priv);
+	if (ret)
+		return ret;
+
+	priv->dailink = canaan_k230_dailink_template;
+	priv->card = canaan_k230_card_template;
+	dailink = &priv->dailink;
+	card = &priv->card;
+
+	dailink->cpus = priv->cpus;
+	dailink->num_cpus = ARRAY_SIZE(priv->cpus);
+	dailink->platforms = priv->platforms;
+	dailink->num_platforms = ARRAY_SIZE(priv->platforms);
+	dailink->codecs = priv->codecs;
+
+	card->dai_link = dailink;
 	card->dev = &pdev->dev;
+	card->controls = canaan_k230_inno_controls;
+	card->num_controls = ARRAY_SIZE(canaan_k230_inno_controls);
 	snd_soc_card_set_drvdata(card, priv);
 
 	codec_np = of_parse_phandle(np, "canaan,k230-audio-codec", 0);
-	if (!codec_np) {
-		dev_err(&pdev->dev,
-			"Property 'canaan,k230-audio-codec' missing or invalid\n");
-		return -EINVAL;
+	if (codec_np) {
+		priv->codecs[0].of_node = codec_np;
+		priv->codecs[0].dai_name = "k230-inno-codec-dai";
+		of_node_put(codec_np);
+	} else {
+		/*
+		 * A board may have no internal codec at all, in which case the
+		 * I2S bus can only reach the outside world. Stand a dummy DAI
+		 * in for the codec and force the external route.
+		 */
+		dev_info(&pdev->dev,
+			 "no 'canaan,k230-audio-codec', using external I2S only\n");
+		priv->codecs[0] = snd_soc_dummy_dlc;
+		priv->route_internal = false;
+	}
+	dailink->num_codecs = 1;
+
+	if (priv->rx1_enabled && codec_np) {
+		/*
+		 * A second CODEC DAI makes snd_soc_runtime_calc_hw() discard
+		 * the CODEC channel limits and use the CPU DAI's instead, which
+		 * is what lifts capture from the inno codec's two channels to
+		 * the controller's four. The codec driver stays untouched - it
+		 * only ever sees sdi0/sdo0 either way.
+		 */
+		priv->codecs[1] = snd_soc_dummy_dlc;
+		dailink->num_codecs = 2;
 	}
-	dailink->codecs->of_node = codec_np;
-	of_node_put(codec_np);
 
 	cpu_np = of_parse_phandle(np, "canaan,k230-i2s-controller", 0);
