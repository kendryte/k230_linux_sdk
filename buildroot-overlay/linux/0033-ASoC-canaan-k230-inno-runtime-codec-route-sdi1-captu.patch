+  compatible:
+    const: "canaan,k230-audio-inno"
+    description: |
+      Must be "canaan,k230-audio-inno".
+
+  canaan,model:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: |
+      Custom model name for the sound card.
+
+  canaan,k230-i2s-controller:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: |
+      Phandle to the I2S controller node.
+
+  canaan,k230-audio-codec:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: |
+      Phandle to the internal INNO codec node. May be omitted on boards that
+      have no internal codec, in which case the I2S bus is always routed to
+      the external pins.
+
+  canaan,i2s-route:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [internal-codec, external-i2s]
+    default: internal-codec
+    description: |
+      Boot-time default for what the I2S bus is wired to. The SoC has a
+      single MUX (PDM_CONTROL_REG_0 bit5) that switches capture and
+      playback together, so this selects both directions at once:
+
+        internal-codec - capture from the internal codec ADC (board analog
+          microphone) and play back through the internal codec DAC.
+        external-i2s - capture from IO34 (an external digital I2S
+          microphone) and send playback to IO35, which requires an
+          external I2S DAC. The internal codec is unused.
+
+      This is only the power-on default; the "Codec Route" mixer control
+      overrides it at runtime while no stream is open.
+
+      Selecting external-i2s requires IO34 (and IO35 for playback) to be
+      muxed to their IIS functions.
+
+  canaan,rx1-source:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [none, external-i2s]
+    default: none
+    description: |
+      Whether the second I2S receive channel pair (sdi1) takes part in
+      capture. Nothing muxes sdi1 - IO36 is its only possible source - so
+      this is independent of canaan,i2s-route:
+
+        none - capture uses sdi0 only, two channels.
+        external-i2s - capture also takes sdi1 from IO36, giving four
+          channels interleaved as sdi0-left, sdi0-right, sdi1-left,
+          sdi1-right. Combined with canaan,i2s-route = "internal-codec"
+          this is the board analog microphone and an external digital I2S
+          microphone recorded together, sample aligned.
+
+      Unlike canaan,i2s-route this cannot be changed at runtime: it decides
+      how many CODEC DAIs the link has, which is fixed once the card is
+      registered. It only raises the channel ceiling though - an application
+      may still capture two channels, which yields sdi0 alone.
+
+      Selecting external-i2s requires IO36 to be muxed to IIS_D_IN1. On the
+      Canaan reference boards IO36/IO37 are assigned to I2C3, so a board
+      using sdi1 has to give that up.
 
 required:
-- compatible
-- canaan,k230-i2s-controller
-- canaan,k230-audio-codec
+  - compatible
+  - canaan,k230-i2s-controller
 
 additionalProperties: false
 
 examples:
