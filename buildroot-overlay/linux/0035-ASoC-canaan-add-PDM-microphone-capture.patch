diff --git a/sound/soc/canaan/canaan_k230_pdm.c b/sound/soc/canaan/canaan_k230_pdm.c
new file mode 100644
index 000000000..cbbda6445
--- /dev/null
+++ b/sound/soc/canaan/canaan_k230_pdm.c
@@ -0,0 +1,947 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ASoC capture driver for the K230 PDM receiver.
+ *
+ * Copyright (C) 2026, Canaan Bright Sight Co., Ltd
+ *
+ * The PDM receiver sits in the same register block as the I2S glue logic, but
+ * it is otherwise an independent capture path: its own decimation chain, its
+ * own FIFO, and its own PDMA request line (PDM_IN, 33). Nothing here disturbs
+ * the I2S controller or the internal codec, so a board can run PDM capture at
+ * the same time as codec playback.
+ */
+
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/dmaengine.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "canaan_k230_audio.h"
+
+#define DRV_NAME "canaan-k230-pdm"
+
+/*
+ * Four data lines (PDM_IN0..PDM_IN3), each carrying two microphones when both
+ * clock edges are sampled, so eight channels in total. pdm_chl_num holds the
+ * channel count in four bits and the per-sample channel tag is four bits wide,
+ * so the registers have room for all eight.
+ *
+ * Note pdm_chl_num counts channels rather than lines, so a board sampling both
+ * edges of one line has to program 2 and not 1.
+ */
+#define K230_PDM_MAX_DATA_LINES	4
+#define K230_PDM_MAX_CHANNELS	8
+
+/*
+ * How full the FIFO gets before it asks PDMA for a burst; the field holds the
+ * count minus one, so this is "eight samples". It has to be read together with
+ * the single-beat burst requested in hw_params(): a burst the PDM FIFO cannot
+ * keep fed leaves the channel waiting for DataReq until chx_dev_tout expires,
+ * at which point the hardware stops the transfer (TRM 2.5.1, CHx_CFG
+ * chx_dev_tout).
+ */
+#define K230_PDM_FIFO_TRIGGER	7
+
+/*
+ * Bounds on the buffer the application sees. Eight channels of S32_LE at
+ * 16KB per period is 512 frames, about 10ms at 48kHz, and the 128KB ceiling
+ * leaves room for the deepest sensible buffer at that width.
+ */
+#define K230_PDM_MAX_PERIOD_BYTES	16384
+#define K230_PDM_MAX_BUFFER_BYTES	(128 * 1024)
+
+/*
+ * The same period in the raw stream, which always carries one 32-bit word per
+ * sample: S16_LE is the worst case at twice the application's period, S24_LE
+ * and S32_LE are 1:1. Deriving the cap this way means no set of hw_params
+ * ALSA has already accepted can be turned away in hw_params().
+ *
+ * PDMA splits anything past MAX_LINE_SIZE (0xffff) into several descriptors
+ * and marks only the last one, so the period callback still fires once per
+ * period; the cap is here to bound the bounce buffer, not to fit a descriptor.
+ */
+#define K230_PDM_MAX_RAW_PERIOD_BYTES	(2 * K230_PDM_MAX_PERIOD_BYTES)
+
+/* Right-aligned samples carry the channel tag in bits 27:24, PCM in 23:0. */
+#define K230_PDM_TAG_SHIFT_RIGHT	24
+#define K230_PDM_TAG_SHIFT_LEFT		28
+
+struct k230_pdm {
+	struct device *dev;
+	struct clk *clk;
+	struct dma_chan *chan;
+
+	/* Board description, from the device tree. See the binding. */
+	unsigned int data_lines;
+	unsigned int edge;
+	/* An AUDIO_PDM_OVERSAMPLE_* selector, not a factor. */
+	unsigned int oversample;
+	bool use_io35_37;
+	unsigned int max_channels;
+
+	/*
+	 * The raw stream cannot go straight into the buffer the application
+	 * sees: every 32-bit word carries a four-bit channel tag that has to
+	 * come off first. PDMA fills this bounce buffer instead, and the period
+	 * callback converts one period at a time into runtime->dma_area.
+	 *
+	 * The alternative, an ASoC .copy callback, would rule out mmap and with
+	 * it dsnoop; a second buffer of a few tens of kilobytes is the cheaper
+	 * side of that trade.
+	 */
+	void *raw;
+	dma_addr_t raw_phys;
+	size_t raw_bytes;
+	unsigned int raw_period_words;
+	unsigned int raw_pos_words;
+
+	struct snd_pcm_substream *substream;
+	unsigned int channels;
+	unsigned int tag_shift;
+	snd_pcm_format_t format;
+
+	/* Where the next converted frame goes, in frames from the start. */
+	unsigned int alsa_pos;
+	unsigned int buffer_frames;
+	unsigned int period_frames;
+	unsigned int period_acc;
+
+	/* Frame reassembly state; see k230_pdm_convert(). */
+	unsigned int expect;
+	bool hunting;
+	u32 accum[K230_PDM_MAX_CHANNELS];
+	unsigned long desyncs;
+
+	bool running;
+
+	struct snd_soc_dai_link_component cpus[1];
+	struct snd_soc_dai_link_component codecs[1];
+	struct snd_soc_dai_link_component platforms[1];
+	struct snd_soc_dai_link dailink;
+	struct snd_soc_card card;
+};
+
+/*
+ * AUDIO_PDM_OVERSAMPLE_32, _64 and _128 are consecutive enumerators starting at
+ * zero, which is what the hardware wants in pdm_conf_0. Anything that needs the
+ * decimation factor itself has to convert.
+ */
+static unsigned int k230_pdm_oversample_factor(const struct k230_pdm *pdm)
+{
+	return 32u << pdm->oversample;
+}
+
+/*
+ * The decimation chain is driven entirely by pdm_clk, so this list is about
+ * what the filters were tuned for rather than any hard limit. Rates pdm_clk
+ * cannot actually produce are rejected in hw_params().
+ */
+#define K230_PDM_RATES	SNDRV_PCM_RATE_8000_192000
+
+#define K230_PDM_FORMATS (SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE | \
+			  SNDRV_PCM_FMTBIT_S32_LE)
+
+static const struct snd_pcm_hardware k230_pdm_hardware = {
+	.info			= SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER |
+				  SNDRV_PCM_INFO_MMAP |
+				  SNDRV_PCM_INFO_MMAP_VALID,
+	.formats		= K230_PDM_FORMATS,
+	.rates			= K230_PDM_RATES,
+	.rate_min		= 8000,
+	.rate_max		= 192000,
+	.channels_min		= 1,
+	.channels_max		= K230_PDM_MAX_CHANNELS,
+	.buffer_bytes_max	= K230_PDM_MAX_BUFFER_BYTES,
+	.period_bytes_min	= 256,
+	.period_bytes_max	= K230_PDM_MAX_PERIOD_BYTES,
+	.periods_min		= 2,
+	.periods_max		= 32,
+};
+
+/* ------------------------------------------------------------------ */
+/* raw stream conversion                                              */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Turn one raw word into one sample of the requested format. The PCM payload is
+ * 24 bits of two's complement; where it sits in the word depends on alignment,
+ * which k230_pdm_prepare() has already folded into tag_shift.
+ */
+static u32 k230_pdm_sample(struct k230_pdm *pdm, u32 raw)
+{
+	u32 pcm24;
+
+	if (pdm->tag_shift == K230_PDM_TAG_SHIFT_RIGHT)
+		pcm24 = raw & GENMASK(23, 0);
+	else
+		pcm24 = (raw >> 4) & GENMASK(23, 0);
+
+	switch (pdm->format) {
+	case SNDRV_PCM_FORMAT_S32_LE:
+		return pcm24 << 8;
+	case SNDRV_PCM_FORMAT_S24_LE:
+		/* 24 bits in the low three bytes of a 32-bit container. */
+		return pcm24;
+	case SNDRV_PCM_FORMAT_S16_LE:
+	default:
+		return pcm24 >> 8;
+	}
+}
+
+static void k230_pdm_store_frame(struct k230_pdm *pdm)
+{
+	struct snd_pcm_runtime *runtime = pdm->substream->runtime;
+	unsigned int i, nch = pdm->channels;
+	void *dst = runtime->dma_area +
+		    frames_to_bytes(runtime, pdm->alsa_pos);
+
+	if (pdm->format == SNDRV_PCM_FORMAT_S16_LE) {
+		u16 *p = dst;
+
+		for (i = 0; i < nch; i++)
+			p[i] = k230_pdm_sample(pdm, pdm->accum[i]);
+	} else {
+		u32 *p = dst;
+
+		for (i = 0; i < nch; i++)
+			p[i] = k230_pdm_sample(pdm, pdm->accum[i]);
+	}
+
+	if (++pdm->alsa_pos >= pdm->buffer_frames)
+		pdm->alsa_pos = 0;
+}
+
+/*
+ * Convert one period out of the bounce buffer.
+ *
+ * Every word says which channel it belongs to, so rather than assuming the
+ * period starts on a frame boundary - it does not, the first DMA burst after a
+ * FIFO clear can begin on any channel - the frame is reassembled from the tags.
+ * The cost is one shift and one compare per sample; the gain is that a stream
+ * that briefly loses step recovers by itself at the next channel 0 instead of
+ * swapping channels for the rest of the recording.
+ *
+ * Returns the number of complete periods written to the ALSA buffer, which is
+ * one in the steady state and can be zero on the very first callback, where up
+ * to nch-1 samples get dropped to find the first frame boundary.
+ */
+static unsigned int k230_pdm_convert(struct k230_pdm *pdm)
+{
+	const u32 *src = (const u32 *)pdm->raw + pdm->raw_pos_words;
+	unsigned int n = pdm->raw_period_words;
+	unsigned int nch = pdm->channels;
+	unsigned int elapsed = 0;
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		u32 word = src[i];
+		unsigned int ch = (word >> pdm->tag_shift) & 0xf;
+
+		if (ch >= nch) {
+			/*
+			 * The tag names a channel we did not enable, so the
+			 * word is not one of ours - a stray FIFO entry from
+			 * before the last clear, or a glitch on the data line.
+			 * Throw it away and look for the start of a frame.
+			 */
+			if (!pdm->hunting) {
+				pdm->desyncs++;
+				pdm->hunting = true;
+			}
+			pdm->expect = 0;
+			continue;
+		}
+
+		if (ch != pdm->expect) {
+			/*
+			 * Out of step. Channel 0 starts a new frame, so we can
+			 * pick up again immediately; anything else means we are
+			 * mid-frame and have to wait for the next channel 0.
+			 */
+			if (!pdm->hunting)
+				pdm->desyncs++;
+			if (ch != 0) {
+				pdm->hunting = true;
+				pdm->expect = 0;
+				continue;
+			}
+		}
+
+		pdm->hunting = false;
+		pdm->accum[ch] = word;
+		pdm->expect = ch + 1;
+
+		if (pdm->expect < nch)
+			continue;
+
+		pdm->expect = 0;
+		k230_pdm_store_frame(pdm);
+
+		if (++pdm->period_acc >= pdm->period_frames) {
+			pdm->period_acc = 0;
+			elapsed++;
+		}
+	}
+
+	pdm->raw_pos_words += n;
+	if (pdm->raw_pos_words >= pdm->raw_bytes / sizeof(u32))
+		pdm->raw_pos_words = 0;
+
+	return elapsed;
+}
+
+static void k230_pdm_dma_complete(void *arg)
+{
+	struct k230_pdm *pdm = arg;
+	unsigned int elapsed;
+
+	/*
+	 * trigger(STOP) tears the transfer down asynchronously, so one more
+	 * callback can still arrive after the substream is on its way out.
+	 */
+	if (!READ_ONCE(pdm->running))
+		return;
+
+	elapsed = k230_pdm_convert(pdm);
+
+	while (elapsed--)
+		snd_pcm_period_elapsed(pdm->substream);
+}
+
+/* ------------------------------------------------------------------ */
+/* PCM component                                                      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The card and the component both live on this one device, and
+ * snd_soc_register_card() claims the device's driver data for the card
+ * (sound/soc/soc-core.c:2403). snd_soc_component_get_drvdata() is nothing but
+ * dev_get_drvdata() (include/sound/soc-component.h:432), so in a driver shaped
+ * like this one it hands back the card rather than our private data. Reach the
+ * private data through the card's own pointer, which nothing else touches.
+ */
+static struct k230_pdm *k230_pdm_from_substream(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	return snd_soc_card_get_drvdata(rtd->card);
+}
+
+static int k230_pdm_open(struct snd_soc_component *component,
+			 struct snd_pcm_substream *substream)
+{
+	struct k230_pdm *pdm = k230_pdm_from_substream(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int ret;
+
+	snd_soc_set_runtime_hwparams(substream, &k230_pdm_hardware);
+
+	/*
+	 * How many channels actually exist is a property of the board: one per
+	 * data line, doubled when both clock edges are sampled because then two
+	 * microphones share the line.
+	 */
+	ret = snd_pcm_hw_constraint_minmax(runtime, SNDRV_PCM_HW_PARAM_CHANNELS,
+					   1, pdm->max_channels);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * Keep the period a whole number of FIFO trigger levels. The FIFO asks
+	 * for data every eight samples, so a period that is a multiple of eight
+	 * frames never leaves a partial group behind at the end of a period -
+	 * every sane period size is a multiple of eight anyway.
+	 */
+	ret = snd_pcm_hw_constraint_step(runtime, 0,
+					 SNDRV_PCM_HW_PARAM_PERIOD_SIZE, 8);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int k230_pdm_hw_params(struct snd_soc_component *component,
+			      struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params)
+{
+	struct k230_pdm *pdm = k230_pdm_from_substream(substream);
+	struct dma_slave_config cfg = { 0 };
+	unsigned int channels = params_channels(params);
+	unsigned int periods = params_periods(params);
+	size_t raw_period, raw_total;
+	unsigned long rate, actual;
+	int ret;
+
+	if (channels > pdm->max_channels)
+		return -EINVAL;
+
+	/* One 32-bit word per sample, whatever the application asked for. */
+	raw_period = (size_t)params_period_size(params) * channels * sizeof(u32);
+	raw_total = raw_period * periods;
+
+	if (raw_period > K230_PDM_MAX_RAW_PERIOD_BYTES) {
+		dev_err(pdm->dev, "period of %zu raw bytes exceeds %u\n",
+			raw_period, K230_PDM_MAX_RAW_PERIOD_BYTES);
+		return -EINVAL;
+	}
+
+	if (pdm->raw && pdm->raw_bytes != raw_total) {
+		dma_free_coherent(pdm->chan->device->dev, pdm->raw_bytes,
+				  pdm->raw, pdm->raw_phys);
+		pdm->raw = NULL;
+	}
+
+	if (!pdm->raw) {
+		pdm->raw = dma_alloc_coherent(pdm->chan->device->dev, raw_total,
+					      &pdm->raw_phys, GFP_KERNEL);
+		if (!pdm->raw)
+			return -ENOMEM;
+		pdm->raw_bytes = raw_total;
+	}
+
+	pdm->raw_period_words = raw_period / sizeof(u32);
+
+	cfg.direction = DMA_DEV_TO_MEM;
+	cfg.src_addr = audio_pdm_fifo_phys_addr();
+	cfg.src_addr_width = DMA_SLAVE_BUSWIDTH_4_BYTES;
+	/*
+	 * One beat per burst. The FIFO gains a single word per sample per data
+	 * line, so the deeper a burst drains it the longer the channel is then
+	 * left waiting on DataReq - and chx_dev_tout allows only 0xfff bus
+	 * cycles of waiting before it abandons the transfer. A single beat
+	 * keeps that wait as short as the trigger level allows.
+	 */
+	cfg.src_maxburst = 1;
+
+	ret = dmaengine_slave_config(pdm->chan, &cfg);
+	if (ret) {
+		dev_err(pdm->dev, "failed to configure DMA channel: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * One PDM clock per oversampled bit, so the bit clock is the sample
+	 * rate multiplied by the decimation factor: 3.072MHz for 48kHz at 64x.
+	 * Most PDM microphones want somewhere between 1 and 3.5MHz, which is
+	 * why the factor is a board property rather than a fixed 64.
+	 */
+	rate = (unsigned long)params_rate(params) *
+	       k230_pdm_oversample_factor(pdm);
+
+	ret = clk_set_rate(pdm->clk, rate);
+	if (ret) {
+		dev_err(pdm->dev, "failed to set pdm_clk to %luHz: %d\n",
+			rate, ret);
+		return ret;
+	}
+
+	/*
+	 * pdm_clk only supports the rates listed in the table in
+	 * k230_clk_find_approximate(), and asking for anything else does not
+	 * fail: the divider and the multiplier are both left at zero and the
+	 * clock stops. Nothing downstream notices, the receiver simply never
+	 * produces a sample and the DMA channel reports a device timeout, so
+	 * check the rate we actually got instead of the return code.
+	 */
+	actual = clk_get_rate(pdm->clk);
+	if (actual != rate) {
+		dev_err(pdm->dev,
+			"pdm_clk cannot produce %luHz (%uHz x %u), got %luHz\n",
+			rate, params_rate(params),
+			k230_pdm_oversample_factor(pdm), actual);
+		return -EINVAL;
+	}
+
+	dev_dbg(pdm->dev, "pdm_clk %luHz\n", actual);
+
+	return 0;
+}
+
+static int k230_pdm_hw_free(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	struct k230_pdm *pdm = k230_pdm_from_substream(substream);
+
+	/*
+	 * prepare() leaves the receiver running, and an application is allowed
+	 * to prepare a stream and then close it without ever starting it, so
+	 * stop it here too rather than only in trigger().
+	 */
+	audio_pdm_in_init(pdm->oversample, 0, pdm->edge, AUDIO_IN_RIGHT_ALIGN,
+			  K230_PDM_FIFO_TRIGGER);
+
+	/*
+	 * trigger() runs atomically and can only terminate the transfer
+	 * asynchronously, so this is where we wait for the callback to be done
+	 * with the bounce buffer before releasing it.
+	 */
+	dmaengine_synchronize(pdm->chan);
+
+	if (pdm->raw) {
+		dma_free_coherent(pdm->chan->device->dev, pdm->raw_bytes,
+				  pdm->raw, pdm->raw_phys);
+		pdm->raw = NULL;
+		pdm->raw_bytes = 0;
+	}
+
+	return 0;
+}
+
+static int k230_pdm_prepare(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	struct k230_pdm *pdm = k230_pdm_from_substream(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+
+	pdm->substream = substream;
+	pdm->channels = runtime->channels;
+	pdm->format = runtime->format;
+	pdm->buffer_frames = runtime->buffer_size;
+	pdm->period_frames = runtime->period_size;
+
+	/*
+	 * There is no reason for a board to want anything but right alignment -
+	 * it describes where the chip puts the bits inside a word, not how the
+	 * board is wired.
+	 */
+	pdm->tag_shift = K230_PDM_TAG_SHIFT_RIGHT;
+
+	pdm->raw_pos_words = 0;
+	pdm->alsa_pos = 0;
+	pdm->period_acc = 0;
+	pdm->expect = 0;
+	pdm->hunting = true;
+	pdm->desyncs = 0;
+
+	/*
+	 * Start the receiver here rather than in trigger(), so that it is
+	 * already producing samples by the time the DMA channel is enabled.
+	 *
+	 * The PDMA channel gives up if DataReq stays deasserted for chx_dev_tout
+	 * bus cycles and reports chx_dev_tout_int instead of transferring
+	 * anything (TRM 2.5.2, CHx_CFG). At the 0xfff the device tree asks for
+	 * that is roughly 20us, while the receiver needs to collect
+	 * K230_PDM_FIFO_TRIGGER + 1 words before it asks for a burst - 83us for
+	 * two channels at 48kHz. Enabling the receiver from trigger() therefore
+	 * loses the race no matter how the two calls are ordered: the FIFO is
+	 * empty at that point either way.
+	 *
+	 * prepare() and the start trigger are separate ioctls, so by the time
+	 * the channel runs the FIFO has long passed the trigger level and
+	 * DataReq is already asserted - the same situation the I2S receiver is
+	 * always in, its bit clock never having stopped. Samples collected in
+	 * between are simply overwritten in the FIFO; frames are assembled from
+	 * the channel tag carried by each sample, so nothing depends on which
+	 * channel the first word taken happens to belong to.
+	 */
+	audio_pdm_in_init(pdm->oversample, 0, pdm->edge, AUDIO_IN_RIGHT_ALIGN,
+			  K230_PDM_FIFO_TRIGGER);
+	audio_pdm_irq_clear();
+	audio_pdm_in_init(pdm->oversample, pdm->channels, pdm->edge,
+			  AUDIO_IN_RIGHT_ALIGN, K230_PDM_FIFO_TRIGGER);
+
+	return 0;
+}
+
+static int k230_pdm_trigger(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream, int cmd)
+{
+	struct k230_pdm *pdm = k230_pdm_from_substream(substream);
+	struct dma_async_tx_descriptor *desc;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		/*
+		 * The receiver has been running since prepare() and its FIFO is
+		 * above the trigger level, so the channel finds DataReq already
+		 * asserted and starts moving data straight away.
+		 *
+		 * Only START actually gets here. snd_pcm_pre_resume() and
+		 * snd_pcm_pre_pause() refuse with -ENOSYS unless the stream
+		 * advertises SNDRV_PCM_INFO_RESUME and SNDRV_PCM_INFO_PAUSE,
+		 * and k230_pdm_hardware advertises neither, so the core never
+		 * issues the other two commands - an application recovers a
+		 * suspended stream through prepare(), which is where the
+		 * receiver is restarted. The labels are kept because the
+		 * default case rejects anything not listed.
+		 */
+		desc = dmaengine_prep_dma_cyclic(pdm->chan, pdm->raw_phys,
+						 pdm->raw_bytes,
+						 pdm->raw_period_words *
+							 sizeof(u32),
+						 DMA_DEV_TO_MEM,
+						 DMA_PREP_INTERRUPT);
+		if (!desc)
+			return -ENOMEM;
+
+		desc->callback = k230_pdm_dma_complete;
+		desc->callback_param = pdm;
+
+		WRITE_ONCE(pdm->running, true);
+
+		dmaengine_submit(desc);
+		dma_async_issue_pending(pdm->chan);
+		break;
+
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		WRITE_ONCE(pdm->running, false);
+
+		/* A channel count of zero stops the receiver and clears the FIFO. */
+		audio_pdm_in_init(pdm->oversample, 0, pdm->edge,
+				  AUDIO_IN_RIGHT_ALIGN, K230_PDM_FIFO_TRIGGER);
+		dmaengine_terminate_async(pdm->chan);
+
+		if (pdm->desyncs)
+			dev_warn(pdm->dev,
+				 "%lu channel tag desyncs during capture\n",
+				 pdm->desyncs);
+		break;
+
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static snd_pcm_uframes_t k230_pdm_pointer(struct snd_soc_component *component,
+					  struct snd_pcm_substream *substream)
+{
+	struct k230_pdm *pdm = k230_pdm_from_substream(substream);
+
+	/*
+	 * The DMA position is not the position the application sees: the
+	 * conversion in the period callback is what advances the ALSA buffer.
+	 */
+	return READ_ONCE(pdm->alsa_pos);
+}
+
+static int k230_pdm_pcm_construct(struct snd_soc_component *component,
+				  struct snd_soc_pcm_runtime *rtd)
+{
+	/*
+	 * The application's buffer is written by the CPU, never by DMA, so it
+	 * only has to be page-backed for mmap - vmalloc is enough and avoids
+	 * pinning a second block of coherent memory.
+	 */
+	snd_pcm_set_managed_buffer_all(rtd->pcm, SNDRV_DMA_TYPE_VMALLOC, NULL,
+				       0, K230_PDM_MAX_BUFFER_BYTES);
+
+	return 0;
+}
+
+static const struct snd_soc_component_driver k230_pdm_component = {
+	.name		= DRV_NAME,
+	.open		= k230_pdm_open,
+	.hw_params	= k230_pdm_hw_params,
+	.hw_free	= k230_pdm_hw_free,
+	.prepare	= k230_pdm_prepare,
+	.trigger	= k230_pdm_trigger,
+	.pointer	= k230_pdm_pointer,
+	.pcm_construct	= k230_pdm_pcm_construct,
+};
+
+static struct snd_soc_dai_driver k230_pdm_dai = {
+	.name = "k230-pdm-dai",
+	.capture = {
+		.stream_name	= "PDM Capture",
+		.channels_min	= 1,
+		.channels_max	= K230_PDM_MAX_CHANNELS,
+		.rates		= K230_PDM_RATES,
+		.formats	= K230_PDM_FORMATS,
