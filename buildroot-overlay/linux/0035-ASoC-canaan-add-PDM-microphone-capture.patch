diff --git a/Documentation/devicetree/bindings/sound/canaan,k230-audio-pdm.yaml b/Documentation/devicetree/bindings/sound/canaan,k230-audio-pdm.yaml
new file mode 100644
index 000000000..a186d7371
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/canaan,k230-audio-pdm.yaml
@@ -0,0 +1,179 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+%YAML 1.2
+---
+$id: "http://devicetree.org/schemas/sound/canaan,k230-audio-pdm.yaml#"
+$schema: "http://devicetree.org/meta-schemas/core.yaml#"
+
+title: Canaan K230 PDM Microphone Capture
+
+maintainers:
+  - Sun Xiaopeng <sunxiaopeng@canaan-creative.com>
+
+description: |
+  Capture-only sound card for PDM microphones wired to the K230 PDM receiver.
+
+  The receiver is an independent capture path: it does not use the I2S
+  controller or the internal codec, so a board may have both this card and a
+  canaan,k230-audio-inno card and run them at the same time.
+
+  The receiver has four data lines, PDM_IN0 to PDM_IN3, and each line carries
+  two microphones when both clock edges are sampled - the microphones strap
+  their L/R pin low and high respectively. Eight channels is therefore the
+  maximum, and the channel count is
+
+    canaan,pdm-data-lines * (canaan,pdm-edge == "both" ? 2 : 1)
+
+  Which pins the lines can use is fixed by the IOMUX, and only the first two
+  lines have a choice:
+
+    PDM_IN0 - IO27 (alt3) or IO37 (alt2)
+    PDM_IN1 - IO28 (alt3) or IO35 (alt2)
+    PDM_IN2 - IO36 (alt2)
+    PDM_IN3 - IO34 (alt2)
+
+  canaan,pdm-io-group picks between the two alternatives for the first two
+  lines. The last two have none: IO36 and IO34 are also IIS_D_IN1 and
+  IIS_D_IN0, so a board wiring up more than two PDM data lines gives up the
+  external I2S microphone inputs on those pins.
+
+  The registers live inside the canaan,k230-audio block, which is why this
+  node has no reg property of its own.
+
+properties:
+  compatible:
+    const: "canaan,k230-audio-pdm"
+
+  canaan,model:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: Custom name for the sound card.
+
+  clocks:
+    maxItems: 1
+    description: The PDM bit clock (pdm_clk).
+
+  clock-names:
+    items:
+      - const: pdm
+
+  dmas:
+    maxItems: 1
+
+  dma-names:
+    items:
+      - const: rx
+
+  canaan,pdm-data-lines:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [1, 2, 3, 4]
+    default: 1
+    description: |
+      How many PDM data lines the board wires up, counting from PDM_IN0.
+      Together with canaan,pdm-edge this sets the maximum channel count.
+      More than two lines needs IO36 and IO34, which are shared with the I2S
+      data inputs.
+
+  canaan,pdm-edge:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [both, rising, falling]
+    default: both
+    description: |
+      Which clock edge the microphones are sampled on.
+
+        both - two microphones per data line, one on each edge. This is the
+          usual arrangement and doubles the channel count.
+        rising, falling - one microphone per data line, sampled on that edge.
+
+  canaan,pdm-oversample:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [32, 64, 128]
+    default: 64
+    description: |
+      How many PDM clocks make up one output sample; it also selects the
+      decimation filter chain. The PDM clock ends up at sample rate times
+      this factor, so 48kHz at 64x is 3.072MHz. Pick the factor that puts
+      the clock inside the range the microphones accept - most want somewhere
+      between 1 and 3.5MHz.
+
+  canaan,pdm-io-group:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [io27-28, io35-37]
+    default: io27-28
+    description: |
+      Which pins carry the first two PDM data lines.
+
+        io27-28 - PDM_IN0 on IO27 and PDM_IN1 on IO28. Costs nothing: this is
+          also what the I2S card programs, so PDM capture, I2S output and the
+          internal codec all coexist.
+        io35-37 - PDM_IN0 on IO37 and PDM_IN1 on IO35. Those two pins then
+          stop carrying I2S output data, because the audio-in block's input
+          mode is a single choice covering both of them. The internal codec is
+          fed inside the block rather than through these pins and is
+          unaffected.
+
+      The pin mux itself is set through pinctrl either way; this property
+      drives a second mux inside the audio block that the pin controller
+      cannot reach. Getting it wrong is silent - the receiver listens to the
+      pins the property names, not the ones pinctrl muxed.
+
+      PDM_IN2 and PDM_IN3 have no such mux - they exist only on IO36 and IO34
+      - so lines three and four are pinctrl alone and are unaffected by this
+      property.
+
+required:
+  - compatible
+  - clocks
+  - clock-names
+  - dmas
+  - dma-names
+
+additionalProperties: false
+
+examples:
+  - |
+    /* Two microphones sharing one data line on IO27. */
+    sound_pdm {
+        compatible = "canaan,k230-audio-pdm";
+        canaan,model = "K230_PDM";
+        clocks = <&pdm_clk>;
+        clock-names = "pdm";
+        dmas = <&pdma 1 0xfff 0 0x21>;
+        dma-names = "rx";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pdm_pins>;
+    };
+  - |
+    /* Four microphones: two data lines, IO27 and IO28, both edges. */
+    sound_pdm {
+        compatible = "canaan,k230-audio-pdm";
+        canaan,model = "K230_PDM";
+        clocks = <&pdm_clk>;
+        clock-names = "pdm";
+        dmas = <&pdma 1 0xfff 0 0x21>;
+        dma-names = "rx";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pdm_pins>;
+
+        canaan,pdm-data-lines = <2>;
+        canaan,pdm-edge = "both";
+        canaan,pdm-oversample = <64>;
+    };
+  - |
+    /*
+     * Eight microphones: all four data lines on both edges. pdm_pins has to
+     * mux IO27, IO28, IO36 and IO34, which means the external I2S
+     * microphone inputs are not available on this board.
+     */
+    sound_pdm {
+        compatible = "canaan,k230-audio-pdm";
+        canaan,model = "K230_PDM";
+        clocks = <&pdm_clk>;
+        clock-names = "pdm";
+        dmas = <&pdma 1 0xfff 0 0x21>;
+        dma-names = "rx";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pdm_pins>;
+
+        canaan,pdm-data-lines = <4>;
+        canaan,pdm-edge = "both";
+    };
diff --git a/arch/riscv/configs/k230_defconfig b/arch/riscv/configs/k230_defconfig
index 369cd24be..4891482c9 100644
--- a/arch/riscv/configs/k230_defconfig
+++ b/arch/riscv/configs/k230_defconfig
@@ -299,4 +299,5 @@ CONFIG_CANAAN_SND_DESIGNWARE_PCM=y
 CONFIG_SND_SOC_K230_INNO=y
 CONFIG_SND_SOC_CANAAN_K230_INNO=y
 CONFIG_SND_SOC_CANAAN_K230_AUDIO=y
+CONFIG_SND_SOC_CANAAN_K230_PDM=y
 CONFIG_K230_PERIDMA=y
diff --git a/drivers/dma/k230_peridma.c b/drivers/dma/k230_peridma.c
index 9867ccba3..ca9ffa400 100755
--- a/drivers/dma/k230_peridma.c
+++ b/drivers/dma/k230_peridma.c
@@ -35,6 +35,14 @@
 #define PPAUSE_INT 0x00010000
 #define PTOUT_INT 0x01000000
 
+/*
+ * All four sources of one channel. Both PDMA_INT_MASK and PDMA_INT_STAT lay the
+ * channels out the same way - done in bits[7:0], node in [15:8], pause in
+ * [23:16], device timeout in [31:24] - so one shifted constant addresses a
+ * whole channel in either register (TRM 2.5.1, PDMA_INT_MASK / PDMA_INT_STATUS).
+ */
+#define PALL_INT (PDONE_INT | PITEM_INT | PPAUSE_INT | PTOUT_INT)
+
 /* llt structure */
 struct pdma_llt_t {
 	u32 line_size : 30;
@@ -324,16 +332,17 @@ static inline bool peridma_pchan_is_paused(struct k230_peridma_pchan *pchan)
 //	vchan_free_chan_resources(&pvchan->vchan);
 // }
 
+/*
+ * PDMA_INT_STAT is write-one-to-clear, so only the bits belonging to this
+ * channel may be written: reading the register and writing the value back -
+ * which is what this used to do - also wipes whatever another channel had just
+ * latched, losing its interrupt.
+ */
 static inline void peridma_pchan_irq_clear(struct k230_peridma_pchan *pchan)
 {
 	struct k230_peridma_dev *pdev = pchan->pdev;
-	u32 reg;
-	u32 ch_id = pchan->id;
-	u32 clear = PDONE_INT | PITEM_INT | PPAUSE_INT | PTOUT_INT;
 
-	reg = ioread32(pdev->base + PDMA_INT_STAT);
-	reg |= (clear << ch_id);
-	iowrite32(reg, pdev->base + PDMA_INT_STAT);
+	iowrite32(PALL_INT << pchan->id, pdev->base + PDMA_INT_STAT);
 }
 
 static inline void peridma_pchan_irq_enable(struct k230_peridma_pchan *pchan)
@@ -342,6 +351,10 @@ static inline void peridma_pchan_irq_enable(struct k230_peridma_pchan *pchan)
 	u32 reg;
 	u32 ch_id = pchan->id;
 
+	reg = ioread32(pdev->base + PDMA_INT_MASK);
+	reg &= ~(PALL_INT << ch_id);
+	iowrite32(reg, pdev->base + PDMA_INT_MASK);
+
 	reg = ioread32(pdev->base + PDMA_CH_EN);
 	reg |= (1 << ch_id);
 	iowrite32(reg, pdev->base + PDMA_CH_EN);
@@ -356,6 +369,10 @@ static inline void peridma_pchan_irq_disable(struct k230_peridma_pchan *pchan)
 	reg = ioread32(pdev->base + PDMA_CH_EN);
 	reg &= (~(1 << ch_id));
 	iowrite32(reg, pdev->base + PDMA_CH_EN);
+
+	reg = ioread32(pdev->base + PDMA_INT_MASK);
+	reg |= (PALL_INT << ch_id);
+	iowrite32(reg, pdev->base + PDMA_INT_MASK);
 }
 
 static inline void peridma_pchan_start(struct k230_peridma_pchan *pchan)
@@ -395,8 +412,19 @@ static void k230_peridma_hw_init(struct k230_peridma_dev *pdev)
 	u32 i;
 
 	iowrite32(0, pdev->base + PDMA_CH_EN);
-	iowrite32(0, pdev->base + PDMA_INT_MASK);
-	iowrite32(0, pdev->base + PDMA_INT_STAT);
+
+	/*
+	 * Shield every channel until one is handed out, and unshield it in
+	 * peridma_pchan_irq_enable(). The mask is active high and resets to
+	 * zero, so leaving it alone - or zeroing it, as this used to - lets a
+	 * channel nobody owns raise the shared PDMA_ALL_CHANNEL interrupt.
+	 *
+	 * The status register is write-one-to-clear, so clearing the latches
+	 * left over from whatever ran before Linux means writing ones, not the
+	 * zero that was here before and did nothing at all.
+	 */
+	iowrite32(GENMASK(31, 0), pdev->base + PDMA_INT_MASK);
+	iowrite32(GENMASK(31, 0), pdev->base + PDMA_INT_STAT);
 
 	for (i = 0; i < pdev->nr_channels; i++)
 		peridma_pchan_stop(&pdev->pchan[i]);
@@ -455,6 +483,31 @@ static enum ch_dev_hsize_t slave_buswidth_to_hsize(enum dma_slave_buswidth buswi
 	return hsize;
 }
 
+/*
+ * Beats per burst on the peripheral side. The field counts from zero - 0x0 is
+ * a single burst, 0xf is burst 16 (TRM 2.5.1, CHx_CFG chx_dev_blen) - so eight
+ * beats is PBURST_LEN_8 == 7.
+ *
+ * Which value suits a peripheral is the peripheral's business, and that is what
+ * dma_slave_config::maxburst is for; hardcoding eight left a peripheral that
+ * wants a shorter burst no way to ask for one. PDM wants one: its FIFO gains a
+ * single word per sample per data line, so the longer a burst is the longer the
+ * channel is then left waiting on DataReq, and chx_dev_tout allows it only
+ * 0xfff bus cycles of that before it gives up on the transfer.
+ *
+ * Eight stays as both the ceiling and the value used when a peripheral asks for
+ * nothing, so a driver that never sets maxburst behaves as before. I2S does set
+ * it, to four, and so changes: its threshold is half of a sixteen-entry FIFO,
+ * which four fits with a margin where eight sat exactly on the boundary.
+ */
+static enum pdma_burst_len_e peridma_burst_len(u32 maxburst)
+{
+	if (!maxburst || maxburst > 8)
+		maxburst = 8;
+
+	return (enum pdma_burst_len_e)(maxburst - 1);
+}
+
 static struct k230_peridma_hwdesc *
 generate_hwdesc(struct k230_peridma_vchan *vchan, dma_addr_t src,
 		dma_addr_t dest, size_t len, struct dma_slave_config *sconfig,
@@ -481,19 +534,26 @@ generate_hwdesc(struct k230_peridma_vchan *vchan, dma_addr_t src,
 		hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_dev_hsize = hsize;
 	}
 	hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_dat_endian = 0;
-	hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_dev_blen = PBURST_LEN_8;
+	hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_dev_blen =
+		peridma_burst_len(dir == DMA_MEM_TO_DEV ? sconfig->dst_maxburst :
+							 sconfig->src_maxburst);
 	hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_priority = vchan->priority;
 	hwdesc->usr_pdma_chn_cfg.pdma_ch_cfg.ch_dev_tout = vchan->dev_tout;
 
-	/* Validate DMA addresses are within DDR range 0x9140f1c0 是特殊值*/
-	if ( (!k230_dma_addr_in_ddr_or_register(src, len,0x9140f000,0x91410000)) && (0x9140f1c0 != src )) {
+	/*
+	 * Validate DMA addresses are within DDR range.
+	 *
+	 * FIFO 寄存器要单独放行：范围检查用的是 addr+len，而 FIFO 是一个固定地址
+	 * 反复读写、len 是整个传输的长度，所以 addr+len 必然冲出寄存器窗口。
+	 */
+	if ( (!k230_dma_addr_in_ddr_or_register(src, len,0x9140f000,0x91410000)) &&
+	     (K230_I2S_RXDMA_ADDR != src) && (K230_PDM_RXDMA_ADDR != src)) {
 		dev_err(vchan2dev(vchan),
 			"pdma: src DMA addr 0x%pad len 0x%zx out of DDR range [0x%lx-0x%lx]\n",
 			&src, len, K230_DDR_PHYS_START, K230_DDR_PHYS_END);
 		goto err_exit;
 	}
-	//0x9140f1c8是个特殊值
-	if ( (!k230_dma_addr_in_ddr_or_register(dest, len,0x9140f000, 0x91410000)) && (0x9140f1c8 != dest)) {
+	if ( (!k230_dma_addr_in_ddr_or_register(dest, len,0x9140f000, 0x91410000)) && (K230_I2S_TXDMA_ADDR != dest)) {
 		dev_err(vchan2dev(vchan),
 			"pdma: dst DMA addr 0x%pad len 0x%zx out of DDR range [0x%lx-0x%lx]\n",
 			&dest, len, K230_DDR_PHYS_START, K230_DDR_PHYS_END);
@@ -984,21 +1044,6 @@ static void k230_peridma_issue_pending(struct dma_chan *dchan)
 	spin_unlock_irqrestore(&vchan->vchan.lock, flags);
 }
 
-static void _pdma_chn_state_clear(enum pdma_ch_e pdma_chn, u32 *int_state)
-{
-	if (*int_state & (1 << pdma_chn))
-		*int_state |= (PDONE_INT << pdma_chn);
-
-	if (*int_state & (1 << (8 + pdma_chn)))
-		*int_state |= (PITEM_INT << pdma_chn);
-
-	if (*int_state & (1 << (16 + pdma_chn)))
-		*int_state |= (PPAUSE_INT << pdma_chn);
-
-	if (*int_state & (1 << (24 + pdma_chn)))
-		*int_state |= (PTOUT_INT << pdma_chn);
-}
-
 static irqreturn_t k230_peridma_interrupt(int irq, void *dev_id)
 {
 	struct k230_peridma_dev *priv = dev_id;
@@ -1010,21 +1055,61 @@ static irqreturn_t k230_peridma_interrupt(int irq, void *dev_id)
 	u32 int_stat = 0;
 
 	int_stat = ioread32(priv->base + PDMA_INT_STAT);
+	if (!int_stat)
+		return IRQ_NONE;
+
+	/*
+	 * Write every asserted bit back before looking at any of them.
+	 *
+	 * The status register is write-one-to-clear and all eight channels share
+	 * one level-triggered line (PDMA_ALL_CHANNEL, TRM 2.5.1), so a latch
+	 * left standing re-asserts the interrupt the instant this returns. Only
+	 * the transfer-done bits used to be cleared, and only when one of them
+	 * was set; a lone node, pause or device-timeout latch therefore locked
+	 * the machine up in a loop with no chance to print why.
+	 *
+	 * Clearing up front also means a source that asserts again while the
+	 * descriptor below is being advanced is not swallowed.
+	 */
+	iowrite32(int_stat, priv->base + PDMA_INT_STAT);
 
 	for (i = 0; i < CH_NUM; i++) {
-		if ((int_stat >> i) & 0x1) {
-			_pdma_chn_state_clear(i, &int_stat);
-			iowrite32(int_stat, priv->base + PDMA_INT_STAT);
-			g_pdma_llt_list[i].use = false;
-		} else {
+		u32 ch_stat = int_stat & (PALL_INT << i);
+
+		if (!ch_stat)
+			continue;
+
+		if (!(ch_stat & (PDONE_INT << i))) {
+			/*
+			 * Nothing finished, so there is no descriptor to
+			 * advance. A device timeout means the peripheral stopped
+			 * asserting DataReq for chx_dev_tout cycles and the
+			 * transfer was stopped underneath us - a burst length or
+			 * FIFO trigger level that does not suit the peripheral,
+			 * a clock that is not running, pins that are not muxed.
+			 * The stream sees it as an underrun; say what it really
+			 * was so the two can be told apart.
+			 */
+			dev_warn_ratelimited(priv->dev,
+					     "ch%d: status %#x without transfer done%s\n",
+					     i, ch_stat,
+					     (ch_stat & (PTOUT_INT << i)) ?
+						     " (device timeout)" : "");
 			continue;
 		}
+
+		g_pdma_llt_list[i].use = false;
 		ch_id = i;
 		vchan = priv->pchan[ch_id].vchan;
 		if (vchan == NULL)
-			return IRQ_HANDLED;
+			continue;
 
 		spin_lock(&vchan->vchan.lock);
+		if (!vchan->desc) {
+			/* Raced with terminate_all(); nothing left to advance. */
+			spin_unlock(&vchan->vchan.lock);
+			continue;
+		}
 		//dev_vdbg(vchan2dev(vchan),
 		//"k230_peridma_interrupt: process Transfer done irq of phy ch%d, int_status(%x)\n",
 		//ch_id, int_stat0);
diff --git a/include/linux/soc/canaan/k230-dma-addr.h b/include/linux/soc/canaan/k230-dma-addr.h
index b9989efc3..06f547bbb 100755
