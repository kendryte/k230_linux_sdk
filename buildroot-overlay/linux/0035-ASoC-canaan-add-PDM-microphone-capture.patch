+/* ------------------------------------------------------------------ */
+/* platform driver                                                    */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Everything below is optional and defaults to the most common wiring: one
+ * data line on IO27, both clock edges sampled (so two microphones), 64x
+ * oversampling. A board that matches that only needs the pin control group and
+ * the node itself.
+ */
+static int k230_pdm_parse_dt(struct k230_pdm *pdm)
+{
+	struct device_node *np = pdm->dev->of_node;
+	const char *s;
+	u32 val;
+	int ret;
+
+	pdm->data_lines = 1;
+	pdm->edge = AUDIO_IN_PDM_BOTH;
+	pdm->oversample = AUDIO_PDM_OVERSAMPLE_64;
+	pdm->use_io35_37 = false;
+
+	ret = of_property_read_u32(np, "canaan,pdm-data-lines", &val);
+	if (!ret) {
+		if (val < 1 || val > K230_PDM_MAX_DATA_LINES) {
+			dev_err(pdm->dev,
+				"invalid 'canaan,pdm-data-lines' value %u\n",
+				val);
+			return -EINVAL;
+		}
+		pdm->data_lines = val;
+	} else if (ret != -EINVAL) {
+		return ret;
+	}
+
+	ret = of_property_read_string(np, "canaan,pdm-edge", &s);
+	if (!ret) {
+		if (!strcmp(s, "both"))
+			pdm->edge = AUDIO_IN_PDM_BOTH;
+		else if (!strcmp(s, "rising"))
+			pdm->edge = AUDIO_IN_PDM_RISING;
+		else if (!strcmp(s, "falling"))
+			pdm->edge = AUDIO_IN_PDM_FAILING;
+		else {
+			dev_err(pdm->dev,
+				"invalid 'canaan,pdm-edge' value '%s'\n", s);
+			return -EINVAL;
+		}
+	} else if (ret != -EINVAL) {
+		return ret;
+	}
+
+	ret = of_property_read_u32(np, "canaan,pdm-oversample", &val);
+	if (!ret) {
+		switch (val) {
+		case 32:
+			pdm->oversample = AUDIO_PDM_OVERSAMPLE_32;
+			break;
+		case 64:
+			pdm->oversample = AUDIO_PDM_OVERSAMPLE_64;
+			break;
+		case 128:
+			pdm->oversample = AUDIO_PDM_OVERSAMPLE_128;
+			break;
+		default:
+			dev_err(pdm->dev,
+				"invalid 'canaan,pdm-oversample' value %u\n",
+				val);
+			return -EINVAL;
+		}
+	} else if (ret != -EINVAL) {
+		return ret;
+	}
+
+	ret = of_property_read_string(np, "canaan,pdm-io-group", &s);
+	if (!ret) {
+		if (!strcmp(s, "io27-28"))
+			pdm->use_io35_37 = false;
+		else if (!strcmp(s, "io35-37"))
+			pdm->use_io35_37 = true;
+		else {
+			dev_err(pdm->dev,
+				"invalid 'canaan,pdm-io-group' value '%s'\n", s);
+			return -EINVAL;
+		}
+	} else if (ret != -EINVAL) {
+		return ret;
+	}
+
+	/*
+	 * Both edges give two microphones per line, so this is at most
+	 * K230_PDM_MAX_DATA_LINES * 2 == K230_PDM_MAX_CHANNELS. No combination
+	 * the checks above let through can overflow accum[].
+	 */
+	pdm->max_channels = pdm->data_lines *
+			    (pdm->edge == AUDIO_IN_PDM_BOTH ? 2 : 1);
+
+	return 0;
+}
+
+/*
+ * The PDM receiver has no CODEC of its own - the microphones are digital and
+ * hang straight off the pins - so the link is closed with a dummy.
+ */
+static const struct snd_soc_dai_link k230_pdm_dailink_template = {
+	.name = "k230-pdm",
+	.stream_name = "PDM",
+	.capture_only = 1,
+};
+
+static const struct snd_soc_card k230_pdm_card_template = {
+	.name = "K230PDM",
+	.owner = THIS_MODULE,
+	.num_links = 1,
+};
+
+static int k230_pdm_probe(struct platform_device *pdev)
+{
+	struct snd_soc_dai_link *dailink;
+	struct snd_soc_card *card;
+	struct k230_pdm *pdm;
+	int ret;
+
+	if (!pdev->dev.of_node)
+		return -EINVAL;
+
+	/*
+	 * The registers belong to the audio wrapper driver, which maps the
+	 * whole 0x9140f400 block; wait for it rather than mapping it twice.
+	 */
+	if (!audio_pdm_available())
+		return -EPROBE_DEFER;
+
+	pdm = devm_kzalloc(&pdev->dev, sizeof(*pdm), GFP_KERNEL);
+	if (!pdm)
+		return -ENOMEM;
+
+	pdm->dev = &pdev->dev;
+
+	/*
+	 * No platform_set_drvdata() here on purpose: snd_soc_register_card()
+	 * below overwrites the device's driver data with the card, so anything
+	 * stored now would silently disappear. The card's own private pointer,
+	 * set just before it is registered, is what everything else uses.
+	 */
+
+	ret = k230_pdm_parse_dt(pdm);
+	if (ret)
+		return ret;
+
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	pdm->clk = devm_clk_get(&pdev->dev, "pdm");
+	if (IS_ERR(pdm->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(pdm->clk),
+				     "failed to get pdm clock\n");
+
+	ret = clk_prepare_enable(pdm->clk);
+	if (ret)
+		return ret;
+
+	pdm->chan = dma_request_chan(&pdev->dev, "rx");
+	if (IS_ERR(pdm->chan)) {
+		ret = dev_err_probe(&pdev->dev, PTR_ERR(pdm->chan),
+				    "failed to get rx DMA channel\n");
+		goto err_clk;
+	}
+
+	/*
+	 * Say which pins feed the first two data lines. This is a mux inside
+	 * the audio block rather than in the pin controller, so the device tree
+	 * cannot express it the way it expresses the rest of the pin setup.
+	 * Picking IO35/IO37 costs the board its I2S output data on those pins;
+	 * picking IO27/IO28 costs nothing, and is what the I2S card programs
+	 * anyway. See audio_pdm_input_select().
+	 */
+	audio_pdm_input_select(pdm->use_io35_37);
+
+	/* Leave the receiver stopped until a stream starts. */
+	audio_pdm_in_init(pdm->oversample, 0, pdm->edge, AUDIO_IN_RIGHT_ALIGN,
+			  K230_PDM_FIFO_TRIGGER);
+
+	ret = devm_snd_soc_register_component(&pdev->dev, &k230_pdm_component,
+					      &k230_pdm_dai, 1);
+	if (ret) {
+		dev_err(&pdev->dev, "failed to register component: %d\n", ret);
+		goto err_dma;
+	}
+
+	pdm->dailink = k230_pdm_dailink_template;
+	pdm->card = k230_pdm_card_template;
+	dailink = &pdm->dailink;
+	card = &pdm->card;
+
+	pdm->cpus[0].dai_name = k230_pdm_dai.name;
+	pdm->cpus[0].of_node = pdev->dev.of_node;
+	pdm->platforms[0].of_node = pdev->dev.of_node;
+	pdm->codecs[0] = snd_soc_dummy_dlc;
+
+	dailink->cpus = pdm->cpus;
+	dailink->num_cpus = ARRAY_SIZE(pdm->cpus);
+	dailink->codecs = pdm->codecs;
+	dailink->num_codecs = ARRAY_SIZE(pdm->codecs);
+	dailink->platforms = pdm->platforms;
+	dailink->num_platforms = ARRAY_SIZE(pdm->platforms);
+
+	card->dai_link = dailink;
+	card->dev = &pdev->dev;
+	snd_soc_card_set_drvdata(card, pdm);
+
+	if (of_property_read_bool(pdev->dev.of_node, "canaan,model")) {
+		ret = snd_soc_of_parse_card_name(card, "canaan,model");
+		if (ret) {
+			dev_err(&pdev->dev, "failed to parse card name: %d\n",
+				ret);
+			goto err_dma;
+		}
+	}
+
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret, "failed to register card\n");
+		goto err_dma;
+	}
+
+	dev_info(&pdev->dev,
+		 "PDM capture: %u data line(s) on %s, %s edge, %ux oversampling, up to %u channels\n",
+		 pdm->data_lines, pdm->use_io35_37 ? "IO35/IO37" : "IO27/IO28",
+		 pdm->edge == AUDIO_IN_PDM_BOTH ? "both" :
+			pdm->edge == AUDIO_IN_PDM_RISING ? "rising" : "falling",
+		 k230_pdm_oversample_factor(pdm), pdm->max_channels);
+
+	return 0;
+
+err_dma:
+	dma_release_channel(pdm->chan);
+err_clk:
+	clk_disable_unprepare(pdm->clk);
+
+	return ret;
+}
+
+static int k230_pdm_remove(struct platform_device *pdev)
+{
+	/* The card owns the device's driver data; see k230_pdm_probe(). */
+	struct snd_soc_card *card = platform_get_drvdata(pdev);
+	struct k230_pdm *pdm = snd_soc_card_get_drvdata(card);
+
+	audio_pdm_in_init(pdm->oversample, 0, pdm->edge, AUDIO_IN_RIGHT_ALIGN,
+			  K230_PDM_FIFO_TRIGGER);
+
+	/* Give IO35 and IO37 back to the I2S transmitter. */
+	audio_pdm_input_select(false);
+
+	dma_release_channel(pdm->chan);
+	clk_disable_unprepare(pdm->clk);
+
+	return 0;
+}
+
+static const struct of_device_id k230_pdm_of_match[] = {
+	{ .compatible = "canaan,k230-audio-pdm" },
+	{ /* sentinel */ },
+};
+MODULE_DEVICE_TABLE(of, k230_pdm_of_match);
+
+static struct platform_driver k230_pdm_driver = {
+	.probe = k230_pdm_probe,
+	.remove = k230_pdm_remove,
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = k230_pdm_of_match,
+	},
+};
+
+module_platform_driver(k230_pdm_driver);
+
+MODULE_DESCRIPTION("CANAAN K230 PDM capture ASoC driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" DRV_NAME);
