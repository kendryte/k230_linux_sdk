+	       vo->reg_base + VO_LAYER1_OFFSET + VO_LAYER1_ADDR_SEL_MODE);
 
 	writel(0x11,  vo->reg_base + VO_REG_LOAD_CTL);
 
@@ -475,17 +505,74 @@ void canaan_vo_disable_plane(struct canaan_vo *vo,
