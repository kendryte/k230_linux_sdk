 drivers/gpu/drm/canaan/canaan_vo.c  | 229 ++++++++++++++++++++++------
 drivers/gpu/drm/canaan/canaan_vo.h  |  13 ++
 3 files changed, 375 insertions(+), 48 deletions(-)
 mode change 100755 => 100644 drivers/gpu/drm/canaan/canaan_vo.c

diff --git a/drivers/gpu/drm/canaan/canaan_dsi.c b/drivers/gpu/drm/canaan/canaan_dsi.c
index fc45fcd..5701724 100644
--- a/drivers/gpu/drm/canaan/canaan_dsi.c
+++ b/drivers/gpu/drm/canaan/canaan_dsi.c
@@ -81,6 +81,137 @@
 #define TXPHY_475_VOC (0x17)
 #define TXPHY_475_HS_FREQ (0xa3)
 
+#define DSI_PHY_TMR_LPCLK_CFG	0x98
+#define DSI_PHY_TMR_CFG		0x9c
+#define DSI_PHY_TMR_RD_CFG	0xf4
+
+#define TO_CLK_DIVISION(div)		(((div) & 0xff) << 8)
+#define TX_ESC_CLK_DIVISION(div)	((div) & 0xff)
+#define PHY_HS2LP_TIME_V131(lbcc)	(((lbcc) & 0x3ff) << 16)
+#define PHY_LP2HS_TIME_V131(lbcc)	((lbcc) & 0x3ff)
+#define PHY_CLKHS2LP_TIME(lbcc)		(((lbcc) & 0x3ff) << 16)
+#define PHY_CLKLP2HS_TIME(lbcc)		((lbcc) & 0x3ff)
+#define MAX_RD_TIME_V131(lbcc)		((lbcc) & 0x7fff)
+/*
+ * DPI_COLOR_CODING[3:0] = colour depth; 0x5 selects 24-bit RGB888.  bit8
+ * (loosely-18 packing) applies only to the 18-bit codings and is left clear
+ * for 24-bit, so the coding value is 0x5 (not 0x105).
+ */
+#define DPI_COLOR_CODING_24BIT		0x5
+
+struct canaan_dsi_hsfreq_range {
+	u64 min_freq;
+	u64 max_freq;
+	u8 hsfreqrange;
+};
+
+/*
+ * Sorted by descending min_freq.  canaan_dsi_calc_hsfreqrange() returns the
+ * first row whose [min_freq, max_freq] contains the bit rate, so new rows must
+ * keep this order (the high rows deliberately share max_freq = 2500 Mbps).
+ */
+static const struct canaan_dsi_hsfreq_range canaan_hsfreq_ranges[] = {
+	{ 2363125000ULL, 2500000000ULL, 0x49 }, { 2315625000ULL, 2500000000ULL, 0x48 }, { 2268125000ULL, 2500000000ULL, 0x47 },
+	{ 2220625000ULL, 2480625000ULL, 0x46 }, { 2173125000ULL, 2428125000ULL, 0x45 }, { 2125625000ULL, 2375625000ULL, 0x44 },
+	{ 2078125000ULL, 2323125000ULL, 0x43 }, { 2030625000ULL, 2270625000ULL, 0x42 }, { 1983125000ULL, 2218125000ULL, 0x41 },
+	{ 1935625000ULL, 2165625000ULL, 0x40 }, { 1888125000ULL, 2113125000ULL, 0x0F }, { 1840625000ULL, 2060625000ULL, 0x3F },
+	{ 1793125000ULL, 2008125000ULL, 0x2F }, { 1745625000ULL, 1955625000ULL, 0x1E }, { 1698125000ULL, 1903125000ULL, 0x0E },
+	{ 1650625000ULL, 1850625000ULL, 0x3E }, { 1603125000ULL, 1798125000ULL, 0x2E }, { 1555625000ULL, 1745625000ULL, 0x1D },
+	{ 1508125000ULL, 1693125000ULL, 0x0D }, { 1460625000ULL, 1640625000ULL, 0x3D }, { 1413125000ULL, 1588125000ULL, 0x2C },
+	{ 1365625000ULL, 1535625000ULL, 0x1C }, { 1318125000ULL, 1483125000ULL, 0x0C }, { 1270625000ULL, 1430625000ULL, 0x3C },
+	{ 1223125000ULL, 1378125000ULL, 0x2B }, { 1175625000ULL, 1325625000ULL, 0x1B }, { 1128125000ULL, 1273125000ULL, 0x0B },
+	{ 1080625000ULL, 1220625000ULL, 0x3B }, { 1033125000ULL, 1168125000ULL, 0x2A }, { 985625000ULL, 1115625000ULL, 0x1A },
+	{ 938125000ULL, 1063125000ULL, 0x0A },  { 890625000ULL, 1010625000ULL, 0x3A },  { 843125000ULL, 958125000ULL, 0x29 },
+	{ 795625000ULL, 905625000ULL, 0x19 },   { 748125000ULL, 853125000ULL, 0x09 },   { 700625000ULL, 800625000ULL, 0x39 },
+	{ 653125000ULL, 748125000ULL, 0x28 },   { 605625000ULL, 695625000ULL, 0x18 },   { 558125000ULL, 643125000ULL, 0x07 },
+	{ 510625000ULL, 590625000ULL, 0x37 },   { 463125000ULL, 538125000ULL, 0x26 },   { 415625000ULL, 485625000ULL, 0x16 },
+	{ 368125000ULL, 433125000ULL, 0x05 },   { 320625000ULL, 380625000ULL, 0x35 },   { 296875000ULL, 354375000ULL, 0x25 },
+	{ 273125000ULL, 328125000ULL, 0x14 },   { 249375000ULL, 301875000ULL, 0x04 },   { 225625000ULL, 275625000ULL, 0x33 },
+	{ 211375000ULL, 259875000ULL, 0x23 },   { 197125000ULL, 244125000ULL, 0x13 },   { 182875000ULL, 228375000ULL, 0x03 },
+	{ 168625000ULL, 212625000ULL, 0x32 },   { 159125000ULL, 202125000ULL, 0x22 },   { 149625000ULL, 191625000ULL, 0x12 },
+	{ 140125000ULL, 181125000ULL, 0x02 },   { 130625000ULL, 170625000ULL, 0x31 },   { 121125000ULL, 160125000ULL, 0x21 },
+	{ 111625000ULL, 149625000ULL, 0x11 },   { 102125000ULL, 139125000ULL, 0x01 },   { 92625000ULL, 128625000ULL, 0x30 },
+	{ 83125000ULL, 118125000ULL, 0x20 },    { 80000000ULL, 107625000ULL, 0x10 },    { 80000000ULL, 97125000ULL, 0x00 },
+};
+
+static u8 canaan_dsi_calc_hsfreqrange(u64 bitrate_hz)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(canaan_hsfreq_ranges); i++) {
+		if (bitrate_hz >= canaan_hsfreq_ranges[i].min_freq &&
+		    bitrate_hz <= canaan_hsfreq_ranges[i].max_freq)
+			return canaan_hsfreq_ranges[i].hsfreqrange;
+	}
+
+	pr_warn("canaan-dsi: lane bitrate %llu Hz out of hsfreqrange table (80-2500 Mbps); using code 0x00\n",
+		bitrate_hz);
+	return 0;
+}
+
+/*
+ * D-PHY LP<->HS transition timings: lane rate (Mbps) -> cycle counts.
+ * Verbatim from RT-Smart dphy_timings[]; nearest-rate entry is selected.
+ */
+struct canaan_dsi_dphy_timing {
+	u32 rate_mbps;
+	u16 clk_lp2hs;
+	u16 clk_hs2lp;
+	u16 data_lp2hs;
+	u16 data_hs2lp;
+};
+
+static const struct canaan_dsi_dphy_timing canaan_dphy_timings[] = {
+	{ 80, 21, 17, 15, 10 },     { 90, 23, 17, 16, 10 },     { 100, 22, 17, 16, 10 },
+	{ 110, 25, 18, 17, 11 },    { 120, 26, 20, 18, 11 },    { 130, 27, 19, 19, 11 },
+	{ 140, 27, 19, 19, 11 },    { 150, 28, 20, 20, 12 },    { 160, 30, 21, 22, 13 },
+	{ 170, 30, 21, 23, 13 },    { 180, 31, 21, 23, 13 },    { 190, 32, 22, 24, 13 },
+	{ 205, 35, 22, 25, 13 },    { 220, 37, 26, 27, 15 },    { 235, 38, 28, 27, 16 },
+	{ 250, 41, 29, 30, 17 },    { 275, 43, 29, 32, 18 },    { 300, 45, 32, 35, 19 },
+	{ 325, 48, 33, 36, 18 },    { 350, 51, 35, 40, 20 },    { 400, 59, 37, 44, 21 },
+	{ 450, 65, 40, 49, 23 },    { 500, 71, 41, 54, 24 },    { 550, 77, 44, 57, 26 },
+	{ 600, 82, 46, 64, 27 },    { 650, 87, 48, 67, 28 },    { 700, 94, 52, 71, 29 },
+	{ 750, 99, 52, 75, 31 },    { 800, 105, 55, 82, 32 },   { 850, 110, 58, 85, 32 },
+	{ 900, 115, 58, 88, 35 },   { 950, 120, 62, 93, 36 },   { 1000, 128, 63, 99, 38 },
+	{ 1050, 132, 65, 102, 38 }, { 1100, 138, 67, 106, 39 }, { 1150, 146, 69, 112, 42 },
+	{ 1200, 151, 71, 117, 43 }, { 1250, 153, 74, 120, 45 }, { 1300, 160, 73, 124, 46 },
+	{ 1350, 165, 76, 130, 47 }, { 1400, 172, 78, 134, 49 }, { 1450, 177, 80, 138, 49 },
+	{ 1500, 183, 81, 143, 52 }, { 1550, 191, 84, 147, 52 }, { 1600, 194, 85, 152, 52 },
+	{ 1650, 201, 86, 155, 53 }, { 1700, 208, 88, 161, 53 }, { 1750, 212, 89, 165, 53 },
+	{ 1800, 220, 90, 171, 54 }, { 1850, 223, 92, 175, 54 }, { 1900, 231, 91, 180, 55 },
+	{ 1950, 236, 95, 185, 56 }, { 2000, 243, 97, 190, 56 }, { 2050, 248, 99, 194, 58 },
+	{ 2100, 252, 100, 199, 59 },{ 2150, 259, 102, 204, 61 },{ 2200, 266, 105, 210, 62 },
+	{ 2250, 269, 109, 213, 63 },{ 2300, 272, 109, 217, 65 },{ 2350, 281, 112, 225, 66 },
+	{ 2400, 283, 115, 226, 66 },{ 2450, 282, 115, 226, 67 },{ 2500, 281, 118, 227, 67 },
+};
+
+static void canaan_dsi_get_dphy_timing(u32 lane_mbps,
+				       struct canaan_dsi_dphy_timing *out)
+{
+	u32 min_diff = 0xffffffffU;
+	int i, best = -1;
+
+	for (i = 0; i < ARRAY_SIZE(canaan_dphy_timings); i++) {
+		u32 rate = canaan_dphy_timings[i].rate_mbps;
+		u32 diff = lane_mbps > rate ? lane_mbps - rate : rate - lane_mbps;
+
+		if (diff < min_diff) {
+			min_diff = diff;
+			best = i;
+		}
+	}
+
+	if (best < 0) {
+		/*
+		 * Only reachable if the table is emptied by a future edit; keep
+		 * *out zeroed instead of dereferencing canaan_dphy_timings[-1].
+		 */
+		memset(out, 0, sizeof(*out));
+		return;
+	}
+	*out = canaan_dphy_timings[best];
+}
+
 static inline void dsi_write(struct canaan_dsi *dsi, u32 reg, u32 val)
 {
 	writel(val, dsi->base + reg);
@@ -257,8 +388,29 @@ static void canaan_dsi_set_dpi_timing(struct canaan_dsi *dsi,
 
 void canaan_dsi_lpdt_init(struct canaan_dsi *dsi, struct drm_display_mode *mode)
 {
+	/*
+	 * ESC/timeout clock dividers, computed from the lane byte clock like
+	 * RT-Smart (dwc_dsi_init) instead of the former hardcoded 0x108.
+	 * esc_rate = 20 MHz (max ESC clock), to_rate = 1 MHz.
+	 */
+	u32 lane_mbps = dsi->phy_freq / 1000;
+	u32 lane_byte_mbps = lane_mbps / 8;
+	u32 esc_rate = 20;
+	u32 esc_div = lane_byte_mbps ? (lane_byte_mbps + esc_rate - 1) / esc_rate : 1;
+	u32 to_div = lane_byte_mbps ? lane_byte_mbps : 1;
+
+	/*
+	 * TO_CLK_DIVISION is 8-bit.  Above ~2048 Mbps the lane byte clock exceeds
+	 * 255 MHz, and clamping the divider makes the timeout clock slightly
+	 * faster than its nominal 1 MHz (a shorter timeout) -- an intentional,
+	 * harmless trade-off for our panels.
+	 */
+	if (to_div > 255)
+		to_div = 255;
+
 	// set lpdt div
-	dsi_write(dsi, CLKMGR_CFG, 0x108);
+	dsi_write(dsi, CLKMGR_CFG,
+		  TO_CLK_DIVISION(to_div) | TX_ESC_CLK_DIVISION(esc_div));
 	// set vcid
 	dsi_write(dsi, GEN_VCID, 0x303);
 	// stt dpi tinging
@@ -285,9 +437,22 @@ void canaan_dsi_lpdt_init(struct canaan_dsi *dsi, struct drm_display_mode *mode)
 
 static void canaan_mipi_dsi_set_dsi_enable(struct canaan_dsi *dsi)
 {
-	dsi_write(dsi, DPI_COLOR_CODING, 0x105);
-	dsi_write(dsi, 0x9c, 0x320068);
-	dsi_write(dsi, 0x98, 0x2e0080);
+	struct canaan_dsi_dphy_timing t;
+	u32 lane_mbps = dsi->phy_freq / 1000;
+	u32 data_lp2hs;
+
+	/* D-PHY LP<->HS timings from the lane rate, like RT-Smart. */
+	canaan_dsi_get_dphy_timing(lane_mbps, &t);
+	data_lp2hs = t.data_lp2hs + t.clk_lp2hs;
+
+	dsi_write(dsi, DPI_COLOR_CODING, DPI_COLOR_CODING_24BIT);
+	dsi_write(dsi, DSI_PHY_TMR_CFG,
+		  PHY_HS2LP_TIME_V131(t.data_hs2lp) |
+			  PHY_LP2HS_TIME_V131(data_lp2hs));
+	dsi_write(dsi, DSI_PHY_TMR_RD_CFG, MAX_RD_TIME_V131(10000));
+	dsi_write(dsi, DSI_PHY_TMR_LPCLK_CFG,
+		  PHY_CLKHS2LP_TIME(t.clk_hs2lp) |
+			  PHY_CLKLP2HS_TIME(t.clk_lp2hs));
 	dsi_write(dsi, 0xc4, 0xffffffff);
 	dsi_write(dsi, 0xc8, 0xffffffff);
 	dsi_write(dsi, MODE_CFG, 0x0);
@@ -380,7 +545,13 @@ static int canaan_dsi_clk_cfg(struct canaan_dsi *dsi, u32 clk)
 	writel(val, dis_clk + 0x78);
 	iounmap(dis_clk);
 
-	k230_dsi_config_4lan_phy(dsi, m - 2, n - 1, voc, 0x96);
+	/*
+	 * hsfreqrange from the DDR bit rate (dsi->phy_freq is in kHz) like
+	 * RT-Smart (0x80 | hsfreqrange), replacing the hardcoded 0x96.
+	 */
+	k230_dsi_config_4lan_phy(dsi, m - 2, n - 1, voc,
+				 0x80 | canaan_dsi_calc_hsfreqrange(
+						(u64)dsi->phy_freq * 1000));
 
 	return 0;
 }
