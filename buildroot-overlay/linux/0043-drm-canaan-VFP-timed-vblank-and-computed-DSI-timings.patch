+/*
+ * Program a plane's frame base directly from the atomic commit.  The base
+ * registers are not GO-gated: hardware samples them at the layer's latch point
+ * (video2/3 and OSD at the frame top, video1/RDMA a little before the frame
+ * end).  Writing them here, long before any latch point, keeps all layers in
+ * step; the VFP timer then only reports the vblank.  Both base slots are set to
+ * the same address so every layer runs as a single buffer.
+ *
+ * The multi-register write can, very rarely, race the latch and produce a
+ * single-frame chroma tear (both buffers are valid, so it self-heals).
+ */
+static void canaan_vo_write_base(struct canaan_vo *vo,
+				 struct canaan_plane *canaan_plane,
+				 dma_addr_t base0, dma_addr_t base1)
+{
+	uint32_t off = canaan_plane->config->plane_offset;
+
+	/* Same layer dispatch as canaan_vo_update_plane(). */
+	if (vo->canaan_plane[0]->id == canaan_plane->id ||
+	    vo->canaan_plane[5]->id == canaan_plane->id) {		/* video2/3 */
+		writel(base0, vo->reg_base + off + VO_LAYER2_3_Y_ADDR0_REG_OFFSET);
+		writel(base0, vo->reg_base + off + VO_LAYER2_3_Y_ADDR1_REG_OFFSET);
+		writel(base1, vo->reg_base + off + VO_LAYER2_3_UV_ADDR0_REG_OFFSET);
+		writel(base1, vo->reg_base + off + VO_LAYER2_3_UV_ADDR1_REG_OFFSET);
+	} else if (vo->canaan_plane[6]->id == canaan_plane->id) {	/* RDMA layer1 */
+		writel(base0, vo->reg_base + off + VO_LAYER1_Y_ADDR0);
+		writel(base0, vo->reg_base + off + VO_LAYER1_Y_ADDR1);
+		writel(base1, vo->reg_base + off + VO_LAYER1_UV_ADDR0);
+		writel(base1, vo->reg_base + off + VO_LAYER1_UV_ADDR1);
+	} else {							/* osd */
+		writel(base0, vo->reg_base + off + VO_OSD0_7_VLU_ADDR0_REG_OFFSET);
+		writel(base0, vo->reg_base + off + VO_OSD0_7_ALP_ADDR0_REG_OFFSET);
+		writel(base0, vo->reg_base + off + VO_OSD0_7_VLU_ADDR1_REG_OFFSET);
+		writel(base0, vo->reg_base + off + VO_OSD0_7_ALP_ADDR1_REG_OFFSET);
+	}
+}
+
 static void canaan_vo_update_video(struct canaan_vo *vo,
 				   struct canaan_plane *canaan_plane,
 				   struct drm_display_mode *adj_mode)
@@ -153,16 +193,8 @@ static void canaan_vo_update_video(struct canaan_vo *vo,
 	writel(reg_val, vo->reg_base + yctl_reg_offset);
 
 	y_addr = scanout_addr[0];
-	writel(y_addr,
-	       vo->reg_base + plane_offset + VO_LAYER2_3_Y_ADDR0_REG_OFFSET);
-	writel(y_addr,
-	       vo->reg_base + plane_offset + VO_LAYER2_3_Y_ADDR1_REG_OFFSET);
-
 	uv_addr = scanout_addr[1];
-	writel(uv_addr,
-	       vo->reg_base + plane_offset + VO_LAYER2_3_UV_ADDR0_REG_OFFSET);
-	writel(uv_addr,
-	       vo->reg_base + plane_offset + VO_LAYER2_3_UV_ADDR1_REG_OFFSET);
+	canaan_vo_write_base(vo, canaan_plane, y_addr, uv_addr);
 
 	stride = (scanout_pitch[0] / 8 - 1) | (actual_h << 16);
 	writel(stride,
@@ -172,7 +204,11 @@ static void canaan_vo_update_video(struct canaan_vo *vo,
 			     VO_LAYER2_3_IMG_IN_OFFSET_REG_OFFSET);
 	writel(0x0f,
 	       vo->reg_base + plane_offset + VO_LAYER2_3_BLENTH_REG_OFFSET);
-	writel(0x11, vo->reg_base + plane_offset +
+	/*
+	 * Auto address mode (0x00): the two frame-base slots are programmed to the
+	 * same address above, so the layer runs as a single buffer.
+	 */
+	writel(0x00, vo->reg_base + plane_offset +
 			     VO_LAYER2_3_ADDR_SEL_MODE_REG_OFFSET);
 
 	disp_en = readl(vo->reg_base + VO_DISP_ENABLE);
@@ -269,14 +305,7 @@ static void canaan_vo_update_osd(struct canaan_vo *vo,
 	writel(reg_val, vo->reg_base + yctl_reg_offset);
 
 	paddr = scanout_addr[0];
-	writel(paddr,
-	       vo->reg_base + plane_offset + VO_OSD0_7_VLU_ADDR0_REG_OFFSET);
-	writel(paddr,
-	       vo->reg_base + plane_offset + VO_OSD0_7_ALP_ADDR0_REG_OFFSET);
-	writel(paddr,
-	       vo->reg_base + plane_offset + VO_OSD0_7_VLU_ADDR1_REG_OFFSET);
-	writel(paddr,
-	       vo->reg_base + plane_offset + VO_OSD0_7_ALP_ADDR1_REG_OFFSET);
+	canaan_vo_write_base(vo, canaan_plane, paddr, paddr);
 
 	stride = scanout_pitch[0] / 8;
 	writel(stride,
@@ -284,7 +313,8 @@ static void canaan_vo_update_osd(struct canaan_vo *vo,
 
 	writel(rb_swap, vo->reg_base + plane_offset + VO_OSD0_7_DMA_CTRL_REG_OFFSET);
 
-	writel(0x100, vo->reg_base + plane_offset +
+	/* Auto address mode (0x00): both base slots set equal -> single buffer. */
+	writel(0x00, vo->reg_base + plane_offset +
 			      VO_OSD0_7_ADDR_SEL_MODE_REG_OFFSET);
 
 	disp_en = readl(vo->reg_base + VO_DISP_ENABLE);
@@ -372,14 +402,8 @@ static void canaan_vo_update_layer1(struct canaan_vo *vo,
 	writel(reg_val, vo->reg_base + yctl_reg_offset);
 
 	y_addr = scanout_addr[0];
-	writel(y_addr, vo->reg_base + plane_offset + VO_LAYER1_Y_ADDR0);
-	writel(y_addr, vo->reg_base + plane_offset + VO_LAYER1_Y_ADDR1);
-
 	uv_addr = scanout_addr[1];
-	writel(uv_addr,
-	       vo->reg_base + plane_offset + VO_LAYER1_UV_ADDR0);
-	writel(uv_addr,
-	       vo->reg_base + plane_offset + VO_LAYER1_UV_ADDR1);
+	canaan_vo_write_base(vo, canaan_plane, y_addr, uv_addr);
 
 	stride = scanout_pitch[0] | (scanout_pitch[1] << 16);
 	writel(stride, vo->reg_base + plane_offset + VO_LAYER1_STRIDE);
@@ -388,7 +412,13 @@ static void canaan_vo_update_layer1(struct canaan_vo *vo,
 	disp_en |= 1 << plane_enable_bit;
 	writel(disp_en, vo->reg_base + VO_DISP_ENABLE);
 
-	writel(0x00010100, vo->reg_base + VO_LAYER1_OFFSET + VO_LAYER1_ADDR_SEL_MODE);
+	/*
+	 * LAYER1 ADDR_SEL (0xA3c): bit16 = layer-enable, rest 0 (auto address mode,
+	 * single buffer) -- same style as video2/3.  Clearing bit16 disables the
+	 * layer -> underrun / green screen.
