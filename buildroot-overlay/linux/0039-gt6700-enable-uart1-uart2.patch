+++ b/arch/riscv/boot/dts/canaan/k230-canmv-gt6700.dts
@@ -62,6 +62,12 @@ &mmc_sd1{
 &uart0 {
 	status = "okay";
 };
+&uart1 {
+	status = "okay";
+};
+&uart2 {
+	status = "okay";
+};
