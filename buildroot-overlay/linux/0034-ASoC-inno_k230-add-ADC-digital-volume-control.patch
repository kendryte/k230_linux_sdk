diff --git a/sound/soc/codecs/inno_k230_reg.h b/sound/soc/codecs/inno_k230_reg.h
index 550aa0381..fba6d0d06 100755
--- a/sound/soc/codecs/inno_k230_reg.h
+++ b/sound/soc/codecs/inno_k230_reg.h
@@ -454,10 +454,14 @@ int audio_codec_adc_set_micr_gain(int gain);
