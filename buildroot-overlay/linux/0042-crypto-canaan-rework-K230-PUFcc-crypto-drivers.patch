-
-	write_data((uint32_t *)(puf_crypto_base + CRYPTO_DGST_IN_OFFSET), dgst,
-		   length, true);
-
-	return SUCCESS;
-}
-
-void crypto_read_dgest(uint8_t *out, size_t length)
-{
-	length = length < DGST_INT_STATE_LEN ? length : DGST_INT_STATE_LEN;
-	read_data(out, (void *)(puf_crypto_base + CRYPTO_DGST_OUT_OFFSET),
-		  length, true);
