From dbb95995ebf017a8cfe64f1d2c6f6b798835dcc7 Mon Sep 17 00:00:00 2001
From: wangjianxin <wangjianxin@canaan-creative.com>
Date: Tue, 24 Nov 2026 13:39:27 +0800
Subject: [PATCH] crypto: canaan - rework K230 PUFcc crypto drivers

Rework the K230 PUFcc crypto accelerator drivers:

- Add a shared crypto engine module (kendryte-crypto-engine) that maps
  the PUFcc DMA/CRYPTO front-end once and serializes access to it. The
  hash and cipher drivers drive the same physical register block and
  previously mapped and locked it independently, so concurrent hash and
  AES-GCM requests could interleave register writes.

- Replace kendryte-aes with kendryte-cipher, which registers gcm(aes)
  and, optionally, the SP38A AES/SM4 modes (ecb/cbc/ctr/ofb/cfb). Long
  requests are chunked through the DMA buffer with the IV chained
  between chunks.

- Rework kendryte-hash: sha256 by default, with optional sha224/384/512,
  sm3 and hmac() variants.

- Rework kendryte-rsa: run the selected key sizes (RSA-2048 by default)
  on the ECP and fall back to rsa-generic for other sizes and for public
  exponents wider than 32 bits. Register at priority 50, below
  rsa-generic, since the ECP is slower than software; callers that want
  to offload the CPU ask for "kendryte-rsa" by name. Use the SEC
  interrupt when it is delivered, falling back to busy-polling
  otherwise, and describe it in k230.dtsi.

- Make every algorithm a separate Kconfig option so unused ones are not
  compiled in, and skip building a driver entirely when none of its
  algorithms is selected. Add HAS_IOMEM dependencies and keep
  COMPILE_TEST coverage.

- Document the canaan,k230-crypto, canaan,k230-hash and canaan,k230-rsa
  devicetree bindings and add a MAINTAINERS entry.
---
 arch/riscv/boot/dts/canaan/k230.dtsi          |   15 +-
 drivers/crypto/canaan/Kconfig                 |  382 ++-
 drivers/crypto/canaan/Makefile                |   20 +-
 drivers/crypto/canaan/kendryte-aes.c          | 1361 ----------
 drivers/crypto/canaan/kendryte-cipher.c       | 2262 +++++++++++++++++
 .../{kendryte-aes.h => kendryte-cipher.h}     |  214 +-
 drivers/crypto/canaan/kendryte-common.h       |  226 ++
 .../crypto/canaan/kendryte-crypto-engine.c    |  156 ++
 .../crypto/canaan/kendryte-crypto-engine.h    |   97 +
 drivers/crypto/canaan/kendryte-hash.c         | 1025 +++++---
 drivers/crypto/canaan/kendryte-hash.h         |  218 +-
 drivers/crypto/canaan/kendryte-rsa.c          | 1002 ++++++--
 drivers/crypto/canaan/kendryte-rsa.h          |   97 +-
 15 files changed, 4951 insertions(+), 2211 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/crypto/canaan,k230-crypto.yaml
 delete mode 100644 drivers/crypto/canaan/kendryte-aes.c
 create mode 100644 drivers/crypto/canaan/kendryte-cipher.c
 rename drivers/crypto/canaan/{kendryte-aes.h => kendryte-cipher.h} (54%)
 create mode 100644 drivers/crypto/canaan/kendryte-common.h
 create mode 100644 drivers/crypto/canaan/kendryte-crypto-engine.c
 create mode 100644 drivers/crypto/canaan/kendryte-crypto-engine.h

diff --git a/arch/riscv/boot/dts/canaan/k230.dtsi b/arch/riscv/boot/dts/canaan/k230.dtsi
index be6bac6cc..1555ca9a9 100755
--- a/arch/riscv/boot/dts/canaan/k230.dtsi
+++ b/arch/riscv/boot/dts/canaan/k230.dtsi
@@ -988,20 +988,31 @@ aes: aes@91210200 {
 				status = "okay";
 				compatible = "canaan,k230-crypto";
 				reg	= <0x0 0x91210200 0x0 0x0100>;
-				hardlock = <7>;
 			};
 
 			hash: hash@91210800 {
 				status = "okay";
 				compatible = "canaan,k230-hash";
 				reg = <0x0 0x91210800 0x0 0x0100>;
-				hardlock = <6>;
 			};
 
 			rsa: rsa@91211000 {
 				status = "okay";
 				compatible = "canaan,k230-rsa";
 				reg	= <0x0 0x91211000 0x0 0x1000>;
+				/*
+				 * The "SEC" line shared by the whole security
+				 * subsystem. TRM 2.4 lists it as interrupt bit
+				 * 169, but the PLIC number is offset by 16, so
+				 * the DT uses 185 (169 + 16). Only the ECP (RSA)
+				 * block unmasks it: a private-key RSA operation
+				 * takes ~245ms, and polling that out costs a full
+				 * CPU for the duration. The DMA-driven blocks
+				 * (hash, AES) complete in tens of microseconds
+				 * and keep polling, where an interrupt would cost
+				 * more than it saves.
+				 */
+				interrupts = <185 IRQ_TYPE_LEVEL_HIGH>;
 			};
 
 			trng: trng@91213000 {
diff --git a/drivers/crypto/canaan/Kconfig b/drivers/crypto/canaan/Kconfig
index de3bd7e3d..686841722 100644
--- a/drivers/crypto/canaan/Kconfig
+++ b/drivers/crypto/canaan/Kconfig
@@ -1,35 +1,363 @@
 # SPDX-License-Identifier: GPL-2.0
 #
-# k230 AES-GCM configuration
+# Canaan K230 PUFcc crypto accelerator drivers
 #
+config CRYPTO_DEV_KENDRYTE_ENGINE
+	tristate
+	help
+	  Shared DMA/CRYPTO front-end mapping and lock used by both the
+	  K230 AES-GCM and SHA256 hardware accelerator drivers, since they
+	  drive the same physical PUFcc DMA/CRYPTO register block and must
+	  serialize access to it.
+
 config CRYPTO_DEV_KENDRYTE_CRYP
-    tristate "Support for K230 crypto accelerators"
-    select CRYPTO_AES
-    select CRYPTO_BLKCIPHER
-    default ARCH_CANAAN
-    help
-        This driver interfaces with the hardware crypto
-        accelerator for K230.
-        Supporting AES-GCM encryption and
-        decryption.
+	tristate "Support for K230 AES/SM4 cipher accelerator"
+	depends on ARCH_CANAAN || COMPILE_TEST
+	depends on HAS_IOMEM
+	select CRYPTO_DEV_KENDRYTE_ENGINE
+	help
+	  This driver interfaces with the PUFcc cipher blocks of the
+	  K230: AES-GCM (SP38D) and the AES/SM4 block cipher modes
+	  (SP38A). Which algorithms it registers is chosen below, one
+	  option each; once the driver is enabled, gcm(aes) is selected
+	  by default. Algorithms left out are not compiled in at all,
+	  and with none selected the driver itself is not built.
+
+	  Off by default: nothing in the default K230 configuration
+	  calls gcm(aes) (no IPsec, kTLS, dm-crypt or AF_ALG AEAD, and
+	  the on-board WiFi drivers do their own crypto). Enable it when
+	  something does; from 256 bytes up it is several times faster
+	  than the software implementation.
+
+if CRYPTO_DEV_KENDRYTE_CRYP
+
+comment "Algorithms registered by the K230 cipher driver"
+
+config CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+	bool "gcm-aes-canaan"
+	default y
+	select CRYPTO_AEAD
+	help
+	  Register gcm-aes-canaan (cra_name "gcm(aes)", an AEAD). This
+	  is the algorithm selected by default when the driver is
+	  enabled, and the only one that needs the KWP/KA key-wrapping
+	  blocks.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_ECB_AES
+	bool "ecb-aes-canaan"
+	help
+	  Register ecb-aes-canaan (cra_name "ecb(aes)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Accepts 128-, 192- and 256-bit keys; request
+	  lengths must be a multiple of the 16-byte AES block.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_CBC_AES
+	bool "cbc-aes-canaan"
+	help
+	  Register cbc-aes-canaan (cra_name "cbc(aes)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Accepts 128-, 192- and 256-bit keys and a
+	  16-byte IV; request lengths must be a multiple of 16 bytes.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_CTR_AES
+	bool "ctr-aes-canaan"
+	help
+	  Register ctr-aes-canaan (cra_name "ctr(aes)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Accepts 128-, 192- and 256-bit keys and a
+	  16-byte counter block; requests may be of any length.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_OFB_AES
+	bool "ofb-aes-canaan"
+	help
+	  Register ofb-aes-canaan (cra_name "ofb(aes)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Accepts 128-, 192- and 256-bit keys and a
+	  16-byte IV; requests may be of any length.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_CFB_AES
+	bool "cfb-aes-canaan"
+	help
+	  Register cfb-aes-canaan (cra_name "cfb(aes)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Accepts 128-, 192- and 256-bit keys and a
+	  16-byte IV; requests may be of any length.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_ECB_SM4
+	bool "ecb-sm4-canaan"
+	help
+	  Register ecb-sm4-canaan (cra_name "ecb(sm4)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Takes the 128-bit SM4 key; request lengths
+	  must be a multiple of the 16-byte SM4 block.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_CBC_SM4
+	bool "cbc-sm4-canaan"
+	help
+	  Register cbc-sm4-canaan (cra_name "cbc(sm4)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Takes the 128-bit SM4 key and a 16-byte IV;
+	  request lengths must be a multiple of 16 bytes.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_CTR_SM4
+	bool "ctr-sm4-canaan"
+	help
+	  Register ctr-sm4-canaan (cra_name "ctr(sm4)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Takes the 128-bit SM4 key and a 16-byte
+	  counter block; requests may be of any length.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_OFB_SM4
+	bool "ofb-sm4-canaan"
+	help
+	  Register ofb-sm4-canaan (cra_name "ofb(sm4)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Takes the 128-bit SM4 key and a 16-byte IV;
+	  requests may be of any length.
+
+config CRYPTO_DEV_KENDRYTE_CRYP_CFB_SM4
+	bool "cfb-sm4-canaan"
+	help
+	  Register cfb-sm4-canaan (cra_name "cfb(sm4)") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Takes the 128-bit SM4 key and a 16-byte IV;
+	  requests may be of any length.
+
+# Set when any SP38A mode above is: gates the shared SP38A code.
+config CRYPTO_DEV_KENDRYTE_CRYP_SP38A
+	def_bool CRYPTO_DEV_KENDRYTE_CRYP_ECB_AES || \
+		CRYPTO_DEV_KENDRYTE_CRYP_CBC_AES || \
+		CRYPTO_DEV_KENDRYTE_CRYP_CTR_AES || \
+		CRYPTO_DEV_KENDRYTE_CRYP_OFB_AES || \
+		CRYPTO_DEV_KENDRYTE_CRYP_CFB_AES || \
+		CRYPTO_DEV_KENDRYTE_CRYP_ECB_SM4 || \
+		CRYPTO_DEV_KENDRYTE_CRYP_CBC_SM4 || \
+		CRYPTO_DEV_KENDRYTE_CRYP_CTR_SM4 || \
+		CRYPTO_DEV_KENDRYTE_CRYP_OFB_SM4 || \
+		CRYPTO_DEV_KENDRYTE_CRYP_CFB_SM4
+	select CRYPTO_SKCIPHER
+
+# Set when at least one algorithm is: with none, the Makefile does not
+# build the driver at all rather than produce one that registers nothing.
+config CRYPTO_DEV_KENDRYTE_CRYP_ANY
+	def_bool CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES || CRYPTO_DEV_KENDRYTE_CRYP_SP38A
+
+endif # CRYPTO_DEV_KENDRYTE_CRYP
 
 config CRYPTO_DEV_KENDRYTE_HASH
-    tristate "Support for K230 sha256 accelerators"
-    select CRYPTO_HASH
-    select CRYPTO_SHA256
-    default ARCH_CANAAN
-    help
-        This driver interfaces with the hardware
-        hash accelerator for K230.
-        Supporting sha256 hashing
-        algo.
+	tristate "Support for K230 hash/HMAC accelerator"
+	depends on ARCH_CANAAN || COMPILE_TEST
+	depends on HAS_IOMEM
+	select CRYPTO_HASH
+	select CRYPTO_SHA256
+	select CRYPTO_DEV_KENDRYTE_ENGINE
+	default ARCH_CANAAN
+	help
+	  This driver interfaces with the PUFcc HMAC/HASH block of the
+	  K230. Which algorithms it registers is chosen below, one
+	  option each; by default only sha256 is enabled. Algorithms
+	  left out are not compiled in at all, and with none selected
+	  the driver itself is not built. What is selected is registered
+	  unconditionally, so select only what the part implements.
+
+if CRYPTO_DEV_KENDRYTE_HASH
+
+comment "Algorithms registered by the K230 hash driver"
+
+config CRYPTO_DEV_KENDRYTE_HASH_SHA256
+	bool "sha256-kendryte"
+	default y
+	help
+	  Register sha256-kendryte (cra_name "sha256") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. This is the one algorithm enabled by default
+	  when the driver is.
+
+config CRYPTO_DEV_KENDRYTE_HASH_SHA224
+	bool "sha224-kendryte"
+	help
+	  Register sha224-kendryte (cra_name "sha224") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Supports export()/import() of the partial
+	  hash state like the other hash algorithms here.
+
+config CRYPTO_DEV_KENDRYTE_HASH_SHA384
+	bool "sha384-kendryte"
+	help
+	  Register sha384-kendryte (cra_name "sha384") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Supports export()/import() of the partial
+	  hash state like the other hash algorithms here.
+
+config CRYPTO_DEV_KENDRYTE_HASH_SHA512
+	bool "sha512-kendryte"
+	help
+	  Register sha512-kendryte (cra_name "sha512") with the crypto
+	  API at priority 300, so it is preferred over the software
+	  implementation. Supports export()/import() of the partial
+	  hash state like the other hash algorithms here.
+
+config CRYPTO_DEV_KENDRYTE_HASH_SM3
+	bool "sm3-kendryte"
+	help
+	  Register sm3-kendryte (cra_name "sm3") with the crypto API at
+	  priority 300, so it is preferred over the software
+	  implementation. Supports export()/import() of the partial
+	  hash state like the other hash algorithms here.
+
+config CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA224
+	bool "hmac-sha224-kendryte"
+	help
+	  Register hmac-sha224-kendryte (cra_name "hmac(sha224)") with
+	  the crypto API at priority 300, so it is preferred over the
+	  software hmac template. Keys longer than the 64-byte block
+	  are hashed down first, as RFC 2104 specifies.
+
+config CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA256
+	bool "hmac-sha256-kendryte"
+	help
+	  Register hmac-sha256-kendryte (cra_name "hmac(sha256)") with
+	  the crypto API at priority 300, so it is preferred over the
+	  software hmac template. Keys longer than the 64-byte block
+	  are hashed down first, as RFC 2104 specifies.
+
+config CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA384
+	bool "hmac-sha384-kendryte"
+	help
+	  Register hmac-sha384-kendryte (cra_name "hmac(sha384)") with
+	  the crypto API at priority 300. The hardware key register
+	  holds at most 64 bytes, so setkey() rejects 65..128-byte
+	  keys; longer keys are hashed down first and work.
+
+config CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA512
+	bool "hmac-sha512-kendryte"
+	help
+	  Register hmac-sha512-kendryte (cra_name "hmac(sha512)") with
+	  the crypto API at priority 300. The hardware key register
+	  holds at most 64 bytes, so setkey() rejects 65..128-byte
+	  keys; longer keys are hashed down first and work.
+
+config CRYPTO_DEV_KENDRYTE_HASH_HMAC_SM3
+	bool "hmac-sm3-kendryte"
+	help
+	  Register hmac-sm3-kendryte (cra_name "hmac(sm3)") with the
+	  crypto API at priority 300, so it is preferred over the
+	  software hmac template. Keys longer than the 64-byte block
+	  are hashed down first, as RFC 2104 specifies.
+
+# Set when any HMAC algorithm above is: gates the shared HMAC setkey code.
+config CRYPTO_DEV_KENDRYTE_HASH_HMAC
+	def_bool CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA224 || \
+		CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA256 || \
+		CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA384 || \
+		CRYPTO_DEV_KENDRYTE_HASH_HMAC_SHA512 || \
+		CRYPTO_DEV_KENDRYTE_HASH_HMAC_SM3
+
+# Set when at least one algorithm is: with none, the Makefile does not
+# build the driver at all rather than produce one that registers nothing.
+config CRYPTO_DEV_KENDRYTE_HASH_ANY
+	def_bool CRYPTO_DEV_KENDRYTE_HASH_SHA224 || \
+		CRYPTO_DEV_KENDRYTE_HASH_SHA256 || \
+		CRYPTO_DEV_KENDRYTE_HASH_SHA384 || \
+		CRYPTO_DEV_KENDRYTE_HASH_SHA512 || \
+		CRYPTO_DEV_KENDRYTE_HASH_SM3 || \
+		CRYPTO_DEV_KENDRYTE_HASH_HMAC
+
+endif # CRYPTO_DEV_KENDRYTE_HASH
 
 config CRYPTO_DEV_KENDRYTE_RSA
-    tristate "Support for k230 rsa-2048 accelerator"
-    select CRYPTO_SKCIPHER
-    default ARCH_CANAAN
-    help
-        This driver interfaces with the hardware
-        rsa accelerator for K230.
-        Supporting rsa-1024, rsa-2048, rsa-3072,
-        rsa-4096 encryption and decryption algo.
\ No newline at end of file
+	tristate "Support for K230 RSA accelerator"
+	depends on ARCH_CANAAN || COMPILE_TEST
+	depends on HAS_IOMEM
+	select CRYPTO_AKCIPHER
+	select CRYPTO_RSA
+	help
+	  This driver interfaces with the PUFcc ECP (RSA) block of the
+	  K230. Off by default, since the hardware is slower than
+	  rsa-generic.
+
+	  Registers the standard "rsa" akcipher at priority 50, below
+	  rsa-generic (100): the ECP is several times slower than the
+	  software implementation, so by default the kernel keeps using
+	  software, and callers that want to save CPU instead ask for
+	  "kendryte-rsa" (or e.g. "pkcs1pad(kendryte-rsa,sha256)") by
+	  name. The key sizes run on the ECP are chosen below (by
+	  default only RSA-2048); every other size, and any public
+	  exponent wider than 32 bits, falls back to rsa-generic, so
+	  leaving a size out never makes a key unusable. With no size
+	  selected the driver itself is not built.
+
+if CRYPTO_DEV_KENDRYTE_RSA
+
+choice
+	prompt "ECP microprogram version"
+	default CRYPTO_DEV_KENDRYTE_RSA_ECP_ECF39303
+	help
+	  Which set of PUFcc ECP microprograms to build in. It must
+	  match the ECP version register (0x91211000 + 0x00); the K230
+	  reads 0xECF39303. The driver does not check the register
+	  itself, so only change this for a part whose ECP reports a
+	  different version.
+
+config CRYPTO_DEV_KENDRYTE_RSA_ECP_ECF39303
+	bool "ECF39303 (K230)"
+	help
+	  Build the microprograms for ECP version 0xECF39303, the
+	  revision found on the K230. This is the default and the
+	  right choice for every K230 board; the selected key sizes
+	  below are built for this version only.
+
+config CRYPTO_DEV_KENDRYTE_RSA_ECP_ECF09303
+	bool "ECF09303"
+	help
+	  Build the microprograms for ECP version 0xECF09303, for
+	  PUFcc parts whose ECP version register reads that value. Do
+	  not select this on a K230, whose ECP reads 0xECF39303; the
+	  selected key sizes below are built for this version only.
+
+endchoice
+
+comment "RSA key sizes run on the ECP (others use rsa-generic)"
+
+config CRYPTO_DEV_KENDRYTE_RSA_1024
+	bool "RSA-1024"
+	help
+	  Build in the RSA-1024 microprograms, so 1024-bit keys are run
+	  on the ECP instead of falling back to rsa-generic. RSA-1024 is
+	  considered too weak for new uses; enable it only for legacy
+	  keys that must be handled in hardware.
+
+config CRYPTO_DEV_KENDRYTE_RSA_2048
+	bool "RSA-2048"
+	default y
+	help
+	  Build in the RSA-2048 microprograms, so 2048-bit keys are run
+	  on the ECP. The size selected by default when the driver is
+	  enabled: it is what U-Boot image signatures and typical X.509
+	  certificates use.
+
+config CRYPTO_DEV_KENDRYTE_RSA_3072
+	bool "RSA-3072"
+	help
+	  Build in the RSA-3072 microprograms, so 3072-bit keys are run
+	  on the ECP instead of falling back to rsa-generic. Each key
+	  size adds its own microprograms to the driver, so leave out
+	  sizes nothing uses.
+
+config CRYPTO_DEV_KENDRYTE_RSA_4096
+	bool "RSA-4096"
+	help
+	  Build in the RSA-4096 microprograms, so 4096-bit keys are run
+	  on the ECP instead of falling back to rsa-generic. Each key
+	  size adds its own microprograms to the driver, so leave out
+	  sizes nothing uses.
+
+# Set when at least one key size is: with none, the Makefile does not
+# build the driver at all -- it would only wrap rsa-generic.
+config CRYPTO_DEV_KENDRYTE_RSA_ANY
+	def_bool CRYPTO_DEV_KENDRYTE_RSA_1024 || \
+		CRYPTO_DEV_KENDRYTE_RSA_2048 || \
+		CRYPTO_DEV_KENDRYTE_RSA_3072 || \
+		CRYPTO_DEV_KENDRYTE_RSA_4096
+
+endif # CRYPTO_DEV_KENDRYTE_RSA
diff --git a/drivers/crypto/canaan/Makefile b/drivers/crypto/canaan/Makefile
index 57206d9a8..db944d49f 100644
--- a/drivers/crypto/canaan/Makefile
+++ b/drivers/crypto/canaan/Makefile
@@ -1,12 +1,24 @@
 # SPDX-License-Identifier: GPL-2.0
 #
-# Canaan AES-GCM Makefile
+# Canaan K230 PUFcc crypto accelerator drivers
 #
-obj-$(CONFIG_CRYPTO_DEV_KENDRYTE_CRYP) += kendryte_crypto.o
-kendryte_crypto-objs := kendryte-aes.o
+obj-$(CONFIG_CRYPTO_DEV_KENDRYTE_ENGINE) += kendryte_crypto_engine.o
+kendryte_crypto_engine-objs := kendryte-crypto-engine.o
 
+# Only when at least one CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_* algorithm is on
+ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_ANY
+obj-$(CONFIG_CRYPTO_DEV_KENDRYTE_CRYP) += kendryte_cipher.o
+kendryte_cipher-objs := kendryte-cipher.o
+endif
+
+# Only when at least one CONFIG_CRYPTO_DEV_KENDRYTE_HASH_* algorithm is on
+ifdef CONFIG_CRYPTO_DEV_KENDRYTE_HASH_ANY
 obj-$(CONFIG_CRYPTO_DEV_KENDRYTE_HASH) += kendryte_hash.o
 kendryte_hash-objs := kendryte-hash.o
+endif
 
+# Only when at least one CONFIG_CRYPTO_DEV_KENDRYTE_RSA_<size> is on
+ifdef CONFIG_CRYPTO_DEV_KENDRYTE_RSA_ANY
 obj-$(CONFIG_CRYPTO_DEV_KENDRYTE_RSA) += kendryte_rsa.o
