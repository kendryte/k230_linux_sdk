+/*
+ * b2B()/B2b(), the shared status codes, the key/algo descriptors and the
+ * DMA/CRYPTO register map all live in kendryte-common.h now -- they are the
+ * same hardware and the same firmware ABI for all three drivers here.
+ */
+
+/*
+ * The probed device, or NULL. Allocated in probe() with devm_kzalloc(), so a
+ * board whose device tree has no aes node pays only for this pointer. Safe
+ * because sysfs unbind is disabled (suppress_bind_attrs): remove() then only
+ * runs on module unload, which the crypto core blocks while any tfm -- and
+ * so any ctx->dev pointing in here -- still exists.
+ */
+static struct kendryte_crypto_info *crypto_info;
+
+/*
+ * Every helper below is file-local.
+ *
+ * They used to have external linkage with names like be2le(), segment(),
+ * dma_write_start() and get_key_slot_idx() -- generic enough that building
+ * this driver into vmlinux put a dozen such symbols into the kernel's
+ * global namespace, where they can collide with (or shadow, in a
+ * stack-trace or kallsyms lookup) identically-named helpers in any other
+ * driver. kendryte-hash.c already keeps its copies static; this matches.
+ */
+
+//----------------------BASE FUNCTION ----------------------------------------//
+static uint32_t be2le(uint32_t var)
+{
+	return (((0xff000000 & var) >> 24) | ((0x00ff0000 & var) >> 8) |
+		((0x0000ff00 & var) << 8) | ((0x000000ff & var) << 24));
+}
+
+/*
+ * Move a buffer to/from the CRYPTO block's register file, one 32-bit word
+ * at a time, optionally byte-swapping on the way.
+ *
+ * readl()/writel() rather than plain dereferences through a cast-away
+ * __iomem pointer (which is what these used to do): the word granularity
+ * is a hardware requirement, and only the accessors guarantee the compiler
+ * will not merge, split, reorder or elide accesses to a device.
+ */
+static void write_data(void __iomem *dst, const uint8_t *src, size_t length,
+		       bool le)
+{
+	const uint32_t *src32 = (const uint32_t *)src;
+	size_t i, words = length / 4;
+
+	for (i = 0; i < words; ++i)
+		writel(le ? be2le(src32[i]) : src32[i], dst + i * 4);
+}
+
+static void read_data(uint8_t *dst, const void __iomem *src, size_t length,
+		      bool le)
+{
+	uint32_t *dst32 = (uint32_t *)dst;
+	uint32_t word_nums = length / 4;
+	uint32_t rest = length % 4;
+	uint32_t last_word, val, i;
+
+	for (i = 0; i < word_nums; i++) {
+		val = readl(src + i * 4);
+		dst32[i] = le ? be2le(val) : val;
+	}
+
+	if (rest != 0) {
+		val = readl(src + word_nums * 4);
+		last_word = le ? be2le(val) : val;
+
+		memcpy(dst + (word_nums * 4), &last_word, rest);
+	}
+}
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+static enum kendryte_status_t get_config(uint32_t *cfg, struct kendryte_aes_ctx *ctx,
+					bool gctr, bool reg_in, bool reg_out)
+{
+	uint32_t val32;
+
+	switch (ctx->cipher) {
+	case AES:
+		switch ((ctx->keylen) << 3) {
+		case 128:
+			val32 = 0x0;
+			break;
+		case 192:
+			val32 = 0x1;
+			break;
+		case 256:
+			val32 = 0x2;
+			break;
+		default:
+			return E_FIRMWARE;
+		}
+		break;
+
+	default:
+		return E_FIRMWARE;
+	}
+
+	if ((ctx->inlen) != ULLONG_MAX)
+		val32 |= 0x1 << GCM_CFG_GHASH_BITS;
+
+	if (gctr)
+		val32 |= 0x1 << GCM_CFG_GCTR_BITS;
+
+	val32 |= (ctx->encrypt ? 0x1 : 0x0) << GCM_CFG_ENCRYPT_BITS;
+
+	if (reg_in)
+		val32 |= 0x1 << GCM_CFG_REG_IN_BITS;
+
+	if (reg_out)
+		val32 |= 0x1 << GCM_CFG_REG_OUT_BITS;
+
+	*cfg = val32;
+
+	return SUCCESS;
+}
+
+static struct blsegs segment(uint8_t *buf, uint32_t buflen, const uint8_t *in, uint32_t inlen,
+		   uint32_t blocksize, uint32_t minlen)
+{
+	struct blsegs ret = { .nsegs = 0 };
+	// calculate total number of blocks to be processed
+	uint32_t nprocblocks = 0;
+
+	if ((buflen + inlen) >= (minlen + blocksize))
+		nprocblocks = (buflen + inlen - minlen) / blocksize;
+
+	// no available block for processing, keep input in the internal buffer.
+	if (nprocblocks == 0) {
+		ret.seg[ret.nsegs++] = (struct segstr){ false, buf, buflen };
+		ret.seg[ret.nsegs++] = (struct segstr){ false, in, inlen };
+		return ret;
+	}
+
+	const uint8_t *start = in;
+	// some blocks are ready for processing, using bytes in the internal buffer first
+	if (buflen != 0) {
+		// if all data in the internal buffer will be processed
+		if (nprocblocks * blocksize >= buflen) {
+			// fill buffer if not a complete block
+			uint32_t proclen = blocksize;
+
+			nprocblocks--;
+			while (proclen < buflen) {
+				proclen += blocksize;
+				nprocblocks--;
+			}
+			memcpy(buf + buflen, start, proclen - buflen);
+			ret.seg[ret.nsegs++] = (struct segstr){ true, buf, proclen };
+			start += (proclen - buflen);
+			inlen -= (proclen - buflen);
+		} else {
+			// some data will be remained in the internal buffer
+			ret.seg[ret.nsegs++] =
+				(struct segstr){ true, buf, nprocblocks * blocksize };
+			ret.seg[ret.nsegs++] =
+				(struct segstr){ false, buf + nprocblocks * blocksize,
+					  buflen - nprocblocks * blocksize };
+			nprocblocks = 0;
+		}
+	}
+	// deal with input data
+	if (nprocblocks > 0) {
+		ret.seg[ret.nsegs++] =
+			(struct segstr){ true, start, nprocblocks * blocksize };
+	}
+	ret.seg[ret.nsegs++] = (struct segstr){ false, start + nprocblocks * blocksize,
+					 inlen - nprocblocks * blocksize };
+
+	return ret;
+}
+
+//----------------------KWP FUNCTION----------------------------------------//
+static enum kendryte_status_t kwp_start(void)
+{
+	uint32_t val32;
+	ktime_t deadline;
+
+	/* KWP/KA are this driver's own, but share the request-wide lock */
+	lockdep_assert_held(&crypto_info->engine->lock);
+
+	writel(0x1, crypto_info->kwp_base + KWP_START_OFFSET);
+
+	deadline = ktime_add_us(ktime_get(), KENDRYTE_HW_TIMEOUT_US);
+	while (((val32 = readl(crypto_info->kwp_base + KWP_STATUS_OFFSET)) &
+		KWP_STATUS_BUSY_MASK) != 0) {
+		if (ktime_after(ktime_get(), deadline)) {
+			pr_err("KWP timed out waiting for completion\n");
+			return E_ERROR;
+		}
+		cpu_relax();
+		cond_resched();
+	}
+
+	if (val32 & (0x1 << 2))
+		return E_DENY;
+	else if (val32 & (0x1 << 3))
+		return E_OVERFLOW;
+	else if (val32 & (0x1 << 4))
+		return E_UNDERFLOW;
+	else if (val32 & (0x1 << 5))
+		return E_VERFAIL;
+	else if (val32 != 0) {
+		pr_err("Error, KWP status: 0x%08x\n", val32);
+		return E_ERROR;
+	}
+
+	return SUCCESS;
+}
+
+static enum kendryte_status_t ka_skslot_check(bool valid, enum kendryte_ka_slot_t slot,
+					 uint32_t keybits)
+{
+	// check keybits
+	switch (slot) {
+	case SK128_0:
+	case SK128_1:
+	case SK128_2:
+	case SK128_3:
+	case SK128_4:
+	case SK128_5:
+	case SK128_6:
+	case SK128_7:
+		if (keybits > 128)
+			return E_OVERFLOW;
+		break;
+	case SK256_0:
+	case SK256_1:
+	case SK256_2:
+	case SK256_3:
+		if (keybits > 256)
+			return E_OVERFLOW;
+		else if ((keybits <= 128) && (keybits != 0))
+			return E_UNDERFLOW;
+		break;
+	case SK512_0:
+	case SK512_1:
+		if (keybits > 512)
+			return E_OVERFLOW;
+		else if ((keybits <= 256) && (keybits != 0))
+			return E_UNDERFLOW;
+		break;
+	default:
+		return E_INVALID;
+	}
+
+	// check registers
+	if (valid) {
+		uint32_t key_info;
+		uint32_t idx;
+		uint32_t tagbase;
+
+		switch (slot) {
+		case SK128_0:
+		case SK128_1:
+		case SK128_2:
+		case SK128_3:
+		case SK128_4:
+		case SK128_5:
+		case SK128_6:
+		case SK128_7:
+			idx = slot - SK128_0;
+			tagbase = 0x30;
+			key_info =
+				readl(crypto_info->ka_base + KA_SK_0_OFFSET + idx * 4);
+			if (((key_info & SK_KEY_VAILD_MASK) == 0) ||
+				(((key_info & SK_KEY_SIZE_MASK) >> 4) != keybits) ||
+				(((key_info & SK_KEY_TAG_MASK) >> 16) !=
+				 (tagbase + idx)))
+				return E_INVALID;
+			break;
+		case SK256_0:
+		case SK256_1:
+		case SK256_2:
+		case SK256_3:
+			idx = slot - SK256_0;
+			tagbase = 0x50;
+			key_info = readl(crypto_info->ka_base + KA_SK_0_OFFSET +
+					 idx * 2 * 4);
+			if (((key_info & SK_KEY_VAILD_MASK) == 0) ||
+				(((key_info & SK_KEY_SIZE_MASK) >> 4) != keybits) ||
+				(((key_info & SK_KEY_TAG_MASK) >> 16) !=
+				 (tagbase + idx)) ||
+				(readl(crypto_info->ka_base + KA_SK_0_OFFSET + idx * 2 * 4 +
+				   4) != ((tagbase + idx) << 16)))
+				return E_INVALID;
+			break;
+		case SK512_0:
+		case SK512_1:
+			idx = slot - SK512_0;
+			tagbase = 0x60;
+			key_info = readl(crypto_info->ka_base + KA_SK_0_OFFSET +
+					 idx * 4 * 4);
+			if (((key_info & SK_KEY_VAILD_MASK) == 0) ||
+				(((key_info & SK_KEY_SIZE_MASK) >> 4) != keybits) ||
+				(((key_info & SK_KEY_TAG_MASK) >> 16) !=
+				 (tagbase + idx)) ||
+				(readl(crypto_info->ka_base + KA_SK_0_OFFSET + idx * 4 * 4 +
+				   4) != ((tagbase + idx) << 16)) ||
+				(readl(crypto_info->ka_base + KA_SK_0_OFFSET + idx * 4 * 4 +
+				   8) != ((tagbase + idx) << 16)) ||
+				(readl(crypto_info->ka_base + KA_SK_0_OFFSET + idx * 4 * 4 +
+				   12) != ((tagbase + idx) << 16)))
+				return E_INVALID;
+			break;
+		default:
+			return E_INVALID;
+		}
+	}
+
+	return SUCCESS;
+}
+
+static enum kendryte_status_t keyslot_check(bool valid, enum kendryte_key_type_t keytype,
+					   uint32_t slot, uint32_t keybits)
+{
+	switch (keytype) {
+	case SSKEY:
+		return ka_skslot_check(valid, (enum kendryte_ka_slot_t)slot,
+					   keybits);
+	default:
+		return E_INVALID;
+	}
+}
+
+static int get_key_slot_idx(enum kendryte_key_type_t keytype,
+			    enum kendryte_ka_slot_t keyslot)
+{
+	switch (keytype) {
+	case SSKEY:
+		switch (keyslot) {
+		case SK128_0:
+		case SK128_1:
+		case SK128_2:
+		case SK128_3:
+		case SK128_4:
+		case SK128_5:
+		case SK128_6:
+		case SK128_7:
+			return (keyslot - SK128_0);
+		case SK256_0:
+		case SK256_1:
+		case SK256_2:
+		case SK256_3:
+			return ((keyslot - SK256_0) * 2);
+		case SK512_0:
+		case SK512_1:
+			return ((keyslot - SK512_0) * 4);
+		default:
+			return -1;
+		}
+		break;
+
+	default:
+		return -1;
+	}
+}
+
+#endif /* CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES */
+//---------------------------------CRYTPO FUNCTION----------------------------------------//
+static enum kendryte_status_t crypto_write_iv(uint8_t *iv, size_t length)
+{
+	if (length > IV_MAXLEN)
+		return E_INVALID;
+
+	write_data(crypto_info->engine->crypto_base + CRYPTO_IV_OFFSET, iv, length, true);
+
+	return SUCCESS;
+}
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+static enum kendryte_status_t crypto_write_dgst(uint8_t *dgst, size_t length)
+{
+	if (length > DGST_INT_STATE_LEN)
+		return E_INVALID;
+
+	write_data(crypto_info->engine->crypto_base + CRYPTO_DGST_IN_OFFSET, dgst, length, true);
+
+	return SUCCESS;
+}
+#endif /* CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES */
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_SP38A
+static enum kendryte_status_t crypto_write_sw_key(const uint8_t *key,
+						 size_t length)
+{
+	if (length > SW_KEY_MAXLEN)
+		return E_INVALID;
+
+	write_data(crypto_info->engine->crypto_base + CRYPTO_SW_KEY_OFFSET, key, length, true);
+
+	return SUCCESS;
+}
+#endif /* CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_SP38A */
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_SP38A
+/*
+ * Read back the chaining value the engine left behind (last ciphertext
+ * block for CBC, advanced counter for CTR, ...) so the caller can continue
+ * the stream in a following request.
+ */
+static void crypto_read_iv(uint8_t *out, size_t length)
+{
+	length = min_t(size_t, length, IV_MAXLEN);
+	read_data(out, crypto_info->engine->crypto_base + CRYPTO_IV_OUT_OFFSET, length, true);
+}
+#endif /* CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_SP38A */
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+static void crypto_read_dgest(uint8_t *out, size_t length)
+{
+	length = length < DGST_INT_STATE_LEN ? length : DGST_INT_STATE_LEN;
+	read_data(out, crypto_info->engine->crypto_base + CRYPTO_DGST_OUT_OFFSET, length, true);
+}
+#endif /* CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES */
+
+//----------------------------------------DMA FUNCTION----------------------------------------//
+static void dma_write_start(void)
+{
+	/*
+	 * Every hardware operation in this file funnels through here, so one
+	 * assertion covers them all. The lock is taken once per *request*
+	 * (not per transfer as in kendryte-hash.c) because a GCM request
+	 * owns a KA session-key slot from import_plaintext_key_to_slot()
+	 * until clear_key(): letting another request in between would have
+	 * it overwrite that slot and encrypt with the wrong key.
+	 */
+	lockdep_assert_held(&crypto_info->engine->lock);
+
+	writel(0x1, crypto_info->engine->dma_base + DMA_START_OFFSET);
+}
+
+static bool dma_check_busy_status(uint32_t *status)
+{
+	uint32_t stat = readl(crypto_info->engine->dma_base + DMA_STAT_0_OFFSET);
+	bool busy = (stat & DMA_STATUS_0_BUSY_MASK) != 0;
+
+	if (status != NULL)
+		*status = stat;
+
+	return busy;
+}
+
+static void dma_write_config_0(bool rng_enable, bool sgdma_enable, bool no_cypt)
+{
+	uint32_t value = 0;
+
+	if (rng_enable)
+		value |= 0x1;
+	if (sgdma_enable)
+		value |= 0x1 << 1;
+	if (no_cypt)
+		value |= 0x1 << 2;
+
+	writel(value, crypto_info->engine->dma_base + DMA_CFG_0_OFFSET);
+}
+
+static void dma_write_data_block_config(bool head, bool tail, bool dn_intrpt,
+					bool dn_pause, uint32_t offset)
+{
+	uint32_t value = 0;
+
+	if (head)
+		value |= 0x1 << DMA_DSC_CFG_4_HEAD_BITS;
+	if (tail)
+		value |= 0x1 << DMA_DSC_CFG_4_TAIL_BITS;
+	if (dn_intrpt)
+		value |= 0x1 << DMA_DSC_CFG_4_DN_INTRPT_BITS;
+	if (dn_pause)
+		value |= 0x1 << DMA_DSC_CFG_4_DN_PAUSE_BITS;
+	value |= offset << DMA_DSC_CFG_4_OFFSET_BITS;
+
+	writel(value, crypto_info->engine->dma_base + DMA_DSC_CFG_4_OFFSET);
+}
+
+/*
+ * Programs the DMA source/destination/length registers for one transfer,
+ * staging the input through the engine's coherent bounce buffer.
+ *
+ * @len is bounded by dma->len (KENDRYTE_ENGINE_DMA_DATA_LEN) by
+ * construction: the callers chunk to that size, and segment() only splits
+ * a chunk further (the GCM length/tag rounds are a single AES block). The
+ * WARN_ON is a cheap assertion that this still holds if that ever changes.
+ */
+static enum kendryte_status_t dma_write_rwcfg(struct kendryte_dma_buf *dma,
+					      const uint8_t *out,
+					      const uint8_t *in, uint32_t len)
+{
+	if (WARN_ON(!dma))
+		return E_FIRMWARE;
+	if (WARN_ON(len > dma->len))
+		return E_OVERFLOW;
+
+	writel(len, crypto_info->engine->dma_base + DMA_DSC_CFG_2_OFFSET);
+
+	if (out == NULL)
+		writel(0, crypto_info->engine->dma_base + DMA_DSC_CFG_1_OFFSET);
+	else
+		writel(dma->out_phys, crypto_info->engine->dma_base + DMA_DSC_CFG_1_OFFSET);
+
+	if (in == NULL) {
+		writel(0, crypto_info->engine->dma_base + DMA_DSC_CFG_0_OFFSET);
+	} else {
+		memcpy(dma->in_virt, in, len);
+		writel(dma->in_phys, crypto_info->engine->dma_base + DMA_DSC_CFG_0_OFFSET);
+	}
+
+	return SUCCESS;
+}
+
+/*
+ * Point @dma at the engine's staging buffers, allocating them on first use.
+ *
+ * Every transfer is at most KENDRYTE_ENGINE_DMA_DATA_LEN: both callers feed
+ * the engine in chunks of that size instead of asking for a bigger buffer
+ * (see kendryte_sp38a_crypt() for why: on this CONFIG_DMA_CMA kernel a
+ * per-request dma_alloc_coherent() costs milliseconds), and the GCM length
+ * and tag rounds are a single block. Callers hold engine->lock for the
+ * whole request, which is what makes using the shared pair safe.
+ */
+static enum kendryte_status_t kendryte_dma_buf_get(struct kendryte_crypto_info *dev,
+						   struct kendryte_dma_buf *dma)
+{
+	if (kendryte_crypto_engine_get_bufs(dev->engine, true))
+		return E_UNAVAIL;
+
+	dma->in_virt = dev->engine->dma_buf_in_virt;
+	dma->out_virt = dev->engine->dma_buf_out_virt;
+	dma->in_phys = dev->engine->dma_buf_in_phys;
+	dma->out_phys = dev->engine->dma_buf_out_phys;
+	dma->len = KENDRYTE_ENGINE_DMA_DATA_LEN;
+
+	return SUCCESS;
+}
+
+static void dma_write_key_config_0(enum kendryte_key_type_t keytype,
+				enum kendryte_algo_type_t algo, uint32_t size,
+				uint32_t slot_index)
+{
+	uint32_t value = 0;
+
+	value |= slot_index << DMA_KEY_CFG_0_KEY_IDX_BITS;
+	value |= size << DMA_KEY_CFG_0_KEY_SIZE_BITS;
+	value |= algo << DMA_KEY_CFG_0_KEY_DST_BITS;
+	value |= keytype;
+
+	writel(value, crypto_info->engine->dma_base + DMA_KEY_CFG_0_OFFSET);
+}
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+static enum kendryte_status_t gcm_prepare(struct kendryte_aes_ctx *ctx,
+					 const uint8_t *out, uint32_t inlen)
+{
+	enum kendryte_status_t check;
+	uint32_t val32;
+
+	dma_write_key_config_0(ctx->keytype, ALGO_TYPE_GCM, (ctx->keylen << 3),
+				   get_key_slot_idx(ctx->keytype, ctx->keyslot));
+
+	check = get_config(&val32, ctx, out != NULL, false, false);
+	if (check != SUCCESS)
+		return check;
+
+	writel(val32, ctx->dev->base + GCM_CFG_1_OFFSET);
+
+	if ((ctx->inlen) != ULLONG_MAX)
+		writel(ctx->incj0, ctx->dev->base + GCM_CFG_2_OFFSET);
+	else
+		writel(0x0, ctx->dev->base + GCM_CFG_2_OFFSET);
+
+	// J_0
+	if (out != NULL) {
+		crypto_write_iv(ctx->j0, AES_BLOCK_SIZE);
+		if ((ctx->inlen) != ULLONG_MAX && inlen > 0)
+			ctx->incj0 +=
+				((inlen - 1 + AES_BLOCK_SIZE) / AES_BLOCK_SIZE);
+	}
+
+	// Restore GHASH
+	crypto_write_dgst(ctx->ghash, AES_BLOCK_SIZE);
+
+	return SUCCESS;
+}
+
+static enum kendryte_status_t gcm_postproc(struct kendryte_aes_ctx *ctx)
+{
+	crypto_read_dgest(ctx->ghash, AES_BLOCK_SIZE);
+	return SUCCESS;
+}
+
+static enum kendryte_status_t _ctx_update(struct kendryte_aes_ctx *ctx, uint8_t *out,
+					 uint32_t *outlen, const uint8_t *in,
+					 uint32_t inlen, bool last)
+{
+	uint32_t val32;
+	enum kendryte_status_t check;
+	ktime_t deadline;
+
+	if (dma_check_busy_status(NULL))
+		return E_BUSY;
+
+	dma_write_config_0(false, false, false);
+	dma_write_data_block_config(ctx->start ? false : true, last, true, true,
+					0);
+	// config physical address of DMA read and write
+	check = dma_write_rwcfg(ctx->dma, out, in, inlen);
+	if (check != SUCCESS)
+		return check;
+
+	check = gcm_prepare(ctx, out, inlen);
+	if (check != SUCCESS)
+		return check;
+
+	/*
+	 * No manual cache maintenance needed: the bounce buffers come from
+	 * dma_alloc_coherent(), which on this non-coherent-DMA platform
+	 * (CONFIG_RISCV_DMA_NONCOHERENT=y) already returns a non-cached
+	 * mapping, so the memcpy() in dma_write_rwcfg() is visible to the
+	 * engine as-is.
+	 */
+	dma_write_start();
+
+	deadline = ktime_add_us(ktime_get(), KENDRYTE_HW_TIMEOUT_US);
+	while (dma_check_busy_status(&val32)) {
+		if (ktime_after(ktime_get(), deadline)) {
+			pr_err("DMA timed out waiting for completion\n");
+			return E_ERROR;
+		}
+		cpu_relax();
+		cond_resched();
+	}
+
+	if (val32 != 0) {
+		pr_err("DMA status 0: 0x%08x\n", val32);
+		return E_ERROR;
+	}
+
+	val32 = readl(ctx->dev->base + GCM_STAT_OFFSET);
+	if ((val32 & GCM_STATUS_RESP_MASK) != 0) {
+		pr_err("GCM status: 0x%08x\n", val32);
+		return E_ERROR;
+	}
+
+	check = gcm_postproc(ctx);
+	if (check != SUCCESS)
+		return check;
+
+	if (out != NULL) {
+		*outlen = inlen;
+		memcpy(out, ctx->dma->out_virt, inlen);
+	}
+
+	return SUCCESS;
+}
+
+static enum kendryte_status_t ctx_update(enum gcm_op op, struct kendryte_aes_ctx *ctx,
+					bool encrypt, uint8_t *out,
+					uint32_t *outlen, const uint8_t *in,
+					uint32_t inlen)
+{
+	uint32_t i;
+	// check ctx is owned by this operation (GCM mode)
+	if ((ctx->op != op) || (ctx->encrypt != encrypt))
+		return E_UNAVAIL;
+
+	// continue if msg is NULL or msglen is zero
+	if ((in == NULL) || (inlen == 0)) {
+		if (outlen != NULL)
+			*outlen = 0;
+		return SUCCESS;
+	}
+
+	switch (ctx->stage) {
+	case GCM_NONE_S:
+		break;
+	case GCM_AAD_S:
+		ctx->aadlen += (uint64_t)inlen;
+		break;
+	case GCM_TEXT_S:
+		ctx->inlen += (uint64_t)inlen;
+		break;
+	default:
+		return E_FIRMWARE;
+	}
+
+	struct blsegs segs = segment(ctx->buffer, ctx->buflen, in, inlen,
+				  AES_BLOCK_SIZE, ctx->minlen);
+	ctx->buflen = 0;
+	uint32_t seglen = 0;
+	enum kendryte_status_t check = SUCCESS;
+
+	if (ctx->stage == GCM_TEXT_S)
+		*outlen = 0;
+
+	for (i = 0; i < segs.nsegs; i++) {
+		if (segs.seg[i].process) {
+			// process
+			if (ctx->stage == GCM_TEXT_S) {
+				check = _ctx_update(ctx, out + *outlen, &seglen,
+							segs.seg[i].addr,
+							segs.seg[i].len, false);
+			} else {
+				check = _ctx_update(ctx, NULL, NULL,
+							segs.seg[i].addr,
+							segs.seg[i].len, false);
+			}
+
+			if (check != SUCCESS) {
+				// release context
+				ctx->op = GCM_AVAILABLE_OP;
+				return check;
+			}
+
+			if (ctx->stage == GCM_TEXT_S)
+				*outlen += seglen;
+
+			if (ctx->start == false)
+				ctx->start = true;
+		} else {
+			// keep in the internal buffer
+			if ((segs.seg[i].addr == ctx->buffer) &&
+				(ctx->buflen == 0))
+				// skip copy what already in the right place
+				ctx->buflen += segs.seg[i].len;
+			else {
+				// copy into the buffer
+				memmove(ctx->buffer + ctx->buflen,
+					segs.seg[i].addr, segs.seg[i].len);
+				ctx->buflen += segs.seg[i].len;
+			}
+		}
+	}
+
+	return SUCCESS;
+}
+
+static enum kendryte_status_t gcm_tag(struct kendryte_aes_ctx *ctx, uint8_t *tag,
+				 uint32_t taglen, bool from_reg)
+{
+	uint32_t val32, tmplen = 0;
+	enum kendryte_status_t check;
+	ktime_t deadline;
+
+	union {
+		uint8_t uc[AES_BLOCK_SIZE];
+		uint32_t u32[AES_BLOCK_SIZE / 4];
+	} tmp;
+
+	if (ctx->op == GCM_GHASH_OP) {
+		memcpy(tag, ctx->ghash, taglen);
+		return SUCCESS;
+	}
+
+	// len(A) || len(C)
+	tmp.u32[0] = be2le((uint32_t)((ctx->aadlen << 3) >> 32));
+	tmp.u32[1] = be2le((uint32_t)(ctx->aadlen << 3));
+	tmp.u32[2] = be2le((uint32_t)((ctx->inlen << 3) >> 32));
+	tmp.u32[3] = be2le((uint32_t)(ctx->inlen << 3));
+	check = _ctx_update(ctx, NULL, NULL, tmp.uc, AES_BLOCK_SIZE,
+				 true);
+	if (check != SUCCESS)
+		return check;
+
+	// last GCTR
+	ctx->inlen = ULLONG_MAX;
+
+	if (!from_reg) {
+		check = _ctx_update(ctx, tmp.uc, &tmplen, ctx->ghash,
+					  AES_BLOCK_SIZE, true);
+		if ((check != SUCCESS) || (tmplen != AES_BLOCK_SIZE))
+			return E_FIRMWARE;
+
+		memcpy(tag, tmp.uc, taglen);
+		return SUCCESS;
+	}
+
+	crypto_write_iv(ctx->j0, AES_BLOCK_SIZE);
+
+	check = get_config(&val32, ctx, true, true, true);
+	if (check != SUCCESS)
+		return check;
+
+	writel(val32, ctx->dev->base + GCM_CFG_1_OFFSET);
+	writel(0, ctx->dev->base + GCM_CFG_2_OFFSET);
+
+	dma_write_data_block_config(true, true, true, true, 0);
+	check = dma_write_rwcfg(ctx->dma, NULL, NULL, 0);
+	if (check != SUCCESS)
+		return check;
+	dma_write_config_0(false, false, false);
+	dma_write_key_config_0(ctx->keytype, ALGO_TYPE_GCM, (ctx->keylen << 3),
+				   get_key_slot_idx(ctx->keytype, ctx->keyslot));
+
+	/*
+	 * flush_cache_all() used to sit here. It resolves to the generic
+	 * no-op stub on riscv, so it never did anything on this arch -- and
+	 * it was not needed anyway: this transfer has no input buffer at all
+	 * (both descriptor addresses are 0; the operands come from the IV and
+	 * digest registers written just above), and the coherent mapping used
+	 * elsewhere needs no flushing either.
+	 */
+	dma_write_start();
+
+	deadline = ktime_add_us(ktime_get(), KENDRYTE_HW_TIMEOUT_US);
+	while (dma_check_busy_status(&val32)) {
+		if (ktime_after(ktime_get(), deadline)) {
+			pr_err("DMA timed out waiting for completion\n");
+			return E_ERROR;
+		}
+		cpu_relax();
+		cond_resched();
+	}
+
+	if (val32 != 0) {
+		pr_err("DMA status 0: 0x%08x\n", val32);
+		return E_ERROR;
+	}
+
+	val32 = readl(ctx->dev->base + GCM_STAT_OFFSET);
+	if ((val32 & GCM_STATUS_RESP_MASK) != 0) {
+		pr_err("GCM status: 0x%08x\n", val32);
+		return E_ERROR;
+	}
+	crypto_read_dgest(tag, taglen);
+
+	return SUCCESS;
+}
+
+static enum kendryte_status_t ctx_final(enum gcm_op op, struct kendryte_aes_ctx *ctx,
+				   bool encrypt, uint8_t *out, uint32_t *outlen,
+				   uint8_t *tag, uint32_t taglen, bool from_reg)
+{
+	enum kendryte_status_t check = SUCCESS;
+
+	if (outlen != NULL)
+		*outlen = 0;
+
+	// check ctx is owned by this operation (GCM mode)
+	if ((ctx->op != op) || (ctx->encrypt != encrypt))
+		return E_UNAVAIL;
+
+	if (ctx->buflen != 0) {
+		check = _ctx_update(ctx, out, outlen, ctx->buffer,
+					 ctx->buflen, true);
+		if (check != SUCCESS)
+			goto release_gcm;
+	}
+
+	if (encrypt)
+		check = gcm_tag(ctx, tag, taglen, from_reg);
+	else
+		check = gcm_tag(ctx, tag, taglen, !from_reg);
+
+release_gcm:
+	ctx->op = GCM_AVAILABLE_OP;
+
+	return check;
+}
+
+static enum kendryte_status_t ctx_init(enum gcm_op op, struct kendryte_aes_ctx *ctx,
+				  bool encrypt, enum kendryte_cipher_t cipher,
+				  enum kendryte_key_type_t keytype, size_t keyaddr,
+				  uint32_t keybits, const uint8_t *j0)
+{
+	enum kendryte_status_t check;
+
+	// abort if gcm ctx is occupied
+	if (ctx->op != GCM_AVAILABLE_OP)
+		return E_BUSY;
+
+	// check if op is valid
+	switch (op) {
+	case GCM_GHASH_OP:
+	case AES_GCM_OP:
+	case GCM_GMAC_OP:
+		break;
+	default:
+		return E_INVALID;
+	}
+
+	// check key settings for block cipher
+	check = keyslot_check(true, keytype, (uint32_t)keyaddr,
+					keybits);
+	if ((keytype != SWKEY) && (check != SUCCESS))
+		return check;
+
+	// check and set J_0 if needed
+	if (op != GCM_GHASH_OP) {
+		if (j0 == NULL)
+			return E_INVALID;
+		memcpy(ctx->j0, j0, AES_BLOCK_SIZE);
+	}
+
+	// initialize for block-cipher GCM mode
+	ctx->keylen = 0;
+	ctx->ivlen = 0;
+	ctx->aadlen = 0;
+	ctx->taglen = 0;
+	ctx->pclen = 0;
+	ctx->inlen = 0;
+	ctx->minlen = 1;
+	ctx->buflen = 0;
+	ctx->op = op;
+	ctx->incj0 = 1;
+	ctx->stage = GCM_NONE_S;
+	ctx->cipher = cipher;
+	ctx->encrypt = encrypt;
+	memset(ctx->ghash, 0, AES_BLOCK_SIZE);
+	// set key
+	ctx->keylen = keybits >> 3;
+	ctx->keytype = keytype;
+	if (keytype != SWKEY)
+		ctx->keyslot = (uint32_t)keyaddr;
+	else
+		memcpy(ctx->key, (const void *)keyaddr, b2B(keybits));
+
+	return SUCCESS;
+}
+
+/*
+ * Derive the GCM pre-counter block J_0 from the IV (NIST SP 800-38D 7.1
+ * step 2).
+ *
+ * @parent is the context of the request asking for this: the GHASH-only
+ * sub-context built below borrows its device binding and DMA buffers. It
+ * used to be declared as a bare `= { .op = GCM_AVAILABLE_OP }`, leaving
+ * ctx.dev NULL, so the moment anything reached gcm_prepare() -- which
+ * dereferences ctx->dev->base -- it would have oopsed. That path was
+ * unreachable only because GCM_AES_IV_SIZE is 12 and the ivlen == 12
+ * shortcut above returns first; any caller with a non-standard IV length
+ * would have hit it.
+ */
+static enum kendryte_status_t build_j0(struct kendryte_aes_ctx *parent,
+				  uint8_t *j0, enum kendryte_cipher_t cipher,
+				  enum kendryte_key_type_t keytype, size_t keyaddr,
+				  uint32_t keybits, const uint8_t *iv,
+				  uint32_t ivlen)
+{
+	uint8_t tmp[AES_BLOCK_SIZE];
+	uint64_t ivbits = ivlen << 3;
+	enum kendryte_status_t check;
+
+	if ((iv == NULL) || (ivlen == 0)) {
+		pr_err("%s() Error: need more params!\n", __func__);
+		return E_INVALID;
+	}
+
+	if (ivlen == 12) {
+		memcpy(j0, iv, ivlen);
+		memset(j0 + ivlen, 0, 3);
+		*(j0 + 15) = 1;
+		return SUCCESS;
+	}
+
+	struct kendryte_aes_ctx ctx = {
+		.op = GCM_AVAILABLE_OP,
+		.dev = parent->dev,
+		.dma = parent->dma,
+	};
+	// GHASH init
+	check = ctx_init(GCM_GHASH_OP, &ctx, false, cipher, keytype,
+				  keyaddr, keybits, NULL);
+	if (check != SUCCESS)
+		return check;
+	// GHASH update
+	check = ctx_update(GCM_GHASH_OP, &ctx, false, NULL, NULL, iv,
+				ivlen);
+	if (check != SUCCESS)
+		return check;
+
+	memset(tmp, 0, AES_BLOCK_SIZE);
+	if ((ivlen % AES_BLOCK_SIZE) != 0) {
+		uint32_t padlen = AES_BLOCK_SIZE - (ivlen % AES_BLOCK_SIZE);
+
+		check = ctx_update(GCM_GHASH_OP, &ctx, false, NULL, NULL,
+					tmp, padlen);
+		if (check != SUCCESS)
+			return check;
+	}
+
+	*((uint32_t *)(tmp + 8)) = be2le((uint32_t)(ivbits >> 32));
+	*((uint32_t *)(tmp + 12)) = be2le((uint32_t)ivbits);
+
+	check = ctx_update(GCM_GHASH_OP, &ctx, false, NULL, NULL, tmp,
+				AES_BLOCK_SIZE);
+	if (check != SUCCESS)
+		return check;
+
+	return ctx_final(GCM_GHASH_OP, &ctx, false, NULL, NULL, j0,
+			 AES_BLOCK_SIZE, false);
+}
+
+static enum kendryte_status_t step_stage(struct kendryte_aes_ctx *ctx,
+					enum gcm_stage stage)
+{
+	switch (ctx->stage) {
+	case GCM_NONE_S:
+		break;
+	case GCM_AAD_S:
+		switch (stage) {
+		case GCM_AAD_S:
+			return SUCCESS;
+		case GCM_TEXT_S:
+			if (ctx->buflen != 0) { // clear AAD and start input
+				enum kendryte_status_t check;
+
+				check = _ctx_update(ctx, NULL, NULL,
+							ctx->buffer, ctx->buflen,
+							true);
+				if (check != SUCCESS)
+					return check;
+				ctx->buflen = 0;
+			}
+			break;
+		default:
+			return E_FIRMWARE;
+		}
+		break;
+	case GCM_TEXT_S:
+		if (stage != GCM_TEXT_S)
+			return E_INVALID;
+		break;
+	default:
+		return E_FIRMWARE;
+	}
+
+	if (ctx->stage != stage) {
+		ctx->start = false;
+		ctx->stage = stage;
+	}
+
+	return SUCCESS;
+}
+
+static enum kendryte_status_t gcm_init(struct kendryte_aes_ctx *ctx,
+				  enum kendryte_cipher_t cipher,
+				  enum kendryte_key_type_t keytype, size_t keyaddr,
+				  uint32_t keybits, const uint8_t *iv,
+				  uint32_t ivlen, bool encrypt)
+{
+	enum kendryte_status_t check;
+	uint8_t j0[AES_BLOCK_SIZE];
+
+	check = build_j0(ctx, j0, cipher, keytype, keyaddr, keybits, iv,
+				  ivlen);
+	if (check != SUCCESS)
+		return check;
+
+	return ctx_init(AES_GCM_OP, ctx, encrypt, cipher, keytype, keyaddr,
+			keybits, j0);
+}
+
+static enum kendryte_status_t gcm_update(struct kendryte_aes_ctx *ctx, uint8_t *out,
+					uint32_t *outlen, const uint8_t *in,
+					uint32_t inlen, bool encrypt)
+{
+	enum kendryte_status_t check =
+		step_stage(ctx, (out == NULL) ? GCM_AAD_S : GCM_TEXT_S);
+
+	if (check != SUCCESS)
+		return check;
+
+	return ctx_update(AES_GCM_OP, ctx, encrypt, out, outlen, in, inlen);
+}
+
+static enum kendryte_status_t import_plaintext_key_to_slot(
+	struct kendryte_aes_ctx *ctx, enum kendryte_key_type_t keytype,
+	enum kendryte_ka_slot_t slot, const uint8_t *key, uint32_t keybits)
+{
+	enum kendryte_status_t check;
+	int i;
+	uint32_t val32;
+
+	// keytype MUST be SSKEY
+	if (keytype != SSKEY)
+		return E_INVALID;
+
+	// check KA key slot by key length
+	check = keyslot_check(false, keytype, slot, keybits);
+	if (check != SUCCESS)
+		return check;
+
+	if (readl(crypto_info->kwp_base + KWP_STATUS_OFFSET) & KWP_STATUS_BUSY_MASK)
+		return E_BUSY;
+
+	val32 = 0x0 << 0 | keybits << 8;
+
+	switch (keytype) {
+	case SSKEY:
+		val32 |= 0x0 << 19;
+		break;
+	default:
+		return E_FIRMWARE;
+	}
+
+	val32 |= get_key_slot_idx(keytype, slot) << 20;
+	writel(val32, crypto_info->kwp_base + KWP_CONFIG_OFFSET);
+
+	/*
+	 * The KWP key window is KWP_KEY_MAXLEN bytes of big-endian words: the
+	 * key goes in word by word, the rest is zeroed. AES keys are 16/24/32
+	 * bytes, a whole number of words. This used to be staged through a
+	 * file-level 512-byte kwp_buffer (memset + memcpy, then each word
+	 * read back and byte-swapped); converting on the way through needs no
+	 * scratch and no shared state.
+	 */
+	for (i = 0; i < KWP_KEY_MAXLEN / 4; ++i)
+		writel(4 * i < b2B(keybits) ? get_unaligned_be32(key + 4 * i) : 0,
+		       crypto_info->kwp_base + KWP_KEY_IN_OUT_OFFSET + 4 * i);
+
+	return kwp_start();
+}
+
+static enum kendryte_status_t clear_ka_slot(struct kendryte_aes_ctx *ctx,
+					   enum kendryte_ka_slot_t slot)
+{
+	uint32_t val32;
+
+	lockdep_assert_held(&crypto_info->engine->lock);
+
+	switch (slot) {
+	case SK128_0:
+	case SK128_1:
+	case SK128_2:
+	case SK128_3:
+	case SK128_4:
+	case SK128_5:
+	case SK128_6:
+	case SK128_7:
+		val32 = 0x1 << (slot - SK128_0);
+		writel(val32, crypto_info->ka_base + KA_SK_FREE_OFFSET);
+		return SUCCESS;
+	case SK256_0:
+	case SK256_1:
+	case SK256_2:
+	case SK256_3:
+		val32 = 0x3 << (2 * (slot - SK256_0));
+		writel(val32, crypto_info->ka_base + KA_SK_FREE_OFFSET);
+		return SUCCESS;
+	case SK512_0:
+	case SK512_1:
+		val32 = 0xf << (4 * (slot - SK512_0));
+		writel(val32, crypto_info->ka_base + KA_SK_FREE_OFFSET);
+		return SUCCESS;
+
+	default:
+		return E_INVALID;
+	}
+}
+
+static enum kendryte_status_t clear_key(struct kendryte_aes_ctx *ctx,
+				   enum kendryte_key_type_t keytype,
+				   enum kendryte_ka_slot_t slot, uint32_t keybits)
+{
+	enum kendryte_status_t check;
+
+	check = keyslot_check(true, keytype, slot, keybits);
+	if (check != SUCCESS)
+		return check;
+
+	return clear_ka_slot(ctx, slot);
+}
+
+static int kendryte_gcm_aes_setkey(struct crypto_aead *tfm, const uint8_t *key,
+				   unsigned int keylen)
+{
+	struct kendryte_aes_ctx *ctx = crypto_aead_ctx(tfm);
+	int err;
+
+	/*
+	 * Validate before copying, not after. ctx->key is 32 bytes
+	 * (KENDRYTE_AES_KEY_MAXLEN); this used to memcpy() whatever length
+	 * the caller passed straight into it with no check at all, so any
+	 * caller that set a longer key -- a userspace ALG_SET_KEY through
+	 * AF_ALG is enough, the crypto core does not bound this for us --
+	 * overran the tfm context. aes_check_keylen() accepts exactly the
+	 * three legal AES key sizes (16/24/32), which is also what
+	 * get_config() can actually encode into GCM_CFG_1.
+	 */
+	err = aes_check_keylen(keylen);
+	if (err)
+		return err;
+
+	ctx->keylen = keylen; // key length in bytes
+	memcpy(ctx->key, key, keylen);
+
+	return 0;
+}
+
+static int kendryte_gcm_aes_setauthsize(struct crypto_aead *tfm,
+					uint32_t authsize)
+{
+	/*
+	 * GCM tag truncation (NIST SP 800-38D 5.2.1.2) is just "keep the
+	 * leading t bytes of the 16-byte tag", which is exactly what
+	 * gcm_tag()'s crypto_read_dgest(tag, taglen) and the memcmp() in
+	 * kendryte_gcm_aes_crypt() already do -- so every standard tag
+	 * length works here, not only the full 16 bytes this used to
+	 * require. crypto_gcm_check_authsize() is the generic GCM
+	 * implementation's own list, so accepting it keeps us
+	 * interchangeable with gcm(aes) from crypto/gcm.c.
+	 */
+	return crypto_gcm_check_authsize(authsize);
+}
+
+/*
+ * Encryption case:
+ *  INPUT  =   Assocdata  ||   Plaintext
+ *		   <-  aadlen ->   <-  pclen  ->
+ *		  <---------- total ----------->
+ *
+ *  OUTPUT =   Assocdata  ||  Ciphertext  ||   Tag
+ *		  <- aadlen ->	 <- outlen ->	<- taglen ->
+ *		  <--------- total ----------->
+ *
+ * Decryption case:
+ *  INPUT  =   Assocdata  ||  Ciphertext  ||	 Tag
+ *		  <- aadlen ->	<------- pclen ------------>
+ *										  <- taglen ->
+ *		  <--------- total -------------->
+ *
+ *  OUTPUT =   Assocdata  ||   Plaintext
+ *		  <- aadlen ->   <- crypten - tag ->
+ *		  <---------- total ----->
+ */
+static int kendryte_gcm_aes_crypt(struct aead_request *req, bool encrypt)
+{
+	struct crypto_aead *tfm = crypto_aead_reqtfm(req);
+	struct kendryte_aes_ctx *ctx = crypto_aead_ctx(tfm);
+	enum kendryte_status_t check = SUCCESS;
+	void *buf_src = NULL;
+	void *buf_dst = NULL;
+	const uint8_t *in;
+	uint8_t *tag = NULL;
+	uint8_t *tmptag = NULL;
+	uint8_t *out = NULL;
+	uint32_t inlen;
+	uint32_t outlen;
+	uint32_t toutlen;
+	uint32_t total;
+	enum kendryte_cipher_t cipher;
+	enum kendryte_key_type_t keytype;
+	enum kendryte_ka_slot_t keyslot;
+	const uint8_t *key;
+	uint32_t keybits;
+	const uint8_t *iv;
+	uint32_t ivlen;
+	uint8_t *aad = NULL;
+	uint32_t aadlen;
+	uint32_t taglen;
+	uint32_t pclen;
+	uint32_t off, chunk;
+	struct kendryte_dma_buf dma = { };
+	bool locked = false;
+	bool key_imported = false;
+	int ret = 0;
+
+	cipher = AES;
+	keytype = SSKEY;
+	iv = req->iv;
+	ivlen = crypto_aead_ivsize(tfm);
+	aadlen = req->assoclen;
+	taglen = crypto_aead_authsize(tfm);
+	keybits = (ctx->keylen << 3);
+	key = ctx->key;
+	keyslot = (keybits > 128) ? SK256_0 : SK128_0;
+	pclen = req->cryptlen;
+	total = aadlen + pclen;
+
+	/*
+	 * A decrypt request carries the tag inside req->cryptlen, so a
+	 * request shorter than the tag has no ciphertext at all and is
+	 * simply malformed. Without this check, the "inlen -= taglen" below
+	 * wraps around on uint32_t and the driver goes on to ask the DMA
+	 * engine for a ~4GB transfer out of a buffer that is a few bytes
+	 * long. -EBADMSG (via E_VERFAIL) is the right answer: a truncated
+	 * AEAD message cannot authenticate.
+	 */
+	if (!encrypt && pclen < taglen) {
+		check = E_VERFAIL;
+		goto done;
+	}
+
+	/*
+	 * ctx->keylen is only ever set by a successful setkey(), so a zero
+	 * here means the caller skipped it. get_config() would eventually
+	 * reject it as E_FIRMWARE, but only after the key import and GCM
+	 * setup have already run against the hardware.
+	 */
+	if (aes_check_keylen(ctx->keylen)) {
+		check = E_INVALID;
+		goto done;
+	}
+
+	buf_src = kzalloc(total, GFP_KERNEL);
+	if (encrypt)
+		buf_dst = kzalloc((total + taglen), GFP_KERNEL);
+	else
+		buf_dst = kzalloc((total - taglen), GFP_KERNEL);
+	if (!buf_src || !buf_dst) {
+		check = E_UNAVAIL;
+		goto done;
+	}
+
+	scatterwalk_map_and_copy(buf_src, req->src, 0, total, 0);
+
+	if (aadlen > 0) {
+		aad = kzalloc(aadlen, GFP_KERNEL);
+		if (!aad) {
+			check = E_UNAVAIL;
+			goto done;
+		}
+		memcpy(aad, buf_src, aadlen);
+	}
+
+	tag = kzalloc(AES_BLOCK_SIZE, GFP_KERNEL);
+	tmptag = kzalloc(AES_BLOCK_SIZE, GFP_KERNEL);
+	if (!tag || !tmptag) {
+		check = E_UNAVAIL;
+		goto done;
+	}
+
+	// input data, plaintext or ciphertext
+	in = buf_src + aadlen;
+	inlen = pclen;
+	if (!encrypt) {
+		inlen -= taglen;
+		memcpy(tmptag, in + inlen, taglen);
+	}
+
+	if (inlen > 0)
+		out = kzalloc(inlen, GFP_KERNEL);
+	else
+		out = kzalloc((inlen + 1), GFP_KERNEL);
+	if (!out) {
+		check = E_UNAVAIL;
+		goto done;
+	}
+
+	/*
+	 * crypto_info->engine->lock covers this whole request, not just the
+	 * individual _ctx_update()/gcm_tag() calls: the DMA/CRYPTO front-end
+	 * is one piece of hardware shared with kendryte-hash.c, and a GCM
+	 * operation is a *sequence* of transfers through it (AAD, then text,
+	 * then the length block, then the tag round) carrying state in the
+	 * engine's own IV/digest registers between them. Anything else
+	 * touching those registers in between would corrupt the result.
+	 *
+	 * Taking it before kendryte_dma_buf_get() is also what makes
+	 * using the engine's shared bounce buffers safe -- see that
+	 * function.
+	 */
+	mutex_lock(&crypto_info->engine->lock);
+	locked = true;
+
+	/*
+	 * Bound by the persistent buffer and feed the engine in chunks --
+	 * same reasoning as the SP38A path below, and the same 254x cliff if
+	 * we ask CMA for a bigger one. gcm_update() is the incremental API,
+	 * so repeated calls are its designed usage: the running GHASH lives
+	 * in ctx->ghash and the engine's digest registers, and ctx->start
+	 * takes care of the head/tail descriptor flags.
+	 */
+	check = kendryte_dma_buf_get(ctx->dev, &dma);
+	if (check != SUCCESS)
+		goto done;
+	ctx->dma = &dma;
+
+	// import key to internal slot
+	check = import_plaintext_key_to_slot(ctx, keytype, keyslot, key, keybits);
+	if (check != SUCCESS)
+		goto done;
+	key_imported = true;
+
+	ctx->op = GCM_AVAILABLE_OP;
+	outlen = 0;
+
+	// GCM init
+	check = gcm_init(ctx, cipher, keytype, keyslot, keybits, iv, ivlen, encrypt);
+	if (check != SUCCESS)
+		goto done;
+
+	/*
+	 * GCM update, AAD then text, both chunked.
+	 *
+	 * do/while rather than a plain for loop so a zero-length AAD or
+	 * text still issues exactly one call, as before. That matters: the
+	 * empty-text call is what drives step_stage() from the AAD stage to
+	 * the text stage, and that transition is what flushes a partial
+	 * trailing AAD block (with out == NULL, so it is hashed as AAD and
+	 * not encrypted as text). Skipping it for inlen == 0 would push the
+	 * leftover AAD into ctx_final() instead, where it would be treated
+	 * as plaintext and produce a wrong tag.
+	 */
+	off = 0;
+	do {
+		chunk = min_t(uint32_t, aadlen - off,
+			      KENDRYTE_ENGINE_DMA_DATA_LEN);
+		check = gcm_update(ctx, NULL, NULL, aad ? aad + off : NULL,
+				   chunk, encrypt);
+		if (check != SUCCESS)
+			goto done;
+		off += chunk;
+	} while (off < aadlen);
+
+	off = 0;
+	do {
+		chunk = min_t(uint32_t, inlen - off,
+			      KENDRYTE_ENGINE_DMA_DATA_LEN);
+		check = gcm_update(ctx, out + outlen, &toutlen, in + off,
+				   chunk, encrypt);
+		if (check != SUCCESS)
+			goto done;
+		outlen += toutlen;
+		off += chunk;
+	} while (off < inlen);
+
+	// GCM done
+	check = ctx_final(AES_GCM_OP, ctx, encrypt, out + outlen, &toutlen,
+				   tag, taglen, true);
+	if (check != SUCCESS)
+		goto done;
+
+	if (!encrypt) {
+		if (memcmp(tag, tmptag, taglen) != 0) {
+			check = E_VERFAIL;
+			goto done;
+		}
+	}
+
+	outlen += toutlen;
+
+	/*
+	 * The session key is released in the "done:" block below, on every
+	 * exit path -- see the comment there.
+	 */
+
+	if (aadlen > 0) {
+		memcpy(buf_dst, aad, aadlen);
+		memcpy(buf_dst + aadlen, out, outlen);
+		// output data, include <aad || ciphertext || tag> or <aad || plaintext>
+		if (encrypt) {
+			memcpy(buf_dst + aadlen + outlen, tag, taglen);
+			scatterwalk_map_and_copy(buf_dst, req->dst, 0,
+						 total + taglen, 1);
+		} else {
+			scatterwalk_map_and_copy(buf_dst, req->dst, 0,
+						 total - taglen, 1);
+		}
+	} else {
+		memcpy(buf_dst, out, outlen);
+		// output data, include <aad || ciphertext || tag> or <aad || plaintext>
+		if (encrypt) {
+			memcpy(buf_dst + outlen, tag, taglen);
+			scatterwalk_map_and_copy(buf_dst, req->dst, 0,
+						 total + taglen, 1);
+		} else {
+			scatterwalk_map_and_copy(buf_dst, req->dst, 0,
+						 total - taglen, 1);
+		}
+	}
+
+done:
+	if (check != SUCCESS) {
+		ret = kendryte_status_to_errno(check);
+		/*
+		 * A failed tag check is an expected outcome, not a driver
+		 * malfunction -- it is exactly what an AEAD is for. Logging
+		 * it at error level on every occurrence turns a tampered (or
+		 * simply mismatched-key) packet into console spam, and in a
+		 * network data path that is a denial-of-service lever on its
+		 * own. Everything else here really is a hardware or
+		 * programming fault and stays loud.
+		 */
+		if (check == E_VERFAIL)
+			pr_debug("GCM authentication failed\n");
+		else
+			pr_err("AES-GCM %s error, status=%d\n",
+			       encrypt ? "encrypt" : "decrypt", check);
+	}
+
+	/*
+	 * Release the KA session-key slot on EVERY exit path, not just the
+	 * successful one.
+	 *
+	 * This used to sit inline after the tag comparison, so any failure
+	 * before that point skipped it and left the slot permanently
+	 * occupied. That is not a theoretical leak -- a GCM decrypt whose
+	 * tag does not verify is a completely normal outcome (it is the
+	 * whole point of an AEAD), and it took exactly one of those to wedge
+	 * the hardware:
+	 *
+	 *   - a 128-bit key lands in SK128_0, leaving KA slot word 0 marked
+	 *     valid (observed: 0x00300801 -- valid=1, size=128, tag=0x30);
+	 *   - the next AES-192/256 request needs SK256_0, which physically
+	 *     spans KA words 0 and 1;
+	 *   - KWP refuses the import with status 0x08000000, and *every*
+	 *     subsequent AES-192/256 GCM operation fails until reboot.
+	 *
+	 * So one forged packet was enough to disable AES-192/256-GCM for the
+	 * rest of the boot. Confirmed on hardware: manually freeing the slot
+	 * through KA_SK_FREE made the very next AES-256 known-answer vector
+	 * pass.
+	 *
+	 * This has to run before the mutex is dropped, since it touches the
+	 * KA registers. clear_key() validates the slot before freeing it; if
+	 * that validation fails (hardware in an unexpected state) fall back
+	 * to freeing the slot unconditionally rather than leaving it stuck
+	 * -- getting the slot back matters more here than finding out why it
+	 * looked wrong.
+	 */
+	if (key_imported) {
+		enum kendryte_status_t cleanup;
+
+		cleanup = clear_key(ctx, keytype, keyslot, keybits);
+		if (cleanup != SUCCESS) {
+			pr_warn("AES-GCM: key slot %d failed validation on release (status=%d), freeing anyway\n",
+				keyslot, cleanup);
+			clear_ka_slot(ctx, keyslot);
+		}
+	}
+
+	/*
+	 * @dma is on this stack frame, so don't leave the tfm pointing at it
+	 * -- but only under the lock: ctx is per tfm, and another request on
+	 * the same tfm may be using ctx->dma right now if we never got that far.
+	 */
+	if (locked) {
+		ctx->dma = NULL;
+		mutex_unlock(&crypto_info->engine->lock);
+	}
+
+	/*
+	 * The key material and the plaintext both passed through these, and
+	 * kfree() leaves them intact in the slab for whoever allocates next.
+	 */
+	kfree_sensitive(buf_src);
+	kfree_sensitive(buf_dst);
+	kfree_sensitive(aad);
+	kfree_sensitive(tag);
+	kfree_sensitive(tmptag);
+	kfree_sensitive(out);
+
+	return ret;
+}
+
+static int kendryte_cra_init(struct crypto_tfm *tfm)
+{
+	struct kendryte_aes_ctx *ctx = crypto_tfm_ctx(tfm);
+
+	if (!crypto_info)
+		return -ENODEV;
+
+	ctx->dev = crypto_info;
+
+	return 0;
+}
+
+static void kendryte_gcm_aes_exit(struct crypto_aead *tfm)
+{
+	struct kendryte_aes_ctx *ctx = crypto_aead_ctx(tfm);
+
+	/*
+	 * The tfm context holds the raw AES key for as long as the tfm
+	 * lives; the crypto core frees it without scrubbing, so wipe it
+	 * here rather than leaving it in freed slab memory.
+	 */
+	memzero_explicit(ctx->key, sizeof(ctx->key));
+}
+
+static int kendryte_gcm_aes_encrypt(struct aead_request *req)
+{
+	return kendryte_gcm_aes_crypt(req, true);
+}
+
+static int kendryte_gcm_aes_decrypt(struct aead_request *req)
+{
+	return kendryte_gcm_aes_crypt(req, false);
+}
+
+static int kendryte_gcm_aes_init(struct crypto_aead *tfm)
+{
+	return kendryte_cra_init(&tfm->base);
+}
+
+static struct aead_alg kendryte_gcm_aes_alg = {
+	.setkey			=	kendryte_gcm_aes_setkey,
+	.setauthsize	=	kendryte_gcm_aes_setauthsize,
+	.encrypt		=	kendryte_gcm_aes_encrypt,
+	.decrypt		=	kendryte_gcm_aes_decrypt,
+	.init			=	kendryte_gcm_aes_init,
+	.exit			=	kendryte_gcm_aes_exit,
+	.ivsize			=	GCM_AES_IV_SIZE,
+	.maxauthsize	=	AES_BLOCK_SIZE,
+
+	.base = {
+		.cra_name		= "gcm(aes)",
+		.cra_driver_name	= "gcm-aes-canaan",
+		.cra_priority		= 400,
+		.cra_blocksize		= 1,
+		/*
+		 * CRYPTO_ALG_ASYNC, not the CRYPTO_ALG_TYPE_AEAD that used to
+		 * be here: crypto_register_aead() sets the type bits itself,
+		 * and what actually matters to callers is that this
+		 * implementation can sleep (it takes a mutex and allocates
+		 * with GFP_KERNEL). Declaring ASYNC is what keeps callers
+		 * that require a synchronous, atomic-context-safe transform
+		 * -- they ask for it with a CRYPTO_ALG_ASYNC mask -- from
+		 * selecting us and then scheduling while atomic.
+		 */
+		.cra_flags		= CRYPTO_ALG_ASYNC,
+		.cra_ctxsize		= sizeof(struct kendryte_aes_ctx),
+		.cra_alignmask		= 0xf,
+		.cra_module		= THIS_MODULE,
+	},
+};
+#endif /* CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES */
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_SP38A
+/*****************************************************************************
+ * SP38A -- AES/SM4 in the SP 800-38A modes (ECB, CBC, CFB, OFB, CTR)
+ *
+ * These share the register window, the DMA front-end, the bounce buffers and
+ * the lock with the GCM code above: SP38A is at offset 0x00 of the node the
+ * GCM driver already maps (GCM itself is the +0x60 sub-block). That is why
+ * this lives here instead of in a file and platform driver of its own.
+ *
+ * Compared to GCM these are much simpler: one DMA transfer per request, the
+ * key goes straight into the CRYPTO block's software-key register (no KWP
+ * import, no KA slot to allocate and release), and the only state carried
+ * out is the chaining IV.
+ ****************************************************************************/
+
+/*
+ * Build the SP38A cfg word for this request. Mirrors sp38a_get_cfg() in the
+ * PUFcc reference firmware.
+ */
+static enum kendryte_status_t sp38a_get_cfg(const struct kendryte_sp38a_ctx *ctx,
+					    bool encrypt, uint32_t *cfg)
+{
+	uint32_t val32;
+
+	switch (ctx->cipher) {
+	case AES:
+		switch (ctx->keylen << 3) {
+		case 128:
+			val32 = 0x0;
+			break;
+		case 192:
+			val32 = 0x1;
+			break;
+		case 256:
+			val32 = 0x2;
+			break;
+		default:
+			return E_FIRMWARE;
+		}
+		break;
+	case SM4:
+		if ((ctx->keylen << 3) != 128)
+			return E_FIRMWARE;
+		val32 = 0x3;
+		break;
+	default:
+		return E_FIRMWARE;
+	}
+
+	val32 |= (uint32_t)ctx->mode << SP38A_CFG_MODE_SHIFT;
+	val32 |= (encrypt ? 0x1u : 0x0u) << SP38A_CFG_ENCRYPT_SHIFT;
+
+	*cfg = val32;
+
+	return SUCCESS;
+}
+
+/*
+ * Run one whole request as a single DMA transfer.
+ *
+ * Called with engine->lock held and @dma already sized for @len.
+ */
+static enum kendryte_status_t sp38a_run(struct kendryte_sp38a_ctx *ctx,
+					struct kendryte_dma_buf *dma,
+					bool encrypt, uint8_t *iv,
+					const uint8_t *in, uint8_t *out,
+					uint32_t len)
+{
+	enum kendryte_status_t check;
+	uint32_t val32;
+	ktime_t deadline;
+
+	if (dma_check_busy_status(NULL))
+		return E_BUSY;
+
+	dma_write_config_0(false, false, false);
+	/* single shot: this transfer is both the first and the last block */
+	dma_write_data_block_config(true, true, true, true, 0);
+
+	check = dma_write_rwcfg(dma, out, in, len);
+	if (check != SUCCESS)
+		return check;
+
+	/*
+	 * SWKEY: the key is written to the CRYPTO block directly rather than
+	 * being wrapped into a KA session slot the way GCM does it. Nothing
+	 * to release afterwards, so none of the slot-leak hazard that path
+	 * has.
+	 */
+	check = crypto_write_sw_key(ctx->key, SW_KEY_MAXLEN);
+	if (check != SUCCESS)
+		return check;
+
+	dma_write_key_config_0(SWKEY, ALGO_TYPE_SP38A, ctx->keylen << 3, 0);
+
+	/* ECB has no IV; the register is simply ignored for it */
+	check = crypto_write_iv(iv, AES_BLOCK_SIZE);
+	if (check != SUCCESS)
+		return check;
+
+	check = sp38a_get_cfg(ctx, encrypt, &val32);
+	if (check != SUCCESS)
+		return check;
+
+	writel(val32, ctx->dev->base + SP38A_CFG_OFFSET);
+
+	dma_write_start();
+
+	deadline = ktime_add_us(ktime_get(), KENDRYTE_HW_TIMEOUT_US);
+	while (dma_check_busy_status(&val32)) {
+		if (ktime_after(ktime_get(), deadline)) {
+			pr_err("SP38A: DMA timed out waiting for completion\n");
+			return E_ERROR;
+		}
+		cpu_relax();
+		cond_resched();
+	}
+
+	if (val32 != 0) {
+		pr_err("SP38A: DMA status 0: 0x%08x\n", val32);
+		return E_ERROR;
+	}
+
+	val32 = readl(ctx->dev->base + SP38A_STATUS_OFFSET);
+	if ((val32 & SP38A_STATUS_ERROR_MASK) != 0) {
+		pr_err("SP38A status: 0x%08x\n", val32);
+		return E_ERROR;
+	}
+
+	memcpy(out, dma->out_virt, len);
+
+	/* hand the chaining value back so the next request can continue */
+	crypto_read_iv(iv, AES_BLOCK_SIZE);
+
+	return SUCCESS;
+}
+
+static int kendryte_sp38a_crypt(struct skcipher_request *req, bool encrypt)
+{
+	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(req);
+	struct kendryte_sp38a_ctx *ctx = crypto_skcipher_ctx(tfm);
+	struct kendryte_dma_buf dma = { };
+	enum kendryte_status_t check = SUCCESS;
+	unsigned int len = req->cryptlen;
+	unsigned int xferlen, off, chunk = 0;
+	uint8_t iv[AES_BLOCK_SIZE] = { };
+	uint8_t *buf = NULL;
+	bool locked = false;
+	int ret = 0;
+
+	if (len == 0)
+		return 0;
+
+	/*
+	 * ECB and CBC are defined only on whole blocks. The crypto core
+	 * already enforces this for a cra_blocksize of 16, but the hardware
+	 * would quietly do something else, so do not rely on it.
+	 */
+	if (ctx->mode != SP38A_MODE_CTR128 && ctx->mode != SP38A_MODE_OFB &&
+	    ctx->mode != SP38A_MODE_CFB && (len % AES_BLOCK_SIZE) != 0)
+		return -EINVAL;
+
+	if (ctx->keylen == 0)
+		return -ENOKEY;
+
+	/*
+	 * CFB needs the transfer rounded up to a whole block.
+	 *
+	 * The hardware only processes complete blocks in this mode -- tested
+	 * on K230: CFB at 16 and 64 bytes matches the reference, at 17, 100
+	 * and 1000 bytes it does not. CTR and OFB handle a short tail fine,
+	 * so this is specific to CFB.
+	 *
+	 * Padding is sound rather than a fudge. CFB-128 defines the last
+	 * partial block as C_n = P_n XOR MSB_u(E(C_{n-1})): the keystream
+	 * block depends only on the *previous* ciphertext, so feeding a
+	 * zero-padded final block and keeping the first u bytes of the
+	 * result produces exactly the specified output. The same argument
+	 * holds for decryption with the roles of P and C swapped.
+	 *
+	 * What is not meaningful afterwards is the chaining IV, but CFB with
+	 * a short final block terminates the stream by definition -- there
+	 * is nothing left to chain onto.
+	 */
+	xferlen = len;
+	if (ctx->mode == SP38A_MODE_CFB)
+		xferlen = round_up(len, AES_BLOCK_SIZE);
+
+	/*
+	 * Linearise the request. Walking the scatterlist in place would save
+	 * this copy, but every chunk still has to be staged through the
+	 * coherent bounce buffer anyway (the engine only takes physical
+	 * addresses and this SoC is not DMA-coherent), so the copy is not
+	 * avoided, only moved.
+	 */
+	buf = kzalloc(xferlen, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	scatterwalk_map_and_copy(buf, req->src, 0, len, 0);
+
+	if (req->iv)
+		memcpy(iv, req->iv, min_t(unsigned int,
+					  crypto_skcipher_ivsize(tfm),
+					  AES_BLOCK_SIZE));
+
+	mutex_lock(&crypto_info->engine->lock);
+	locked = true;
+
+	/*
+	 * Deliberately size the request to the *persistent* buffer and loop,
+	 * rather than asking for one buffer big enough for the whole thing.
+	 *
+	 * A dma_alloc_coherent() beyond the persistent buffer is not the
+	 * ~10us it costs on a normal system: this kernel has CONFIG_DMA_CMA=y
+	 * with CMA at 50% of RAM, so the allocation goes through cma_alloc(),
+	 * which migrates pages and does an lru_add_drain_all() IPI across all
+	 * CPUs. Measured on K230, cbc(aes): 4096 bytes in one shot takes 31us
+	 * (129 MB/s); 4160 bytes -- one byte over the threshold, in the
+	 * allocate-a-big-buffer version -- took 7870us. A 254x cliff for 64
+	 * extra bytes.
+	 *
+	 * Chunking costs nothing by comparison, because every mode here is
+	 * chainable: sp38a_run() seeds CRYPTO_IV before each transfer and
+	 * reads CRYPTO_IV_OUT back after it, which is exactly the chaining
+	 * value the next chunk needs (last ciphertext block for CBC/CFB,
+	 * advanced counter for CTR, last keystream block for OFB; ECB does
+	 * not care).
+	 *
+	 * KENDRYTE_ENGINE_DMA_DATA_LEN is a multiple of the 16-byte block, so
+	 * every chunk but the last is block-aligned and CFB's whole-block
+	 * requirement still holds.
+	 */
+	check = kendryte_dma_buf_get(ctx->dev, &dma);
+	if (check != SUCCESS)
+		goto done;
+
+	for (off = 0; off < xferlen; off += chunk) {
+		chunk = min_t(unsigned int, xferlen - off,
+			      KENDRYTE_ENGINE_DMA_DATA_LEN);
+
+		check = sp38a_run(ctx, &dma, encrypt, iv, buf + off,
+				  buf + off, chunk);
+		if (check != SUCCESS)
+			break;
+	}
+
+done:
+	if (locked)
+		mutex_unlock(&crypto_info->engine->lock);
+
+	if (check == SUCCESS) {
+		scatterwalk_map_and_copy(buf, req->dst, 0, len, 1);
+		/*
+		 * Updating req->iv is part of the skcipher contract: it is
+		 * how a caller splits one long CBC/CTR stream across several
+		 * requests.
+		 */
+		if (req->iv)
+			memcpy(req->iv, iv,
+			       min_t(unsigned int,
+				     crypto_skcipher_ivsize(tfm),
+				     AES_BLOCK_SIZE));
+	} else {
+		pr_err("SP38A %s error, status=%d\n",
+		       encrypt ? "encrypt" : "decrypt", check);
+		ret = kendryte_status_to_errno(check);
+	}
+
+	kfree_sensitive(buf);
+	memzero_explicit(iv, sizeof(iv));
+
+	return ret;
+}
+
+static int kendryte_sp38a_encrypt(struct skcipher_request *req)
+{
+	return kendryte_sp38a_crypt(req, true);
+}
+
+static int kendryte_sp38a_decrypt(struct skcipher_request *req)
+{
+	return kendryte_sp38a_crypt(req, false);
+}
+
+static int kendryte_sp38a_setkey(struct crypto_skcipher *tfm,
+				 const uint8_t *key, unsigned int keylen)
+{
+	struct kendryte_sp38a_ctx *ctx = crypto_skcipher_ctx(tfm);
+
+	switch (ctx->cipher) {
+	case AES:
+		if (aes_check_keylen(keylen))
+			return -EINVAL;
+		break;
+	case SM4:
+		if (keylen != SM4_KEY_SIZE)
+			return -EINVAL;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * crypto_write_sw_key() always pushes SW_KEY_MAXLEN bytes into the
+	 * register file, so zero the tail rather than leaving whatever the
+	 * previous key left there.
+	 */
+	memset(ctx->key, 0, sizeof(ctx->key));
+	memcpy(ctx->key, key, keylen);
+	ctx->keylen = keylen;
+
+	return 0;
+}
+
+static void kendryte_sp38a_exit(struct crypto_skcipher *tfm)
+{
+	struct kendryte_sp38a_ctx *ctx = crypto_skcipher_ctx(tfm);
+
+	memzero_explicit(ctx->key, sizeof(ctx->key));
+}
+
+/*
+ * One init_tfm per (cipher, mode) pair. skcipher_alg has no per-alg private
+ * pointer, so the pairing is carried by these one-line wrappers rather than
+ * by looking the algorithm name back up at runtime.
+ */
+#define KENDRYTE_SP38A_INIT(name, _cipher, _mode)			\
+static int kendryte_sp38a_init_##name(struct crypto_skcipher *tfm)	\
+{									\
+	struct kendryte_sp38a_ctx *ctx = crypto_skcipher_ctx(tfm);	\
+									\
+	if (!crypto_info)						\
+		return -ENODEV;						\
+									\
+	ctx->dev = crypto_info;						\
+	ctx->cipher = (_cipher);					\
+	ctx->mode = (_mode);						\
+	return 0;							\
+}
+
+#endif /* CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_SP38A */
+
+/*
+ * Each SP38A algorithm -- its init function here and its entry in
+ * kendryte_sp38a_algs[] below -- is compiled only when its
+ * CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_* option is set.
+ */
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_ECB_AES
+KENDRYTE_SP38A_INIT(ecb_aes, AES, SP38A_MODE_ECB)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_CBC_AES
+KENDRYTE_SP38A_INIT(cbc_aes, AES, SP38A_MODE_CBC)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_CTR_AES
+KENDRYTE_SP38A_INIT(ctr_aes, AES, SP38A_MODE_CTR128)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_OFB_AES
+KENDRYTE_SP38A_INIT(ofb_aes, AES, SP38A_MODE_OFB)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_CFB_AES
+KENDRYTE_SP38A_INIT(cfb_aes, AES, SP38A_MODE_CFB)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_ECB_SM4
+KENDRYTE_SP38A_INIT(ecb_sm4, SM4, SP38A_MODE_ECB)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_CBC_SM4
+KENDRYTE_SP38A_INIT(cbc_sm4, SM4, SP38A_MODE_CBC)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_CTR_SM4
+KENDRYTE_SP38A_INIT(ctr_sm4, SM4, SP38A_MODE_CTR128)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_OFB_SM4
+KENDRYTE_SP38A_INIT(ofb_sm4, SM4, SP38A_MODE_OFB)
+#endif
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_CFB_SM4
+KENDRYTE_SP38A_INIT(cfb_sm4, SM4, SP38A_MODE_CFB)
+#endif
+
+/*
+ * @_blocksize is the cra_blocksize the crypto API should advertise, which is
+ * not the cipher's block size but "how much the caller must supply at once":
+ * 16 for ECB/CBC, 1 for the stream-like modes (CTR/OFB/CFB), which may end
+ * on a partial block.
+ */
+#define KENDRYTE_SP38A_ALG(name, drvname, _min, _max, _ivsize, _blocksize, sfx) \
+{									\
+	.base.cra_name		= name,					\
+	.base.cra_driver_name	= drvname,				\
+	.base.cra_priority	= 300,					\
+	.base.cra_flags		= CRYPTO_ALG_ASYNC,			\
+	.base.cra_blocksize	= (_blocksize),				\
+	.base.cra_ctxsize	= sizeof(struct kendryte_sp38a_ctx),	\
+	.base.cra_module	= THIS_MODULE,				\
+	.min_keysize		= (_min),				\
+	.max_keysize		= (_max),				\
+	.ivsize			= (_ivsize),				\
+	.chunksize		= AES_BLOCK_SIZE,			\
+	.setkey			= kendryte_sp38a_setkey,		\
+	.encrypt		= kendryte_sp38a_encrypt,		\
+	.decrypt		= kendryte_sp38a_decrypt,		\
+	.init			= kendryte_sp38a_init_##sfx,		\
+	.exit			= kendryte_sp38a_exit,			\
+}
+
