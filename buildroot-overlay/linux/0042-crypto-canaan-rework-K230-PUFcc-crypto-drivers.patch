-//----------------------KWP FUNCTION----------------------------------------//
-static enum kendryte_status_t kwp_start(void)
-{
-	uint32_t val32;
-
-	writel(0x1, puf_kwp_base + KWP_START_OFFSET);
-	while (((val32 = readl(puf_kwp_base + KWP_STATUS_OFFSET)) &
-		KWP_STATUS_BUSY_MASK) != 0)
-		;
-
-	if (val32 & (0x1 << 2))
-		return E_DENY;
-	else if (val32 & (0x1 << 3))
-		return E_OVERFLOW;
-	else if (val32 & (0x1 << 4))
-		return E_UNDERFLOW;
-	else if (val32 & (0x1 << 5))
-		return E_VERFAIL;
-	else if (val32 != 0) {
-		pr_err("Error, KWP status: 0x%08x\n", val32);
-		return E_ERROR;
-	}
-
-	return SUCCESS;
-}
