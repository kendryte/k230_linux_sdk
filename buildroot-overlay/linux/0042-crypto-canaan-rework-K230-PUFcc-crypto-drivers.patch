+
+static int kendryte_crypto_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct kendryte_crypto_info *info;
+	int err;
+
+	/* guard against a stray second probe clobbering a live instance */
+	if (crypto_info)
+		return -EBUSY;
+
+	info = devm_kzalloc(dev, sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return -ENOMEM;
+
+	info->dev = dev;
+
+	info->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(info->base))
+		return PTR_ERR(info->base);
+
+	/*
+	 * DMA/CRYPTO are shared with kendryte-hash.c (see
+	 * kendryte-crypto-engine.c); KWP/KA are this driver's own and were
+	 * previously re-mapped on every single encrypt/decrypt call in
+	 * kendryte_gcm_aes_crypt(), which raced the resulting pointers
+	 * (stored in bare global variables) across concurrent requests and
+	 * could unmap a mapping another request was still using.
+	 */
+	info->engine = kendryte_crypto_engine_get(dev);
+	if (!info->engine)
+		return -ENODEV;
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+	/* KWP/KA (key wrapping, session-key slots) are used by GCM only */
+	info->kwp_base = devm_ioremap(dev, 0x91210300, 0x100);
+	if (!info->kwp_base) {
+		err = -ENOMEM;
+		goto err_put_engine;
+	}
+
+	info->ka_base = devm_ioremap(dev, 0x91210C00, 0x100);
+	if (!info->ka_base) {
+		err = -ENOMEM;
+		goto err_put_engine;
+	}
+#endif
+
+	/*
+	 * The DMA staging buffers (and the DMA mask they need) are the
+	 * engine's now -- kendryte_crypto_engine_get() set them up against
+	 * whichever driver got there first.
+	 */
+
+	platform_set_drvdata(pdev, info);
+
+	/*
+	 * Publish before registering: the algorithms' init functions use
+	 * crypto_info as the "driver is ready" flag, and can run as soon as
+	 * the first crypto_register_*() returns.
+	 */
+	crypto_info = info;
+
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+	err = crypto_register_aead(&kendryte_gcm_aes_alg);
+	if (err < 0) {
+		/*
+		 * Note there is no crypto_unregister_aead() here: the
+		 * registration *failed*, so there is nothing registered to
+		 * tear down. Calling it anyway (as this used to) walks the
+		 * crypto API's internal lists looking for an algorithm that
+		 * was never added.
+		 */
+		dev_err(dev, "Unable to register cipher algorithm.\n");
+		goto err_put_engine;
+	}
+#endif
+
+	/*
+	 * SP38A (ECB/CBC/CFB/OFB/CTR for AES and SM4) is the sub-block at
+	 * offset 0x00 of the window already mapped above -- same device,
+	 * same lock, same bounce buffers.
+	 *
+	 * crypto_register_skciphers() unwinds its own partial registration
+	 * on failure, so there is nothing to undo here beyond the aead. With
+	 * no SP38A mode configured the array is empty and this is a no-op.
+	 */
+	err = crypto_register_skciphers(kendryte_sp38a_algs,
+					ARRAY_SIZE(kendryte_sp38a_algs));
+	if (err < 0) {
+		dev_err(dev, "Unable to register SP38A algorithms.\n");
+		goto err_unreg_aead;
+	}
+
+	dev_info(dev, "Kendryte crypto driver probed (%s%zu SP38A modes)\n",
+		 IS_ENABLED(CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES) ?
+		 "gcm(aes) + " : "", ARRAY_SIZE(kendryte_sp38a_algs));
+
+	return 0;
+
+err_unreg_aead:
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+	crypto_unregister_aead(&kendryte_gcm_aes_alg);
+err_put_engine:	/* only the GCM-only steps above can fail before the aead */
+#endif
+	crypto_info = NULL;
+	kendryte_crypto_engine_put(info->engine);
+	return err;
+}
+
+static int kendryte_crypto_remove(struct platform_device *pdev)
+{
+	struct kendryte_crypto_info *info = platform_get_drvdata(pdev);
+
+	crypto_unregister_skciphers(kendryte_sp38a_algs,
+				    ARRAY_SIZE(kendryte_sp38a_algs));
+#ifdef CONFIG_CRYPTO_DEV_KENDRYTE_CRYP_GCM_AES
+	crypto_unregister_aead(&kendryte_gcm_aes_alg);
+#endif
+
+	crypto_info = NULL;
+	kendryte_crypto_engine_put(info->engine);
+
+	return 0;
+}
+
+static const struct of_device_id of_kendryte_crypto_ids[] = {
+	{ .compatible = "canaan,k230-crypto" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, of_kendryte_crypto_ids);
+
+static struct platform_driver kendryte_crypto_driver = {
+	.probe = kendryte_crypto_probe,
+	.remove = kendryte_crypto_remove,
+	.driver = {
+		.name = "kendryte-crypto",
+		.of_match_table = of_kendryte_crypto_ids,
+		/*
+		 * No sysfs unbind: live tfms hold pointers into the devm-
+		 * allocated device and its MMIO mappings. See crypto_info.
+		 */
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(kendryte_crypto_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("CANAAN K230 Hardware Accelerator Symmetric Cipher Driver");
