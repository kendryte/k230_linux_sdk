+/*****************************************************************************
+ * SP38A -- AES/SM4 in the NIST SP 800-38A modes (ECB/CBC/CFB/OFB/CTR)
+ *
+ * This block lives at offset 0x00 of the same register window the GCM driver
+ * already maps: the DT node "aes@91210200" is SP38A's base, and the GCM
+ * registers are reached from it with a +0x60 bias (SP38D sits at 0x91210260).
+ * So these modes need no new mapping, no new platform driver, and no second
+ * lock -- they are the same device, reached through kendryte_crypto_info.
+ ****************************************************************************/
+//----------------------SP38A REGISTER OFFSET----------------------------------//
+#define SP38A_STATUS_OFFSET 0x10
+#define SP38A_CFG_OFFSET 0x18
+//----------------------SP38A REGISTER BIT MASKS-------------------------------//
+#define SP38A_STATUS_ERROR_MASK 0xfffff0c0
+
+/*
+ * SP38A cfg register layout:
+ *   bits 0-1  block cipher + key size: AES-128=0, AES-192=1, AES-256=2, SM4=3
+ *   bits 4-7  mode of operation (the SP38A_MODE_* values below)
+ *   bit  8    1 = encrypt, 0 = decrypt
+ */
+#define SP38A_CFG_MODE_SHIFT 4
+#define SP38A_CFG_ENCRYPT_SHIFT 8
+
+#define SP38A_MODE_ECB 0x0
+#define SP38A_MODE_CFB 0x1
+#define SP38A_MODE_OFB 0x2
+#define SP38A_MODE_CBC 0x3
+#define SP38A_MODE_CBC_CS1 0x4
+#define SP38A_MODE_CBC_CS2 0x5
+#define SP38A_MODE_CBC_CS3 0x6
+#define SP38A_MODE_CTR32 0x7
+#define SP38A_MODE_CTR64 0x8
+/*
+ * CTR_128 increments the whole 128-bit block as one big-endian integer,
+ * which is what the kernel's "ctr(aes)" means (crypto_inc() carries across
+ * the entire IV). CTR_32/CTR_64 only wrap the low word/dword and would
+ * silently diverge from every other ctr(aes) implementation once a message
+ * is long enough to overflow that field.
+ */
+#define SP38A_MODE_CTR128 0x9
+
+/*
+ * Per-tfm state for the SP38A skciphers. Unlike GCM there is no run state
+ * here: a request is a single DMA transfer, so everything transient lives on
+ * the stack of kendryte_sp38a_crypt().
+ */
+struct kendryte_sp38a_ctx {
+	struct kendryte_crypto_info *dev;
+	uint8_t key[KENDRYTE_AES_KEY_MAXLEN];
+	uint32_t keylen;
+	enum kendryte_cipher_t cipher;
+	uint8_t mode;
+};
+
+#endif /* __KENDRYTE_CIPHER_H__ */
diff --git a/drivers/crypto/canaan/kendryte-common.h b/drivers/crypto/canaan/kendryte-common.h
new file mode 100644
index 000000000..c440f67d3
--- /dev/null
+++ b/drivers/crypto/canaan/kendryte-common.h
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (c) 2023, Canaan Bright Sight Co., Ltd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#ifndef __KENDRYTE_COMMON_H__
+#define __KENDRYTE_COMMON_H__
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+/*
+ * Definitions shared by all three K230 PUFcc back-end drivers
+ * (kendryte-hash.c, kendryte-cipher.c, kendryte-rsa.c).
+ *
+ * These used to be copy-pasted verbatim into each of the three private
+ * headers. They describe one piece of hardware and one vendor firmware ABI,
+ * so three copies could (and did) drift apart silently -- a status code or
+ * register offset corrected in one driver stayed wrong in the other two.
+ */
+
+/*****************************************************************************
+ * Bit/byte helpers
+ ****************************************************************************/
+/*
+ * @brief Convert number of bits to number of bytes
+ */
+#define b2B(bits) (((bits) + 7) / 8)
+/*
+ * @brief Convert number of bytes to number of bits
+ */
+#define B2b(len) (8 * (len))
+
+/*
+ * Upper bound on how long the DMA/CRYPTO front-end drivers (hash, AES-GCM,
+ * KWP key import) will busy-wait for one hardware operation.
+ *
+ * These waits run with engine->lock held, so a hang that never clears the
+ * busy bit would wedge every other user of the block, not just the stuck
+ * request. 100ms is ~4 orders of magnitude more than these operations
+ * actually need -- measured on K230 hardware, a full AES-GCM request
+ * (key import, AAD, text, length block, tag round) completes in well under
+ * 10ms end to end, and a 4KB SHA256 in tens of microseconds.
+ *
+ * The ECP (RSA) engine is NOT covered by this and must not be: private-key
+ * RSA legitimately takes hundreds of milliseconds. It has its own, much
+ * larger KENDRYTE_RSA_ECP_TIMEOUT_US -- see the comment there, and note
+ * that applying this 100ms ceiling to it is exactly the bug that made
+ * RSA-2048 signing fail on real hardware.
+ */
+#define KENDRYTE_HW_TIMEOUT_US 100000
+
+/*****************************************************************************
+ * Shared status codes
+ ****************************************************************************/
+/*
+ * @brief Status code
+ */
+enum kendryte_status_t {
+	SUCCESS, ///< Success.
+	E_ALIGN, ///< Address alignment mismatch.
+	E_OVERFLOW, ///< Space overflow.
+	E_UNDERFLOW, ///< Size too small.
+	E_INVALID, ///< Invalid argument.
+	E_BUSY, ///< Resource is occupied.
+	E_UNAVAIL, ///< Resource is unavailable.
+	E_FIRMWARE, ///< Firmware error.
+	E_VERFAIL, ///< Invalid public key or digital signature.
+	E_ECMPROG, ///< Invalid ECC microprogram.
+	E_DENY, ///< Access denied.
+	E_UNSUPPORT, ///< Not support.
+	E_INFINITY, ///< Point at infinity.
+	E_ERROR, ///< Unspecific error.
+};
+
+/*
+ * @brief Translate a PUFcc firmware status into a kernel errno.
+ *
+ * Every entry point of these drivers used to return a bare -1 (== -EPERM)
+ * for every possible failure, which is actively harmful for two of them:
+ *
+ *  - The crypto API *requires* an AEAD decrypt whose tag does not verify to
+ *    return -EBADMSG. Callers distinguish "this message was tampered with"
+ *    from "the driver broke" purely by that value, and -EPERM reads as the
+ *    latter.
+ *  - -EPERM from a hash/skcipher operation propagates to userspace through
+ *    AF_ALG as EPERM, which looks like a permissions problem and sends
+ *    whoever is debugging it off after SELinux rather than the hardware.
+ */
+static inline int kendryte_status_to_errno(enum kendryte_status_t status)
+{
+	switch (status) {
+	case SUCCESS:
+		return 0;
+	case E_ALIGN:
+	case E_INVALID:
+	case E_UNDERFLOW:
+		return -EINVAL;
+	case E_OVERFLOW:
+		return -EOVERFLOW;
+	case E_BUSY:
+		return -EBUSY;
+	case E_UNAVAIL:
+		return -ENOMEM;
+	case E_DENY:
+		return -EACCES;
+	case E_UNSUPPORT:
+		return -EOPNOTSUPP;
+	case E_VERFAIL:
+		/* the crypto API contract for a failed AEAD tag check */
+		return -EBADMSG;
+	case E_FIRMWARE:
+	case E_ECMPROG:
+	case E_INFINITY:
+	case E_ERROR:
+	default:
+		return -EIO;
+	}
+}
+
+/*****************************************************************************
+ * Shared key/algorithm descriptors (PUFcc firmware ABI)
+ ****************************************************************************/
+/*
+ * @brief Key types
+ */
+enum kendryte_key_type_t {
+	SWKEY = 0,
+	OTPKEY = 1,
+	PUFKEY = 2,
+	RANDKEY = 3,
+	SHARESEC = 4,
+	SSKEY = 5,
+	PRKEY,
+};
+
+/*
+ * @brief Algo types
+ */
+enum kendryte_algo_type_t {
+	ALGO_TYPE_HKDF = 0,
+	ALGO_TYPE_HMAC,
+	ALGO_TYPE_CMAC,
+	ALGO_TYPE_KLB = 4,
+	ALGO_TYPE_SM2ENC = 7,
+	ALGO_TYPE_SP38A,
+	ALGO_TYPE_GCM,
+	ALGO_TYPE_XTS,
+	ALGO_TYPE_CCM,
+	ALGO_TYPE_CHACHA,
+	ALGO_TYPE_CYPT_REG_IO,
+	ALGO_TYPE_KEY_EXPORT,
+	ALGO_TYPE_NONE,
+};
+
+/*****************************************************************************
+ * Shared block-segmentation helper types
+ ****************************************************************************/
+/*
+ * structure for segment() return value
+ */
+struct segstr {
+	bool process;
+	const uint8_t *addr;
+	uint32_t len;
+};
+
+struct blsegs {
+	uint32_t nsegs;
+	struct segstr seg[3];
+};
+
+/*****************************************************************************
+ * Shared DMA front-end registers (0x91210000)
+ ****************************************************************************/
+//----------------------DMA REGISTER OFFSET----------------------------------------//
+#define DMA_STAT_0_OFFSET 0x10
+#define DMA_STAT_1_OFFSET 0x14
+#define DMA_START_OFFSET 0x20
+#define DMA_CFG_0_OFFSET 0x24
+#define DMA_DSC_CFG_0_OFFSET 0x34
+#define DMA_DSC_CFG_1_OFFSET 0x38
+#define DMA_DSC_CFG_2_OFFSET 0x3c
+#define DMA_DSC_CFG_3_OFFSET 0x40
+#define DMA_DSC_CFG_4_OFFSET 0x44
+#define DMA_KEY_CFG_0_OFFSET 0x6c
+//----------------------DMA REGISTER BIT----------------------------------------//
+#define DMA_KEY_CFG_0_KEY_DST_BITS 4
+#define DMA_KEY_CFG_0_KEY_SIZE_BITS 8
+#define DMA_KEY_CFG_0_KEY_IDX_BITS 24
+
+#define DMA_DSC_CFG_4_WRITE_PROT_BITS 0
+#define DMA_DSC_CFG_4_READ_PROT_BITS 8
+#define DMA_DSC_CFG_4_FIX_READ_BITS 16
+#define DMA_DSC_CFG_4_FIX_WRITE_BITS 17
+#define DMA_DSC_CFG_4_NO_CRYP_BITS 23
+#define DMA_DSC_CFG_4_OFFSET_BITS 24
+#define DMA_DSC_CFG_4_DN_PAUSE_BITS 28
+#define DMA_DSC_CFG_4_DN_INTRPT_BITS 29
+#define DMA_DSC_CFG_4_TAIL_BITS 30
+#define DMA_DSC_CFG_4_HEAD_BITS 31
+//----------------------DMA REGISTER BIT MASKS----------------------------------//
+#define DMA_STATUS_0_BUSY_MASK 0x00000001
+
+/*****************************************************************************
+ * Shared CRYPTO front-end registers (0x91210100)
+ ****************************************************************************/
+//----------------------CRYPTO REGISTER OFFSET---------------------------------------//
+/*
+ * IV_OUT is the chaining value the engine leaves behind after a block-cipher
+ * operation (the last ciphertext block for CBC, the advanced counter for
+ * CTR, ...). Reading it back is what lets a caller chain one skcipher
+ * request onto the next.
+ */
+#define CRYPTO_IV_OUT_OFFSET 0x20
+#define CRYPTO_IV_OFFSET 0x30
+#define CRYPTO_SW_KEY_OFFSET 0x40
+#define CRYPTO_DGST_IN_OFFSET 0x80
+#define CRYPTO_DGST_OUT_OFFSET 0xc0
+
+#define DGST_INT_STATE_LEN 64
+
+#endif /* __KENDRYTE_COMMON_H__ */
diff --git a/drivers/crypto/canaan/kendryte-crypto-engine.c b/drivers/crypto/canaan/kendryte-crypto-engine.c
new file mode 100644
index 000000000..057b2c271
--- /dev/null
+++ b/drivers/crypto/canaan/kendryte-crypto-engine.c
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Copyright (c) 2023, Canaan Bright Sight Co., Ltd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/module.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/mutex.h>
+#include "kendryte-crypto-engine.h"
+
+#define KENDRYTE_CRYPTO_ENGINE_DMA_BASE_PHYS 0x91210000
+#define KENDRYTE_CRYPTO_ENGINE_CRYPTO_BASE_PHYS 0x91210100
+#define KENDRYTE_CRYPTO_ENGINE_REGION_LEN 0x100
+
+static struct kendryte_crypto_engine engine;
+static unsigned int engine_refcount;
+static DEFINE_MUTEX(engine_setup_lock);
+
+/* last reference gone; engine_setup_lock held */
+static void engine_teardown(void)
+{
+	if (engine.dma_buf_out_virt)
+		dma_free_coherent(engine.buf_dev, KENDRYTE_ENGINE_DMA_DATA_LEN,
+				  engine.dma_buf_out_virt,
+				  engine.dma_buf_out_phys);
+	if (engine.dma_buf_in_virt)
+		dma_free_coherent(engine.buf_dev, KENDRYTE_ENGINE_DMA_DATA_LEN,
+				  engine.dma_buf_in_virt, engine.dma_buf_in_phys);
+	engine.dma_buf_out_virt = NULL;
+	engine.dma_buf_in_virt = NULL;
+
+	put_device(engine.buf_dev);
+	engine.buf_dev = NULL;
+
+	iounmap(engine.crypto_base);
+	iounmap(engine.dma_base);
+	engine.crypto_base = NULL;
+	engine.dma_base = NULL;
+}
+
+/*
+ * Lazily maps the shared block on first use and refcounts it instead of
+ * tying it to a single platform_device, since kendryte-hash.c and
+ * kendryte-cipher.c are two independent drivers that may probe (and may be
+ * built as separate modules) in either order.
+ */
+struct kendryte_crypto_engine *kendryte_crypto_engine_get(struct device *dev)
+{
+	mutex_lock(&engine_setup_lock);
+
+	if (engine_refcount == 0) {
+		engine.dma_base = ioremap(KENDRYTE_CRYPTO_ENGINE_DMA_BASE_PHYS,
+					   KENDRYTE_CRYPTO_ENGINE_REGION_LEN);
+		if (!engine.dma_base)
+			goto fail;
+
+		engine.crypto_base = ioremap(KENDRYTE_CRYPTO_ENGINE_CRYPTO_BASE_PHYS,
+					      KENDRYTE_CRYPTO_ENGINE_REGION_LEN);
+		if (!engine.crypto_base)
+			goto fail_unmap_dma;
+
+		/*
+		 * The descriptor registers (DMA_DSC_CFG_0/1) hold a single
+		 * 32-bit address word, so 32 bits is all the engine can
+		 * express. Setting it explicitly also makes the buffer
+		 * allocation in kendryte_crypto_engine_get_bufs() work on a
+		 * device whose DT node carries no dma-ranges, which is the
+		 * case for all three of these.
+		 */
+		if (dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32)))
+			goto fail_unmap_crypto;
+
+		/*
+		 * The buffers are allocated against this device, so hold it
+		 * until the last put: that may well come from the *other*
+		 * driver, after this one has been unbound, and
+		 * dma_free_coherent() needs the same device the allocation
+		 * was made against.
+		 */
+		engine.buf_dev = get_device(dev);
+
+		mutex_init(&engine.lock);
+	}
+
+	engine_refcount++;
+	mutex_unlock(&engine_setup_lock);
+	return &engine;
+
+fail_unmap_crypto:
+	iounmap(engine.crypto_base);
+	engine.crypto_base = NULL;
+fail_unmap_dma:
+	iounmap(engine.dma_base);
+	engine.dma_base = NULL;
+fail:
+	mutex_unlock(&engine_setup_lock);
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(kendryte_crypto_engine_get);
+
+/*
+ * The staging buffers are allocated here, on the first request that needs
+ * them, rather than in _get(): a kernel that has these drivers built in but
+ * never sends them a request does not pay for them. The cost moves to that
+ * first request -- on this CONFIG_DMA_CMA kernel dma_alloc_coherent() takes
+ * a few ms -- and is paid once; the buffers then live until the last put.
+ *
+ * Callers hold e->lock, which is also what serializes every use of the
+ * buffers, so the check-then-allocate below needs no locking of its own.
+ */
+int kendryte_crypto_engine_get_bufs(struct kendryte_crypto_engine *e,
+				    bool need_out)
+{
+	lockdep_assert_held(&e->lock);
+
+	if (!e->dma_buf_in_virt) {
+		e->dma_buf_in_virt =
+			dma_alloc_coherent(e->buf_dev, KENDRYTE_ENGINE_DMA_DATA_LEN,
+					   &e->dma_buf_in_phys, GFP_KERNEL);
+		if (!e->dma_buf_in_virt)
+			return -ENOMEM;
+	}
+
+	if (need_out && !e->dma_buf_out_virt) {
+		e->dma_buf_out_virt =
+			dma_alloc_coherent(e->buf_dev, KENDRYTE_ENGINE_DMA_DATA_LEN,
+					   &e->dma_buf_out_phys, GFP_KERNEL);
+		if (!e->dma_buf_out_virt)
+			return -ENOMEM;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(kendryte_crypto_engine_get_bufs);
+
+void kendryte_crypto_engine_put(struct kendryte_crypto_engine *e)
+{
+	if (WARN_ON(e != &engine))
+		return;
+
+	mutex_lock(&engine_setup_lock);
+
+	if (--engine_refcount == 0)
+		engine_teardown();
+
+	mutex_unlock(&engine_setup_lock);
+}
+EXPORT_SYMBOL_GPL(kendryte_crypto_engine_put);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Shared DMA/CRYPTO front-end and staging buffers for the Canaan K230 crypto drivers");
diff --git a/drivers/crypto/canaan/kendryte-crypto-engine.h b/drivers/crypto/canaan/kendryte-crypto-engine.h
new file mode 100644
index 000000000..1f220f4c4
--- /dev/null
+++ b/drivers/crypto/canaan/kendryte-crypto-engine.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (c) 2023, Canaan Bright Sight Co., Ltd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#ifndef __KENDRYTE_CRYPTO_ENGINE_H__
+#define __KENDRYTE_CRYPTO_ENGINE_H__
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/mutex.h>
+
+/*
+ * kendryte-hash.c and kendryte-cipher.c each drive what looks like their own
+ * private DMA+CRYPTO register block, but both map the same physical
+ * addresses (0x91210000 / 0x91210100): per the PUFsecurity PUFcc reference
+ * (test/puf_fw/test.c's PUFIOT_ADDR_START layout), this is one shared
+ * front-end engine with several cipher back-ends (SHA256, AES-GCM, etc.)
+ * wired behind it, not two separate pieces of hardware. Each driver used
+ * to map and serialize access to it independently, so a hash request and
+ * an AES-GCM request running at the same time could interleave register
+ * writes and corrupt each other -- this module gives both drivers the one
+ * mapping and the one lock to serialize through instead.
+ */
+/*
+ * Size of each staging buffer below, and so the most one DMA transfer may
+ * carry: callers chunk to it (see the comment in kendryte_sp38a_crypt() for
+ * why growing this instead is the wrong trade on a CONFIG_DMA_CMA kernel).
+ *
+ * Exactly one page. The vendor code allocated 32 bytes more, which made
+ * dma_alloc_coherent() round each buffer up to two pages; guard bytes past
+ * 4096 stayed untouched over ~158k transfers with every algorithm enabled,
+ * so the hardware never writes beyond the length it is given. Going below
+ * a page would save no memory (allocation is per page) and would cost one
+ * extra transfer, ~6 us, per chunk.
+ */
+#define KENDRYTE_ENGINE_DMA_DATA_LEN 4096
+
+struct kendryte_crypto_engine {
+	void __iomem *dma_base;
+	void __iomem *crypto_base;
+	struct mutex lock;
+
+	/*
+	 * Staging buffers for the DMA front-end.
+	 *
+	 * These belong to the engine rather than to either driver: the
+	 * hardware only takes physical addresses and this SoC is not
+	 * DMA-coherent, so every transfer through the front-end stages
+	 * through them -- and every such transfer, from either driver, runs
+	 * with @lock held. One in / one out therefore suffices for both.
+	 *
+	 * Both are NULL until first used -- see
+	 * kendryte_crypto_engine_get_bufs(). The hash driver only ever uses
+	 * @in (its result comes out of the CRYPTO block's digest registers,
+	 * not over DMA), so without cipher requests @out is never allocated.
+	 *
+	 * They used to be a private pair in kendryte_crypto_info plus a
+	 * single one in kendryte_sha256_info, with separate size constants
+	 * that had already drifted apart (4096 vs 4096+32).
+	 */
+	void *dma_buf_in_virt;
+	void *dma_buf_out_virt;
+	dma_addr_t dma_buf_in_phys;
+	dma_addr_t dma_buf_out_phys;
+	/*
+	 * The device the buffers were allocated against, pinned with
+	 * get_device() for as long as they live. The engine has no device of
+	 * its own (it bare-ioremaps fixed addresses rather than being a DT
+	 * node), so it borrows whichever driver probed first -- and that
+	 * driver may well be unbound while the other still holds a
+	 * reference, which is exactly what the pin protects against.
+	 */
+	struct device *buf_dev;
