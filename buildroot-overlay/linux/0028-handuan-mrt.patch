+
+// SPDX-License-Identifier: GPL-2.0
+&vo {
+	vth_line = <10>;
+};
+
+
+&dsi {
+	ports {
+		port@1 {
+			reg = <1>;
+			dsi_out_st7701: endpoint {
+				remote-endpoint = <&st7701_in>;
+			};
+		};
+	};
+
+	lcd: panel@0 {
+		compatible = "canaan,universal";
+		reg = <0>;
+
+		panel-width-mm = <480>;
+		panel-height-mm = <640>;
+		panel-dsi-lane = <1>;
+
+		panel-init-sequence = [
+			39 00 06 ff 77 01 00 00 13
+			15 00 02 ef 08
+			39 00 06 ff 77 01 00 00 10
+			39 00 03 c0 4f 00
