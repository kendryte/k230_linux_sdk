+			39 00 0d e2 20 20 44 44 96 a0 00 00 96 a0 00 00
+			39 00 05 e3 00 00 22 22
+			39 00 03 e4 44 44
+			39 00 11 e5 0c 90 b0 a0 0e 92 b0 a0 08 8c b0 a0 0a 8e b0 a0
+			39 00 05 e6 00 00 22 22
+			39 00 03 e7 44 44
+			39 00 11 e8 0d 91 b0 a0 0f 93 b0 a0 09 8d b0 a0 0b 8f b0 a0
+			39 00 03 e9 36 00
+			39 00 08 eb 00 00 e4 e4 44 88 40
+			39 00 11 ed c1 a2 bf 0f 67 45 ff ff ff ff 54 76 f0 fb 2a 1c
+			39 00 07 ef 10 0d 04 08 3f 1f
+			39 00 06 ff 77 01 00 00 13
+			39 00 03 e8 00 0e
+			39 00 06 ff 77 01 00 00 00
+			15 78 02 11 00
+			39 00 06 ff 77 01 00 00 13
+			39 0a 03 e8 00 0c
+			39 00 03 e8 00 00
+			39 00 06 ff 77 01 00 00 00
+			15 14 02 29 00
+		];
+
+		display-timings {
+			timing-0 {
+				clock-frequency = <24864000>;
+				hactive = <480>;
+				vactive = <640>;
+
+				hsync-len = <20>;
+				hback-porch = <20>;
+				hfront-porch = <40>;
+
+				vsync-len = <20>;
+				vback-porch = <20>;
+				vfront-porch = <40>;
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				st7701_in: endpoint {
+					remote-endpoint = <&dsi_out_st7701>;
+				};
+			};
+		};
+	};
+};
diff --git a/arch/riscv/boot/dts/canaan/k230-canmv-mrt-lcd.dts b/arch/riscv/boot/dts/canaan/k230-canmv-mrt-lcd.dts
