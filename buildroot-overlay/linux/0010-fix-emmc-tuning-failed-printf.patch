From 6c351e47027f2b1f0159cfdb96a8e76a80de96f6 Mon Sep 17 00:00:00 2001
From: wangjianxin <wangjianxin@canaan-creative.com>
Date: Thu, 18 Dec 2025 17:03:23 +0800
Subject: [PATCH] fix emmc tuning failed printf

---
 arch/riscv/boot/dts/canaan/k230-evb.dts | 7 +++++++
 arch/riscv/boot/dts/canaan/k230.dtsi    | 9 ++++++++-
 drivers/mmc/host/sdhci-of-kendryte.c    | 1 +
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/canaan/k230-evb.dts b/arch/riscv/boot/dts/canaan/k230-evb.dts
index 3e17c92ad..76d9916ab 100644
--- a/arch/riscv/boot/dts/canaan/k230-evb.dts
+++ b/arch/riscv/boot/dts/canaan/k230-evb.dts
@@ -41,6 +41,13 @@ &uart3 {
 	status = "okay";
 };
 
+&mmc_sd0{
+	status = "okay";
+	is_emmc;
+    io_fixed_1v8;
+    mmc-hs200-1_8v;
+};
+
 &mmc_sd1{
 	status = "okay";
 	no-1-8-v;
diff --git a/arch/riscv/boot/dts/canaan/k230.dtsi b/arch/riscv/boot/dts/canaan/k230.dtsi
index 8ed85bd12..a5d02df63 100644
--- a/arch/riscv/boot/dts/canaan/k230.dtsi
+++ b/arch/riscv/boot/dts/canaan/k230.dtsi
@@ -192,6 +192,13 @@ dummy_sd:apb-sdclock {
 		#clock-cells = <0x00>;
 	};
 
+	dummy_emmc:apb-emmcclock {
+		compatible = "fixed-clock";
+		clock-frequency = <200000000>;
+		clock-output-names = "dummy_emmc";
+		#clock-cells = <0x00>;
+	};
+
 	clk_dummy: clock-dummy {
 		compatible = "fixed-clock";
 		clock-frequency = <0>;
@@ -338,7 +345,7 @@ mmc_sd0: sdhci0@91580000 {
 			reg = <0x0 0x91580000 0x0 0x1000>;
 			interrupts = <142 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "sdhci0irq";
-			clocks = <&dummy_sd>,<&dummy_sd>;
+			clocks = <&dummy_emmc>,<&dummy_emmc>;
 			clock-names = "core", "bus";
 			max-frequency = <200000000>;
 			bus-width = <8>;
diff --git a/drivers/mmc/host/sdhci-of-kendryte.c b/drivers/mmc/host/sdhci-of-kendryte.c
index ba8fd024f..748c4a58b 100644
--- a/drivers/mmc/host/sdhci-of-kendryte.c
+++ b/drivers/mmc/host/sdhci-of-kendryte.c
@@ -329,6 +329,7 @@ static int dwcmshc_probe(struct platform_device *pdev)
 				sizeof(struct dwcmshc_priv));
 	if (IS_ERR(host))
 		return PTR_ERR(host);
+	host->tuning_loop_count = 128;
 
 	/*
 	 * extra adma table cnt for cross 128M boundary handling.
-- 
2.25.1

