From d61b821fe2f86e6d2e2a60c67289b37f705e209c Mon Sep 17 00:00:00 2001
From: wangjianxin <wangjianxin@canaan-creative.com>
Date: Wed, 16 Sep 2026 10:30:00 +0800
Subject: [PATCH] mtd: nand: spi: canaan: add W25N01GW support, fix CTRLR0
 programming race, and use A/B partitions

Add the JEDEC ID (0xba, 0x21) for the Winbond W25N01GW 1.8V SPI NAND
to the winbond manufacturer table so spinand_manufacturer_match() can
recognize it; without this entry probe fails with -ENOTSUPP even
though the chip is electrically identical to the existing 3.3V
W25N01GV part.

Enable spi0 on k230-evb.dts and describe the chip at CS0 with a
fixed-partitions layout matching the NAND boot image layout (SPL,
uboot, env A/B, opensbi+linux+dtb, rootfs UBI), then split the
spl_uboot and uboot partitions into A/B slots to match the env A/B
scheme already used for env.

Fix the DesignWare SPI controller (spi-dw-core.c): CTRLR0/CTRLR1 are
only writable while the controller is disabled, but SSIENR lives in
the APB domain while gating logic in the ssi_clk domain, so a
disable does not take effect synchronously with the register write --
SSIENR already reads back 0 while the core is still running on the
old settings. Any CTRLR0 write issued inside that window is silently
dropped, with no error flag anywhere, and the transfer then executes
with the *previous* transfer's TMOD/NDF. On K230 SPI-NAND this was
observed roughly 1000 times per GiB of traffic in both directions,
corrupting GET FEATURE and PAGE READ transfers. Read the programming
back and reissue it until it sticks, using the readback as the
barrier that gives the disable time to cross over.
---
 arch/riscv/boot/dts/canaan/k230-evb.dts |   59 ++++++++
 drivers/mtd/nand/spi/winbond.c          |    9 +
 drivers/spi/spi-dw-core.c               |  236 ++++++++++++++++++++++++++-----
 3 files changed, 263 insertions(+), 41 deletions(-)

diff --git a/arch/riscv/boot/dts/canaan/k230-evb.dts b/arch/riscv/boot/dts/canaan/k230-evb.dts
index 22a3f7ea..2e7572fd 100644
--- a/arch/riscv/boot/dts/canaan/k230-evb.dts
+++ b/arch/riscv/boot/dts/canaan/k230-evb.dts
@@ -125,3 +125,62 @@ &v4l2isp {
 	dev0-sensor-mode = <0>;
 	dev0-sensor-i2c-bus = <0>;
 };
+
+
+&spi0 {
+	status = "okay";
+	spi-flash@0 {
+		compatible = "spi-nand";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		reg = <0>;
+        rx-sample-delay-ns = <5>;
+		spi-max-frequency = <50000000>;
+		// spi-tx-bus-width = <4>;
+		// spi-rx-bus-width = <4>;
+		status = "okay";
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+                reg = <0 0x80000>;
+                label = "spl_uboot_a";
+            };
+			partition@80000 {
+                reg = <0x80000 0x80000>;
+                label = "spl_uboot_b";
+            };
+			partition@100000 {
+                reg = <0x100000 0x100000>;
+                label = "uboot_a";
+            };
+			partition@200000 {
+                reg = <0x200000 0x100000>;
+                label = "uboot_b";
+            };
+			partition@300000 {
+                reg = <0x300000 0x20000>;
+                label = "env_a";
+            };
+            partition@320000 {
+                reg = <0x320000  0x20000>;
+                label = "env_b";
+            };
+			partition@400000 {
+                reg = <0x400000  0x1000000>;
+                label = "sys_opensbi_linux_dtb";
+            };
+			partition@1400000 {
+                reg = <0x1400000  0x6400000>;
+                label = "rootfs_ubi";
+            };
+            partition@10000000 {
+                reg = <0 0x10000000>;
+                label = "all_flash";
+            };
+		};
+	};
+
+};
diff --git a/drivers/mtd/nand/spi/winbond.c b/drivers/mtd/nand/spi/winbond.c
index f507e375..b4781481 100644
--- a/drivers/mtd/nand/spi/winbond.c
+++ b/drivers/mtd/nand/spi/winbond.c
@@ -160,6 +160,15 @@ static const struct spinand_info winbond_spinand_table[] = {
 					      &update_cache_variants),
 		     0,
 		     SPINAND_ECCINFO(&w25m02gv_ooblayout, NULL)),
+	SPINAND_INFO("W25N01GW", /* 1.8V */
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_DUMMY, 0xba, 0x21),
+		     NAND_MEMORG(1, 2048, 64, 64, 1024, 20, 1, 1, 1),
+		     NAND_ECCREQ(1, 512),
