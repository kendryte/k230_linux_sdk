arch=riscv
autoload=0
baudrate=115200
board=k230_evb
board_name=k230_evb
bootcmd=k230_boot auto auto_boot;
upsdimg=usb start; dhcp;  tftp 0x9000000 192.168.1.2:wjx/sysimage-sdcard.img.gz;gzwrite mmc 1 0x$fileaddr  0x$filesize;
upsduboot=usb start; dhcp;  tftp 0xc100000 192.168.1.2:wjx/u-boot.img && mmc dev 1; mmc write  0x$fileaddr 0x1000  0xc00;
upspiimg=usb start; dhcp;  tftp 0x9000000 192.168.1.2:wjx/sysimage-spinor32m.img;sf probe 0:0;sf erase 0 0x2000000;sf write   0x$fileaddr  0 0x$filesize; sf remove;
upspiuboot=usb start; dhcp;  tftp 0xc100000 192.168.1.2:wjx/u-boot.img && sf probe 0:0;sf erase 0x80000 0x180000; sf update  0x$fileaddr 0x80000  0x$filesize; sf remove;
usb_load=usb start; dhcp; tftp $ramdisk_addr jiangxiangbing/rtt_system.bin; k230_boot mem $ramdisk_addr 0x$filesize; tftp $kernel_addr jiangxiangbing/fw_payload.img;tftp $ramdisk_addr jiangxiangbing/rootfs-final.cpio.gz;tftp $dtb_addr jiangxiangbing/k230.dtb
vendor=canaan
bootargs=root=/dev/mtdblock9 rw rootwait rootfstype=jffs2 console=ttyS0,115200 earlycon=sbi;
quick_boot=false
wlanssid=H3C_wjx
wlanpass=123456789
bootdelay=1
